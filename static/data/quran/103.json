{"n":103,"ayat":[{"t":"Demi masa.","w":[["وَٱلْعَصْرِ","wal-ʿaṣri","demi waktu"]]},{"t":"Sungguh, manusia berada dalam kerugian,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["لَفِى","lafī","benar-benar dalam"],["خُسْرٍ","khus'rin","kerugian"]]},{"t":"kecuali orang-orang yang beriman dan mengerjakan kebajikan serta saling menasihati untuk kebenaran dan saling menasihati untuk kesabaran.","w":[["إِلَّا","illā","kecuali"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوا۟","āmanū","beriman"],["وَعَمِلُوا۟","waʿamilū","dan mereka berbuat/beramal"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","kebajikan/sholeh"],["وَتَوَاصَوْا۟","watawāṣaw","dan mereka saling berwasiat/menasehati"],["بِٱلْحَقِّ","bil-ḥaqi","dengan kebenaran"],["وَتَوَاصَوْا۟","watawāṣaw","dan mereka saling berwasiat/menasehati"],["بِٱلصَّبْرِ","bil-ṣabri","dengan kesabaran"]]}]}