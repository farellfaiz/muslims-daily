{"n":84,"ayat":[{"t":"Apabila langit terbelah,","w":[["إِذَا","idhā","apabila"],["ٱلسَّمَآءُ","l-samāu","langit"],["ٱنشَقَّتْ","inshaqqat","terbelah"]]},{"t":"dan patuh kepada Tuhannya, dan sudah semestinya patuh,","w":[["وَأَذِنَتْ","wa-adhinat","dan ia patuh"],["لِرَبِّهَا","lirabbihā","kepada Tuhannya"],["وَحُقَّتْ","waḥuqqat","dan ia semestinya"]]},{"t":"dan apabila bumi diratakan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْأَرْضُ","l-arḍu","bumi"],["مُدَّتْ","muddat","dipanjangkan/diratakan"]]},{"t":"dan memuntahkan apa yang ada di dalamnya dan menjadi kosong,","w":[["وَأَلْقَتْ","wa-alqat","dan ia melemparkan"],["مَا","mā","apa"],["فِيهَا","fīhā","di dalamnya"],["وَتَخَلَّتْ","watakhallat","dan ia menjadi sunyi/kosong"]]},{"t":"dan patuh kepada Tuhannya, dan sudah semestinya patuh.","w":[["وَأَذِنَتْ","wa-adhinat","dan ia patuh"],["لِرَبِّهَا","lirabbihā","kepada Tuhannya"],["وَحُقَّتْ","waḥuqqat","dan ia semestinya"]]},{"t":"Wahai manusia! Sesungguhnya kamu telah bekerja keras menuju Tuhanmu, maka kamu akan menemui-Nya.","w":[["يَـٰٓأَيُّهَا","yāayyuhā","wahai"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["إِنَّكَ","innaka","sesungguhnya kamu"],["كَادِحٌ","kādiḥun","bekerja keras"],["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["كَدْحًۭا","kadḥan","sungguh-sungguh kerja keras"],["فَمُلَـٰقِيهِ","famulāqīhi","maka menemuinya"]]},{"t":"Maka adapun orang yang catatanya diberikan dari sebelah kanannya,","w":[["فَأَمَّا","fa-ammā","maka adapun"],["مَنْ","man","siapa"],["أُوتِىَ","ūtiya","diberikan"],["كِتَـٰبَهُۥ","kitābahu","kitabnya/catatannya"],["بِيَمِينِهِۦ","biyamīnihi","sebelah kanannya"]]},{"t":"maka dia akan diperiksa dengan pemeriksaan yang mudah,","w":[["فَسَوْفَ","fasawfa","maka nanti"],["يُحَاسَبُ","yuḥāsabu","dia dihisap/diperiksa"],["حِسَابًۭا","ḥisāban","perhitungan/pemeriksaan"],["يَسِيرًۭا","yasīran","mudah"]]},{"t":"dan dia akan kembali kepada keluarganya (yang sama-sama beriman) dengan gembira.","w":[["وَيَنقَلِبُ","wayanqalibu","dan dia akan dikembalikan"],["إِلَىٰٓ","ilā","kepada"],["أَهْلِهِۦ","ahlihi","keluarganya"],["مَسْرُورًۭا","masrūran","dengan gembira"]]},{"t":"Dan adapun orang yang catatannya diberikan dari arah belakang,","w":[["وَأَمَّا","wa-ammā","dan adapun"],["مَنْ","man","siapa/orang"],["أُوتِىَ","ūtiya","diberikan"],["كِتَـٰبَهُۥ","kitābahu","kitabnya"],["وَرَآءَ","warāa","belakang"],["ظَهْرِهِۦ","ẓahrihi","punggungnya"]]},{"t":"maka dia akan berteriak, \"Celakalah aku!\"","w":[["فَسَوْفَ","fasawfa","maka nanti"],["يَدْعُوا۟","yadʿū","mereka berseru/berteriak"],["ثُبُورًۭا","thubūran","kebinasaan/kecelakaan"]]},{"t":"Dan dia akan masuk ke dalam api yang menyala-nyala (neraka).","w":[["وَيَصْلَىٰ","wayaṣlā","dan dia akan masuk"],["سَعِيرًا","saʿīran","api yang menyala-nyala"]]},{"t":"Sungguh, dia dahulu (di dunia) bergembira di kalangan keluarganya (yang sama-sama kafir).","w":[["إِنَّهُۥ","innahu","sesungguhnya dia"],["كَانَ","kāna","adalah"],["فِىٓ","fī","dalam"],["أَهْلِهِۦ","ahlihi","keluarganya"],["مَسْرُورًا","masrūran","bergembira"]]},{"t":"Sesungguhnya dia mengira bahwa dia tidak akan kembali (kepada Tuhannya).","w":[["إِنَّهُۥ","innahu","sesungguhnya"],["ظَنَّ","ẓanna","dia menyangka"],["أَن","an","bahwa"],["لَّن","lan","tidak"],["يَحُورَ","yaḥūra","dia akan kembali"]]},{"t":"Tidak demikian, sesungguhnya Tuhannya selalu melihatnya.","w":[["بَلَىٰٓ","balā","yang benar"],["إِنَّ","inna","sesungguhnya"],["رَبَّهُۥ","rabbahu","Tuhannya"],["كَانَ","kāna","adalah"],["بِهِۦ","bihi","kepadanya"],["بَصِيرًۭا","baṣīran","melihat"]]},{"t":"Maka Aku bersumpah demi cahaya merah pada waktu senja,","w":[["فَلَآ","falā","maka"],["أُقْسِمُ","uq'simu","Aku bersumpah"],["بِٱلشَّفَقِ","bil-shafaqi","dengan cahaya merah di waktu senja"]]},{"t":"demi malam dan apa yang diselubunginya,","w":[["وَٱلَّيْلِ","wa-al-layli","dan malam"],["وَمَا","wamā","dan apa"],["وَسَقَ","wasaqa","menyelubungi"]]},{"t":"demi bulan apabila jadi purnama,","w":[["وَٱلْقَمَرِ","wal-qamari","dan bulan"],["إِذَا","idhā","apabila"],["ٱتَّسَقَ","ittasaqa","sempurna terang"]]},{"t":"sungguh, akan kamu jalani tingkat demi tingkat (dalam kehidupan).","w":[["لَتَرْكَبُنَّ","latarkabunna","sesungguhnya kamu akan naik/melalui"],["طَبَقًا","ṭabaqan","setingkat"],["عَن","ʿan","dari/demi"],["طَبَقٍۢ","ṭabaqin","setingkat"]]},{"t":"Maka mengapa mereka tidak mau beriman?","w":[["فَمَا","famā","maka mengapa"],["لَهُمْ","lahum","bagi mereka"],["لَا","lā","tidak"],["يُؤْمِنُونَ","yu'minūna","mereka beriman"]]},{"t":"Dan apabila Alquran dibacakan kepada mereka, mereka tidak (mau) bersujud,","w":[["وَإِذَا","wa-idhā","dan apabila"],["قُرِئَ","quri-a","dibacakan"],["عَلَيْهِمُ","ʿalayhimu","atas mereka"],["ٱلْقُرْءَانُ","l-qur'ānu","Al Qur'an"],["لَا","lā","tidak"],["يَسْجُدُونَ ۩","yasjudūna","sujud"]]},{"t":"bahkan orang-orang kafir itu mendustakan-(nya).","w":[["بَلِ","bali","tetapi/bahkan"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["كَفَرُوا۟","kafarū","kafir/ingkar"],["يُكَذِّبُونَ","yukadhibūna","mereka mendustakan"]]},{"t":"Dan Allah lebih mengetahui apa yang mereka sembunyikan (dalam hati mereka).","w":[["وَٱللَّهُ","wal-lahu","dan Allah"],["أَعْلَمُ","aʿlamu","lebih mengetahui"],["بِمَا","bimā","terhadap apa"],["يُوعُونَ","yūʿūna","mereka kumpulkan/simpan"]]},{"t":"Maka sampaikanlah kepada mereka (ancaman) azab yang pedih,","w":[["فَبَشِّرْهُم","fabashir'hum","maka beri kabar gembira mereka"],["بِعَذَابٍ","biʿadhābin","dengan azab"],["أَلِيمٍ","alīmin","pedih"]]},{"t":"kecuali orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat pahala yang tidak putus-putusnya.","w":[["إِلَّا","illā","kecuali"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوا۟","āmanū","beriman"],["وَعَمِلُوا۟","waʿamilū","dan mereka berbuat/beramal"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","kebajikan/saleh"],["لَهُمْ","lahum","bagi mereka"],["أَجْرٌ","ajrun","pahala"],["غَيْرُ","ghayru","lain/tidak"],["مَمْنُونٍۭ","mamnūnin","terputus-putus"]]}]}