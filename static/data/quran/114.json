{"n":114,"ayat":[{"t":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia,","w":[["قُلْ","qul","katakanlah"],["أَعُوذُ","aʿūdhu","aku berlindung"],["بِرَبِّ","birabbi","Tuhannya"],["ٱلنَّاسِ","l-nāsi","manusia"]]},{"t":"Raja manusia,","w":[["مَلِكِ","maliki","Rajanya"],["ٱلنَّاسِ","l-nāsi","manusia"]]},{"t":"sembahan manusia,","w":[["إِلَـٰهِ","ilāhi","Tuhannya"],["ٱلنَّاسِ","l-nāsi","manusia"]]},{"t":"dari kejahatan (bisikan) setan yang bersembunyi,","w":[["مِن","min","dari"],["شَرِّ","sharri","kejahatan"],["ٱلْوَسْوَاسِ","l-waswāsi","bisikkan"],["ٱلْخَنَّاسِ","l-khanāsi","menunggu-nunggu/bersembunyi"]]},{"t":"yang membisikkan (kejahatan) ke dalam dada manusia,","w":[["ٱلَّذِى","alladhī","yang"],["يُوَسْوِسُ","yuwaswisu","membisik-bisikan"],["فِى","fī","dalam"],["صُدُورِ","ṣudūri","dada"],["ٱلنَّاسِ","l-nāsi","manusia"]]},{"t":"dari (golongan) jin dan manusia.\"","w":[["مِنَ","mina","dari"],["ٱلْجِنَّةِ","l-jinati","jin"],["وَٱلنَّاسِ","wal-nāsi","dan manusia"]]}]}