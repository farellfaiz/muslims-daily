{"n":86,"ayat":[{"t":"Demi langit dan yang datang pada malam hari.","w":[["وَٱلسَّمَآءِ","wal-samāi","dan langit"],["وَٱلطَّارِقِ","wal-ṭāriqi","dan yang datang di malam hari"]]},{"t":"Dan tahukah kamu apakah yang datang pada malam hari itu?","w":[["وَمَآ","wamā","dan apa"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["ٱلطَّارِقُ","l-ṭāriqu","yang datang dimalam hari"]]},{"t":"(Yaitu) bintang yang bersinar tajam,","w":[["ٱلنَّجْمُ","al-najmu","bintang"],["ٱلثَّاقِبُ","l-thāqibu","cemerlang/menembus"]]},{"t":"setiap orang pasti ada penjaganya.","w":[["إِن","in","tidak"],["كُلُّ","kullu","setiap"],["نَفْسٍۢ","nafsin","jiwa/diri"],["لَّمَّا","lammā","melainkan"],["عَلَيْهَا","ʿalayhā","atasnya"],["حَافِظٌۭ","ḥāfiẓun","penjaga"]]},{"t":"Maka hendaklah manusia memperhatikan dari apa dia diciptakan.","w":[["فَلْيَنظُرِ","falyanẓuri","maka hendaklah memperhatikan"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["مِمَّ","mimma","dari apa"],["خُلِقَ","khuliqa","ia diciptakan"]]},{"t":"Dia diciptakan dari air (mani) yang terpancar,","w":[["خُلِقَ","khuliqa","ia diciptakan"],["مِن","min","dari"],["مَّآءٍۢ","māin","air"],["دَافِقٍۢ","dāfiqin","terpancar"]]},{"t":"yang keluar dari antara tulang punggung (sulbi) dan tulang dada.","w":[["يَخْرُجُ","yakhruju","ia keluar"],["مِنۢ","min","dari"],["بَيْنِ","bayni","antara"],["ٱلصُّلْبِ","l-ṣul'bi","tulang belakang"],["وَٱلتَّرَآئِبِ","wal-tarāibi","dan tulang dada"]]},{"t":"Sungguh, Allah benar-benar kuasa untuk mengembalikannya (hidup setelah mati).","w":[["إِنَّهُۥ","innahu","sesungguhnya Dia"],["عَلَىٰ","ʿalā","atas"],["رَجْعِهِۦ","rajʿihi","mengembalikanya"],["لَقَادِرٌۭ","laqādirun","benar-benar berkuasa"]]},{"t":"Pada hari ditampakkan segala rahasia,","w":[["يَوْمَ","yawma","hari"],["تُبْلَى","tub'lā","dibuka/dinampakkan"],["ٱلسَّرَآئِرُ","l-sarāiru","rahasia-rahasia"]]},{"t":"maka manusia tidak lagi mempunyai suatu kekuatan dan tidak (pula) ada penolong.","w":[["فَمَا","famā","maka tidak"],["لَهُۥ","lahu","baginya"],["مِن","min","dari"],["قُوَّةٍۢ","quwwatin","kekuatan"],["وَلَا","walā","dan tidak"],["نَاصِرٍۢ","nāṣirin","seorang penolong"]]},{"t":"Demi langit yang mengandung hujan,","w":[["وَٱلسَّمَآءِ","wal-samāi","dan langit"],["ذَاتِ","dhāti","mempunyai/mengandung"],["ٱلرَّجْعِ","l-rajʿi","air/hujan"]]},{"t":"dan bumi yang mempunyai tumbuh-tumbuhan,","w":[["وَٱلْأَرْضِ","wal-arḍi","dan bumi"],["ذَاتِ","dhāti","mempunyai"],["ٱلصَّدْعِ","l-ṣadʿi","tumbuh-tumbuhan"]]},{"t":"sungguh, (Alquran) itu benar-benar firman pemisah (antara yang hak dan yang batil),","w":[["إِنَّهُۥ","innahu","sesungguhnya ia (Al Qur'an)"],["لَقَوْلٌۭ","laqawlun","perkataan/firman"],["فَصْلٌۭ","faṣlun","terpisah"]]},{"t":"dan (Alquran) itu bukanlah senda gurauan.","w":[["وَمَا","wamā","dan tidak"],["هُوَ","huwa","ia (Al Qur'an)"],["بِٱلْهَزْلِ","bil-hazli","dengan sia-sia/senda gurau"]]},{"t":"Sungguh, mereka (orang kafir) merencanakan tipu daya yang jahat,","w":[["إِنَّهُمْ","innahum","sesungguhnya mereka"],["يَكِيدُونَ","yakīdūna","mereka membuat tipu daya"],["كَيْدًۭا","kaydan","tipu daya"]]},{"t":"dan Aku pun membuat rencana (tipu daya) yang jitu.","w":[["وَأَكِيدُ","wa-akīdu","dan AKu membuat tipu daya"],["كَيْدًۭا","kaydan","tipu daya"]]},{"t":"Karena itu berilah penangguhan kepada orang-orang kafir. Berilah mereka kesempatan untuk sementara waktu.","w":[["فَمَهِّلِ","famahhili","maka beri tangguhlah"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","orang-orang kafir"],["أَمْهِلْهُمْ","amhil'hum","beritangguhlah mereka"],["رُوَيْدًۢا","ruwaydan","sedikit/sebentar"]]}]}