{"n":99,"ayat":[{"t":"Apabila bumi diguncangkan dengan guncangan yang dahsyat,","w":[["إِذَا","idhā","apabila"],["زُلْزِلَتِ","zul'zilati","digoncangkan"],["ٱلْأَرْضُ","l-arḍu","bumi"],["زِلْزَالَهَا","zil'zālahā","goncangan"]]},{"t":"dan bumi telah mengeluarkan beban-beban berat (yang dikandung)nya,","w":[["وَأَخْرَجَتِ","wa-akhrajati","dan mengeluarkan"],["ٱلْأَرْضُ","l-arḍu","bumi"],["أَثْقَالَهَا","athqālahā","beban beratnya"]]},{"t":"dan manusia bertanya, \"Apa yang terjadi pada bumi ini?\"","w":[["وَقَالَ","waqāla","dan berkata"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["مَا","mā","apa"],["لَهَا","lahā","ia"]]},{"t":"Pada hari itu bumi menyampaikan beritanya,","w":[["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["تُحَدِّثُ","tuḥaddithu","ia menceritakan"],["أَخْبَارَهَا","akhbārahā","beritanya"]]},{"t":"karena sesungguhnya Tuhanmu telah memerintahkan (yang sedemikian itu) padanya.","w":[["بِأَنَّ","bi-anna","karena sesungguhnya"],["رَبَّكَ","rabbaka","Tuhanmu"],["أَوْحَىٰ","awḥā","talah mewahyukan/memerintahkan"],["لَهَا","lahā","padanya"]]},{"t":"Pada hari itu manusia keluar dari kuburnya dalam keadaan berkelompok-kelompok, untuk diperlihatkan kepada mereka (balasan) semua amal perbuatannya.","w":[["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["يَصْدُرُ","yaṣduru","keluar"],["ٱلنَّاسُ","l-nāsu","manusia"],["أَشْتَاتًۭا","ashtātan","bermacam-macam"],["لِّيُرَوْا۟","liyuraw","untuk mereka lihat"],["أَعْمَـٰلَهُمْ","aʿmālahum","amal-amal mereka"]]},{"t":"Maka barangsiapa mengerjakan kebaikan seberat zarah, niscaya dia akan melihat (balasan)nya.","w":[["فَمَن","faman","maka barang siapa"],["يَعْمَلْ","yaʿmal","dia mengerjakan/beramal"],["مِثْقَالَ","mith'qāla","seberat"],["ذَرَّةٍ","dharratin","zarrah/atom"],["خَيْرًۭا","khayran","kebaikan"],["يَرَهُۥ","yarahu","dia melihatnya"]]},{"t":"Dan barangsiapa mengerjakan kejahatan seberat zarah, niscaya dia akan melihat (balasan)nya.","w":[["وَمَن","waman","dan barang siapa"],["يَعْمَلْ","yaʿmal","dia mengerjakan/beramal"],["مِثْقَالَ","mith'qāla","seberat"],["ذَرَّةٍۢ","dharratin","zarrah/atom"],["شَرًّۭا","sharran","kejahatan"],["يَرَهُۥ","yarahu","dia melihatnya"]]}]}