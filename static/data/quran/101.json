{"n":101,"ayat":[{"t":"Hari Kiamat,","w":[["ٱلْقَارِعَةُ","al-qāriʿatu","hari kiamat"]]},{"t":"Apakah hari Kiamat itu?","w":[["مَا","mā","apakah"],["ٱلْقَارِعَةُ","l-qāriʿatu","hari kiamat"]]},{"t":"Dan tahukah kamu apakah hari Kiamat itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["ٱلْقَارِعَةُ","l-qāriʿatu","hari kiamat"]]},{"t":"Pada hari itu manusia seperti laron yang beterbangan,","w":[["يَوْمَ","yawma","hari"],["يَكُونُ","yakūnu","adalah"],["ٱلنَّاسُ","l-nāsu","manusia"],["كَٱلْفَرَاشِ","kal-farāshi","seperti anai-anai"],["ٱلْمَبْثُوثِ","l-mabthūthi","bertebaran"]]},{"t":"dan gunung-gunung seperti bulu yang dihambur-hamburkan.","w":[["وَتَكُونُ","watakūnu","dan adalah"],["ٱلْجِبَالُ","l-jibālu","gunung-gunung"],["كَٱلْعِهْنِ","kal-ʿih'ni","seperti bulu"],["ٱلْمَنفُوشِ","l-manfūshi","dihambur-hamburkan"]]},{"t":"Maka adapun orang yang berat timbangan (kebaikan)nya,","w":[["فَأَمَّا","fa-ammā","maka adapun"],["مَن","man","siapa/orang"],["ثَقُلَتْ","thaqulat","berat"],["مَوَٰزِينُهُۥ","mawāzīnuhu","timbangannya"]]},{"t":"maka dia berada dalam kehidupan yang memuaskan (senang).","w":[["فَهُوَ","fahuwa","maka dia"],["فِى","fī","dalam"],["عِيشَةٍۢ","ʿīshatin","kehidupan"],["رَّاضِيَةٍۢ","rāḍiyatin","memuaskan"]]},{"t":"Dan adapun orang yang ringan timbangan (kebaikan)nya,","w":[["وَأَمَّا","wa-ammā","dan adapun"],["مَنْ","man","orang"],["خَفَّتْ","khaffat","ringan"],["مَوَٰزِينُهُۥ","mawāzīnuhu","timbangannya"]]},{"t":"maka tempat kembalinya adalah neraka Hāwiyah.","w":[["فَأُمُّهُۥ","fa-ummuhu","maka tempat kembalinya"],["هَاوِيَةٌۭ","hāwiyatun","jurang yang dalam/neraka Hawiyah"]]},{"t":"Dan tahukah kamu apakah neraka Hāwiyah itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["هِيَهْ","hiyah","itu"]]},{"t":"(Yaitu) api yang sangat panas.","w":[["نَارٌ","nārun","api"],["حَامِيَةٌۢ","ḥāmiyatun","sangat panas"]]}]}