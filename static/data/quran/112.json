{"n":112,"ayat":[{"t":"Katakanlah (Muhammad), \"Dialah Allah, Yang Maha Esa.","w":[["قُلْ","qul","katakanlah"],["هُوَ","huwa","Dia"],["ٱللَّهُ","l-lahu","Allah"],["أَحَدٌ","aḥadun","Esa"]]},{"t":"Allah tempat meminta segala sesuatu.","w":[["ٱللَّهُ","al-lahu","Allah"],["ٱلصَّمَدُ","l-ṣamadu","tempat bergantung"]]},{"t":"(Allah) tidak beranak dan tidak pula diperanakkan.","w":[["لَمْ","lam","tidak"],["يَلِدْ","yalid","beranak"],["وَلَمْ","walam","dan tidak"],["يُولَدْ","yūlad","diperanakkan"]]},{"t":"Dan tidak ada sesuatu yang setara dengan Dia.\"","w":[["وَلَمْ","walam","dan tidak"],["يَكُن","yakun","ada"],["لَّهُۥ","lahu","baginya"],["كُفُوًا","kufuwan","menyamai/setara"],["أَحَدٌۢ","aḥadun","seorang"]]}]}