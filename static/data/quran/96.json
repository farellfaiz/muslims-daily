{"n":96,"ayat":[{"t":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan,","w":[["ٱقْرَأْ","iq'ra","bacalah"],["بِٱسْمِ","bi-is'mi","dengan nama"],["رَبِّكَ","rabbika","Tuhanmu"],["ٱلَّذِى","alladhī","yang"],["خَلَقَ","khalaqa","menciptakan"]]},{"t":"Dia telah menciptakan manusia dari segumpal darah.","w":[["خَلَقَ","khalaqa","menciptakan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["مِنْ","min","dari"],["عَلَقٍ","ʿalaqin","segumpal darah"]]},{"t":"Bacalah, dan Tuhanmulah Yang Mahamulia.","w":[["ٱقْرَأْ","iq'ra","bacalah"],["وَرَبُّكَ","warabbuka","dan Tuhanmu"],["ٱلْأَكْرَمُ","l-akramu","amat mulia"]]},{"t":"Yang mengajar (manusia) dengan pena.","w":[["ٱلَّذِى","alladhī","yang"],["عَلَّمَ","ʿallama","Dia mengajar"],["بِٱلْقَلَمِ","bil-qalami","dengan kalam"]]},{"t":"Dia mengajarkan manusia apa yang tidak diketahuinya.","w":[["عَلَّمَ","ʿallama","Dia mengajarkan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["مَا","mā","apa"],["لَمْ","lam","tidak"],["يَعْلَمْ","yaʿlam","dia ketahui"]]},{"t":"Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,","w":[["كَلَّآ","kallā","sekali-kali tidak"],["إِنَّ","inna","sesungguhnya"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["لَيَطْغَىٰٓ","layaṭghā","benar-benar melampui batas"]]},{"t":"apabila melihat dirinya serba cukup.","w":[["أَن","an","bahwa"],["رَّءَاهُ","raāhu","ia melihatnya"],["ٱسْتَغْنَىٰٓ","is'taghnā","dia serba cukup"]]},{"t":"Sungguh, hanya kepada Tuhanmulah tempat kembali(mu).","w":[["إِنَّ","inna","sesungguhnya"],["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["ٱلرُّجْعَىٰٓ","l-ruj'ʿā","tempat kembali"]]},{"t":"Bagaimana pendapatmu tentang orang yang melarang?","w":[["أَرَءَيْتَ","ara-ayta","apakah kamu lihat/pendapatmu"],["ٱلَّذِى","alladhī","yang/orang-orang"],["يَنْهَىٰ","yanhā","ia melarang"]]},{"t":"seorang hamba ketika dia melaksanakan salat,","w":[["عَبْدًا","ʿabdan","hamba"],["إِذَا","idhā","apabila"],["صَلَّىٰٓ","ṣallā","sholat"]]},{"t":"bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),","w":[["أَرَءَيْتَ","ara-ayta","apakah kamu lihat/pendapatmu"],["إِن","in","jika"],["كَانَ","kāna","adalah"],["عَلَى","ʿalā","atas"],["ٱلْهُدَىٰٓ","l-hudā","petunjuk"]]},{"t":"atau dia menyuruh bertakwa (kepada Allah)?","w":[["أَوْ","aw","atau"],["أَمَرَ","amara","dia menyuruh"],["بِٱلتَّقْوَىٰٓ","bil-taqwā","dengan taqwa"]]},{"t":"Bagaimana pendapatmu jika dia (yang melarang) itu mendustakan dan berpaling?","w":[["أَرَءَيْتَ","ara-ayta","apakah kamu lihat/pendapatmu"],["إِن","in","jika"],["كَذَّبَ","kadhaba","mendustakan"],["وَتَوَلَّىٰٓ","watawallā","dan dia berpaling"]]},{"t":"Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?","w":[["أَلَمْ","alam","apakah tidak/tidaklah"],["يَعْلَم","yaʿlam","dia mengetahui"],["بِأَنَّ","bi-anna","bahwa sesungguhnya"],["ٱللَّهَ","l-laha","Allah"],["يَرَىٰ","yarā","Dia melihat"]]},{"t":"Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya (ke dalam neraka),","w":[["كَلَّا","kallā","sekali-kali tidak"],["لَئِن","la-in","sungguh jika"],["لَّمْ","lam","tidak"],["يَنتَهِ","yantahi","dia berhenti"],["لَنَسْفَعًۢا","lanasfaʿan","niscaya kami pegang/tarik"],["بِٱلنَّاصِيَةِ","bil-nāṣiyati","dengan umbun-umbun"]]},{"t":"(yaitu) ubun-ubun orang yang mendustakan dan durhaka.","w":[["نَاصِيَةٍۢ","nāṣiyatin","umbun-umbun"],["كَـٰذِبَةٍ","kādhibatin","pendusta"],["خَاطِئَةٍۢ","khāṭi-atin","salah/durhaka"]]},{"t":"Maka biarlah dia memanggil golongannya (untuk menolongnya),","w":[["فَلْيَدْعُ","falyadʿu","maka hendaklah dia memanggil"],["نَادِيَهُۥ","nādiyahu","kaum/golongannya"]]},{"t":"kelak Kami akan memanggil Malaikat Zabaniyah (penyiksa orang-orang yang berdosa)","w":[["سَنَدْعُ","sanadʿu","kelak Kami memanggil"],["ٱلزَّبَانِيَةَ","l-zabāniyata","Zabaniyah"]]},{"t":"sekali-kali tidak! Janganlah kamu patuh kepadanya; dan sujudlah serta dekatkanlah (dirimu kepada Allah).","w":[["كَلَّا","kallā","sekali-kali"],["لَا","lā","jangan"],["تُطِعْهُ","tuṭiʿ'hu","kamu patuh kepadanya"],["وَٱسْجُدْ","wa-us'jud","dan sujudlah"],["وَٱقْتَرِب ۩","wa-iq'tarib","dan dekatkanlah"]]}]}