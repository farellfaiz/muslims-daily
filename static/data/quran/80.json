{"n":80,"ayat":[{"t":"Dia (Muhammad) berwajah masam dan berpaling,","w":[["عَبَسَ","ʿabasa","dia bermuka masam"],["وَتَوَلَّىٰٓ","watawallā","dan dia berpaling"]]},{"t":"karena seorang buta telah datang kepadanya (Abdullah bin Ummi Maktum).","w":[["أَن","an","sesungguhnya"],["جَآءَهُ","jāahu","datang kepadanya"],["ٱلْأَعْمَىٰ","l-aʿmā","seorang buta"]]},{"t":"Dan tahukah engkau (Muhammad) barangkali dia ingin menyucikan dirinya (dari dosa),","w":[["وَمَا","wamā","dan apakah"],["يُدْرِيكَ","yud'rīka","tahukah kamu"],["لَعَلَّهُۥ","laʿallahu","barangkali dia"],["يَزَّكَّىٰٓ","yazzakkā","ia membersihkan diri"]]},{"t":"atau dia (ingin) mendapatkan pengajaran, yang memberi manfaat kepadanya?","w":[["أَوْ","aw","atau"],["يَذَّكَّرُ","yadhakkaru","ia mendapatkan pengajaran"],["فَتَنفَعَهُ","fatanfaʿahu","lalu memberi manfaat kepadanya"],["ٱلذِّكْرَىٰٓ","l-dhik'rā","pengajaran"]]},{"t":"Adapun orang yang merasa dirinya serba cukup (pembesar-pembesar Quraisy),","w":[["أَمَّا","ammā","adapun"],["مَنِ","mani","siapa"],["ٱسْتَغْنَىٰ","is'taghnā","merasa kaya/cukup"]]},{"t":"maka engkau (Muhammad) memberi perhatian kepadanya,","w":[["فَأَنتَ","fa-anta","maka kamu"],["لَهُۥ","lahu","kepadanya"],["تَصَدَّىٰ","taṣaddā","menghadapi/layani"]]},{"t":"padahal tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).","w":[["وَمَا","wamā","dan tidak"],["عَلَيْكَ","ʿalayka","atasmu"],["أَلَّا","allā","bahwa tidak"],["يَزَّكَّىٰ","yazzakkā","ia membersihkan diri"]]},{"t":"Dan adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),","w":[["وَأَمَّا","wa-ammā","dan adapun"],["مَن","man","siapa/orang"],["جَآءَكَ","jāaka","datang kapadamu"],["يَسْعَىٰ","yasʿā","berjalan/bersegera"]]},{"t":"sedang dia takut (kepada Allah),","w":[["وَهُوَ","wahuwa","dan dia"],["يَخْشَىٰ","yakhshā","ia takut"]]},{"t":"engkau (Muhammad) malah mengabaikannya.","w":[["فَأَنتَ","fa-anta","maka kamu"],["عَنْهُ","ʿanhu","dari padanya"],["تَلَهَّىٰ","talahhā","kamu mengabaikannya"]]},{"t":"Sekali-kali jangan (begitu)! Sungguh, (ajaran-ajaran Allah) itu suatu peringatan,","w":[["كَلَّآ","kallā","sekali-kali jangan/tidak"],["إِنَّهَا","innahā","sesungguhnya ia/itu"],["تَذْكِرَةٌۭ","tadhkiratun","peringatan/pengajaran"]]},{"t":"maka barangsiapa menghendaki, tentulah dia akan memperhatikannya,","w":[["فَمَن","faman","maka barang siapa"],["شَآءَ","shāa","ia menghendaki"],["ذَكَرَهُۥ","dhakarahu","ia mengingat/memperhatikannya"]]},{"t":"di dalam kitab-kitab yang dimuliakan (di sisi Allah),","w":[["فِى","fī","dalam"],["صُحُفٍۢ","ṣuḥufin","lembaran-lembaran"],["مُّكَرَّمَةٍۢ","mukarramatin","dimuliakan"]]},{"t":"yang ditinggikan (dan) disucikan,","w":[["مَّرْفُوعَةٍۢ","marfūʿatin","ditinggikan"],["مُّطَهَّرَةٍۭ","muṭahharatin","disucikan"]]},{"t":"di tangan para utusan (malaikat),","w":[["بِأَيْدِى","bi-aydī","di tangan-tangan"],["سَفَرَةٍۢ","safaratin","para utusan"]]},{"t":"yang mulia lagi berbakti.","w":[["كِرَامٍۭ","kirāmin","yang mulia"],["بَرَرَةٍۢ","bararatin","yang berbakti"]]},{"t":"Celakalah manusia! Alangkah kufurnya dia!","w":[["قُتِلَ","qutila","dibunuh/binasa"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["مَآ","mā","apa"],["أَكْفَرَهُۥ","akfarahu","kekafirannya"]]},{"t":"Dari apakah Dia (Allah) menciptakannya?","w":[["مِنْ","min","dari"],["أَىِّ","ayyi","apa"],["شَىْءٍ","shayin","sesuatu"],["خَلَقَهُۥ","khalaqahu","Dia menciptakannya"]]},{"t":"Dari setetes mani, Dia menciptakannya lalu menentukannya.","w":[["مِن","min","dari"],["نُّطْفَةٍ","nuṭ'fatin","setetes mani"],["خَلَقَهُۥ","khalaqahu","Dia menciptakannya"],["فَقَدَّرَهُۥ","faqaddarahu","lalu Dia menentukannya"]]},{"t":"Kemudian jalannya Dia mudahkan,","w":[["ثُمَّ","thumma","kemudian"],["ٱلسَّبِيلَ","l-sabīla","jalan"],["يَسَّرَهُۥ","yassarahu","Dia memudahkannya"]]},{"t":"kemudian Dia mematikannya lalu menguburkannya,","w":[["ثُمَّ","thumma","kemudian"],["أَمَاتَهُۥ","amātahu","Dia mematikannya"],["فَأَقْبَرَهُۥ","fa-aqbarahu","lalu Dia memasukkannya dalam kubur"]]},{"t":"kemudian jika Dia menghendaki, Dia membangkitkannya kembali.","w":[["ثُمَّ","thumma","kemudian"],["إِذَا","idhā","apabila"],["شَآءَ","shāa","Dia menghendaki"],["أَنشَرَهُۥ","ansharahu","Dia membangkitkan"]]},{"t":"Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.","w":[["كَلَّا","kallā","sekali-kali jangan"],["لَمَّا","lammā","belum"],["يَقْضِ","yaqḍi","ia melaksanakan"],["مَآ","mā","apa"],["أَمَرَهُۥ","amarahu","Dia perintahkan kepadanya"]]},{"t":"Maka hendaklah manusia itu memperhatikan makanannya,","w":[["فَلْيَنظُرِ","falyanẓuri","maka hendaklah ia memperhatikan"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["إِلَىٰ","ilā","kepada"],["طَعَامِهِۦٓ","ṭaʿāmihi","makanannya"]]},{"t":"Kamilah yang telah mencurahkan air melimpah (dari langit),","w":[["اَنَّا","annā","sesungguhnya kami"],["صَبَبْنَا","ṣababnā","Kami telah mencurahkan"],["ٱلْمَآءَ","l-māa","air"],["صَبًّۭا","ṣabban","tercurah"]]},{"t":"kemudian Kami belah bumi dengan sebaik-baiknya,","w":[["ثُمَّ","thumma","kemudian"],["شَقَقْنَا","shaqaqnā","Kami belah"],["ٱلْأَرْضَ","l-arḍa","bumi"],["شَقًّۭا","shaqqan","belahan (sebaik-baiknya)"]]},{"t":"lalu di sana Kami tumbuhkan biji-bijian,","w":[["فَأَنۢبَتْنَا","fa-anbatnā","lalu Kami tumbuhkan"],["فِيهَا","fīhā","padanya"],["حَبًّۭا","ḥabban","biji-bijian"]]},{"t":"dan anggur dan sayur-sayuran,","w":[["وَعِنَبًۭا","waʿinaban","dan angur"],["وَقَضْبًۭا","waqaḍban","dan sayur-sayuran"]]},{"t":"dan zaitun dan pohon kurma,","w":[["وَزَيْتُونًۭا","wazaytūnan","dan zaitun"],["وَنَخْلًۭا","wanakhlan","dan korma"]]},{"t":"dan kebun-kebun (yang) rindang,","w":[["وَحَدَآئِقَ","waḥadāiqa","dan kebun-kebun"],["غُلْبًۭا","ghul'ban","subur/lebat"]]},{"t":"dan buah-buahan serta rerumputan.","w":[["وَفَـٰكِهَةًۭ","wafākihatan","dan buah-buahan"],["وَأَبًّۭا","wa-abban","dan ruput-rumputan"]]},{"t":"(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu.","w":[["مَّتَـٰعًۭا","matāʿan","kesenangan"],["لَّكُمْ","lakum","bagi kalian"],["وَلِأَنْعَـٰمِكُمْ","wali-anʿāmikum","dan bagi binatang ternakmu"]]},{"t":"Maka apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),","w":[["فَإِذَا","fa-idhā","maka apabila"],["جَآءَتِ","jāati","telah datang"],["ٱلصَّآخَّةُ","l-ṣākhatu","suara memekakan"]]},{"t":"pada hari itu manusia lari dari saudaranya,","w":[["يَوْمَ","yawma","pada hari"],["يَفِرُّ","yafirru","lari"],["ٱلْمَرْءُ","l-maru","manusia"],["مِنْ","min","dari"],["أَخِيهِ","akhīhi","saudaranya"]]},{"t":"dan dari ibu dan bapaknya,","w":[["وَأُمِّهِۦ","wa-ummihi","dan ibunya"],["وَأَبِيهِ","wa-abīhi","dan bapaknya"]]},{"t":"dan dari istri dan anak-anaknya.","w":[["وَصَـٰحِبَتِهِۦ","waṣāḥibatihi","dan istrinya"],["وَبَنِيهِ","wabanīhi","dan anak-anaknya"]]},{"t":"Setiap orang dari mereka pada hari itu mempunyai urusan yang menyibukkannya.","w":[["لِكُلِّ","likulli","bagi setiap"],["ٱمْرِئٍۢ","im'ri-in","seseorang"],["مِّنْهُمْ","min'hum","dari mereka"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["شَأْنٌۭ","shanun","urusan"],["يُغْنِيهِ","yugh'nīhi","menyibukkan"]]},{"t":"Pada hari itu ada wajah-wajah yang berseri-seri,","w":[["وُجُوهٌۭ","wujūhun","wajah-wajah"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["مُّسْفِرَةٌۭ","mus'firatun","gembira ria"]]},{"t":"tertawa dan gembira ria,","w":[["ضَاحِكَةٌۭ","ḍāḥikatun","tertawa"],["مُّسْتَبْشِرَةٌۭ","mus'tabshiratun","gembira-ria"]]},{"t":"dan pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram),","w":[["وَوُجُوهٌۭ","wawujūhun","dan wajah-wajah"],["يَوْمَئِذٍ","yawma-idhin","pada hari itu"],["عَلَيْهَا","ʿalayhā","atasnya"],["غَبَرَةٌۭ","ghabaratun","tertutup debu"]]},{"t":"tertutup oleh kegelapan (ditimpa kehinaan dan kesusahan).","w":[["تَرْهَقُهَا","tarhaquhā","menutupinya"],["قَتَرَةٌ","qataratun","kegelapan"]]},{"t":"Mereka itulah orang-orang kafir yang durhaka.","w":[["أُو۟لَـٰٓئِكَ","ulāika","mereka itulah"],["هُمُ","humu","mereka"],["ٱلْكَفَرَةُ","l-kafaratu","orang-orang kafir"],["ٱلْفَجَرَةُ","l-fajaratu","durhaka"]]}]}