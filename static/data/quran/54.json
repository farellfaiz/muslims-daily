{"n":54,"ayat":[{"t":"Saat (hari Kiamat) semakin dekat, bulan pun terbelah.","w":[["ٱقْتَرَبَتِ","iq'tarabati","Telah dekat"],["ٱلسَّاعَةُ","l-sāʿatu","saat itu"],["وَٱنشَقَّ","wa-inshaqqa","telah terbelah"],["ٱلْقَمَرُ","l-qamaru","bulan"]]},{"t":"Dan jika mereka (orang-orang musyrikin) melihat suatu tanda (mukjizat), mereka berpaling dan berkata, \"(Ini adalah) sihir yang terus menerus.\"","w":[["وَإِن","wa-in","Dan jika"],["يَرَوْا۟","yaraw","melihat"],["ءَايَةًۭ","āyatan","tanda (mu'jizat)"],["يُعْرِضُوا۟","yuʿ'riḍū","mereka berpaling"],["وَيَقُولُوا۟","wayaqūlū","berkata"],["سِحْرٌۭ","siḥ'run","(Ini adalah) sihir"],["مُّسْتَمِرٌّۭ","mus'tamirrun","yang terus menerus"]]},{"t":"Dan mereka mendustakan (Muhammad) dan mengikuti nafsu mereka, padahal setiap urusan telah ada ketetapannya.","w":[["وَكَذَّبُوا۟","wakadhabū","Dan mereka mendustakan"],["وَٱتَّبَعُوٓا۟","wa-ittabaʿū","dan mengikuti"],["أَهْوَآءَهُمْ ۚ","ahwāahum","nafsu mereka"],["وَكُلُّ","wakullu","sedang tiap-tiap"],["أَمْرٍۢ","amrin","urusan"],["مُّسْتَقِرٌّۭ","mus'taqirrun","ada ketetapannya"]]},{"t":"Dan sungguh, telah datang kepada mereka beberapa kisah yang di dalamnya terdapat ancaman (terhadap kekafiran),","w":[["وَلَقَدْ","walaqad","Dan sesungguhnya"],["جَآءَهُم","jāahum","telah datang"],["مِّنَ","mina","dari"],["ٱلْأَنۢبَآءِ","l-anbāi","beberapa kisah"],["مَا","mā","yang/apa-apa"],["فِيهِ","fīhi","di dalamnya"],["مُزْدَجَرٌ","muz'dajarun","terdapat cegahan (dari kekafiran)"]]},{"t":"(itulah) suatu hikmah yang sempurna, tetapi peringatan-peringatan itu tidak berguna (bagi mereka),","w":[["حِكْمَةٌۢ","ḥik'matun","itulah suatu hikmat"],["بَـٰلِغَةٌۭ ۖ","bālighatun","yang sempurna"],["فَمَا","famā","maka apa-apa"],["تُغْنِ","tugh'ni","tiada berguna"],["ٱلنُّذُرُ","l-nudhuru","peringatan-peringatan"]]},{"t":"maka berpalinglah engkau (Muhammad) dari mereka pada hari (ketika) penyeru (malaikat) mengajak (mereka) kepada sesuatu yang tidak menyenangkan (hari pembalasan),","w":[["فَتَوَلَّ","fatawalla","Maka berpalinglah"],["عَنْهُمْ ۘ","ʿanhum","dari mereka"],["يَوْمَ","yawma","hari (ketika)"],["يَدْعُ","yadʿu","seorang penyeru"],["ٱلدَّاعِ","l-dāʿi","menyeru"],["إِلَىٰ","ilā","kepada"],["شَىْءٍۢ","shayin","sesuatu"],["نُّكُرٍ","nukurin","yang tidak menyenangkan"]]},{"t":"pandangan mereka tertunduk, ketika mereka keluar dari kuburan, seakan-akan mereka belalang yang beterbangan,","w":[["خُشَّعًا","khushaʿan","sambil menundukkan"],["أَبْصَـٰرُهُمْ","abṣāruhum","pandangan-pandangan"],["يَخْرُجُونَ","yakhrujūna","mereka keluar"],["مِنَ","mina","dari"],["ٱلْأَجْدَاثِ","l-ajdāthi","kuburan"],["كَأَنَّهُمْ","ka-annahum","seakan-akan"],["جَرَادٌۭ","jarādun","belalang"],["مُّنتَشِرٌۭ","muntashirun","beterbangan"]]},{"t":"dengan patuh mereka segera datang kepada penyeru itu. Orang-orang kafir berkata, \"Ini adalah hari yang sulit.\"","w":[["مُّهْطِعِينَ","muh'ṭiʿīna","datang dengan cepat"],["إِلَى","ilā","kepada"],["ٱلدَّاعِ ۖ","l-dāʿi","penyeru"],["يَقُولُ","yaqūlu","berkata"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","Orang-orang kafir"],["هَـٰذَا","hādhā","ini"],["يَوْمٌ","yawmun","hari"],["عَسِرٌۭ","ʿasirun","berat"]]},{"t":"Sebelum mereka, kaum Nuh juga telah mendustakan (rasul), maka mereka mendustakan hamba Kami (Nuh) dan mengatakan, \"Dia orang gila!\" Lalu diusirnya dengan ancaman.","w":[["۞ كَذَّبَتْ","kadhabat","mendustakan"],["قَبْلَهُمْ","qablahum","sebelum mereka"],["قَوْمُ","qawmu","kaum"],["نُوحٍۢ","nūḥin","Nuh"],["فَكَذَّبُوا۟","fakadhabū","mendustakan"],["عَبْدَنَا","ʿabdanā","hamba Kami"],["وَقَالُوا۟","waqālū","mengatakan"],["مَجْنُونٌۭ","majnūnun","seorang gila"],["وَٱزْدُجِرَ","wa-uz'dujira","ancaman"]]},{"t":"Maka dia (Nuh) mengadu kepada Tuhannya, \"Sesungguhnya aku telah dikalahkan, maka tolonglah (aku).\"","w":[["فَدَعَا","fadaʿā","Maka dia mengadu"],["رَبَّهُۥٓ","rabbahu","Rabbnya"],["أَنِّى","annī","aku ini"],["مَغْلُوبٌۭ","maghlūbun","orang yang dikalahkan"],["فَٱنتَصِرْ","fa-intaṣir","maka tolonglah (aku)"]]},{"t":"Lalu Kami bukakan pintu-pintu langit dengan (menurunkan) air yang tercurah,","w":[["فَفَتَحْنَآ","fafataḥnā","Maka Kami bukakan"],["أَبْوَٰبَ","abwāba","pintu-pintu"],["ٱلسَّمَآءِ","l-samāi","langit"],["بِمَآءٍۢ","bimāin","dengan air"],["مُّنْهَمِرٍۢ","mun'hamirin","yang tercurah"]]},{"t":"dan Kami jadikan bumi menyemburkan mata-mata air maka bertemulah (air-air) itu sehinggga (meluap menimbulkan) keadaaan (bencana) yang telah ditetapkan.","w":[["وَفَجَّرْنَا","wafajjarnā","memancarkan"],["ٱلْأَرْضَ","l-arḍa","bumi"],["عُيُونًۭا","ʿuyūnan","mata air"],["فَٱلْتَقَى","fal-taqā","maka bertemulah"],["ٱلْمَآءُ","l-māu","air-air"],["عَلَىٰٓ","ʿalā","atas"],["أَمْرٍۢ","amrin","urusan"],["قَدْ","qad","sesungguhnya"],["قُدِرَ","qudira","ditetapkan"]]},{"t":"Dan Kami angkut dia (Nuh) ke atas (kapal) yang terbuat dari papan dan pasak,","w":[["وَحَمَلْنَـٰهُ","waḥamalnāhu","dan Kami angkut"],["عَلَىٰ","ʿalā","atas"],["ذَاتِ","dhāti","memiliki"],["أَلْوَٰحٍۢ","alwāḥin","papan"],["وَدُسُرٍۢ","wadusurin","dan kayu"]]},{"t":"yang berlayar dengan pemeliharaan (pengawasan) Kami sebagai balasan bagi orang yang telah diingkari (kaumnya).","w":[["تَجْرِى","tajrī","berlayar"],["بِأَعْيُنِنَا","bi-aʿyuninā","dengan pemeliharaan Kami"],["جَزَآءًۭ","jazāan","balasan"],["لِّمَن","liman","bagi orang-orang"],["كَانَ","kāna","adalah"],["كُفِرَ","kufira","diingkari"]]},{"t":"Dan sungguh, kapal itu telah Kami jadikan sebagai tanda (pelajaran). Maka adakah orang yang mau mengambil pelajaran?","w":[["وَلَقَد","walaqad","dan sesungguhnya"],["تَّرَكْنَـٰهَآ","taraknāhā","Kami telah jadikan"],["ءَايَةًۭ","āyatan","pelajaran"],["فَهَلْ","fahal","maka adakah"],["مِن","min","dari"],["مُّدَّكِرٍۢ","muddakirin","mengambil pelajaran"]]},{"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!","w":[["فَكَيْفَ","fakayfa","maka alangkah"],["كَانَ","kāna","adalah"],["عَذَابِى","ʿadhābī","azab-Ku"],["وَنُذُرِ","wanudhuri","dan ancamanKu"]]},{"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["يَسَّرْنَا","yassarnā","telah Kami mudahkan"],["ٱلْقُرْءَانَ","l-qur'āna","Al-Qur'an"],["لِلذِّكْرِ","lildhik'ri","untuk peringatan"],["فَهَلْ","fahal","maka adakah"],["مِن","min","dari"],["مُّدَّكِرٍۢ","muddakirin","orang-orang yang memikirkan"]]},{"t":"Kaum 'Ād pun telah mendustakan. Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!","w":[["كَذَّبَتْ","kadhabat","telah mendustakan"],["عَادٌۭ","ʿādun","kaum 'Ad"],["فَكَيْفَ","fakayfa","maka bagaimana/alangkah"],["كَانَ","kāna","adalah"],["عَذَابِى","ʿadhābī","azab-Ku"],["وَنُذُرِ","wanudhuri","dan peringatan/ancaman-Ku"]]},{"t":"Sesungguhnya Kami telah menghembuskan angin yang sangat kencang kepada mereka pada hari nahas yang terus menerus,","w":[["إِنَّآ","innā","sesungguhnya Kami"],["أَرْسَلْنَا","arsalnā","Kami telah mengirimkan"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["رِيحًۭا","rīḥan","angin"],["صَرْصَرًۭا","ṣarṣaran","sangat kencang"],["فِى","fī","pada"],["يَوْمِ","yawmi","hari"],["نَحْسٍۢ","naḥsin","na'as/sial"],["مُّسْتَمِرٍّۢ","mus'tamirrin","tetap/terus menerus"]]},{"t":"yang membuat manusia bergelimpangan, mereka bagaikan pohon-pohon kurma yang tumbang dengan akar-akarnya.","w":[["تَنزِعُ","tanziʿu","ia mencabut/menggelimpangkan"],["ٱلنَّاسَ","l-nāsa","manusia"],["كَأَنَّهُمْ","ka-annahum","seakan-akan mereka"],["أَعْجَازُ","aʿjāzu","batang"],["نَخْلٍۢ","nakhlin","korma"],["مُّنقَعِرٍۢ","munqaʿirin","tercabut/tumbang"]]},{"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!","w":[["فَكَيْفَ","fakayfa","maka bagaimanakah"],["كَانَ","kāna","adalah"],["عَذَابِى","ʿadhābī","azab-Ku"],["وَنُذُرِ","wanudhuri","dan peringatan/ancaman-Ku"]]},{"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["يَسَّرْنَا","yassarnā","Kami mudahkan"],["ٱلْقُرْءَانَ","l-qur'āna","Al Quran"],["لِلذِّكْرِ","lildhik'ri","untuk peringatan/pelajaran"],["فَهَلْ","fahal","maka adakah"],["مِن","min","dari"],["مُّدَّكِرٍۢ","muddakirin","orang-orang yang memikirkan"]]},{"t":"Kaum Samud pun telah mendustakan peringatan itu.","w":[["كَذَّبَتْ","kadhabat","telah mendustakan"],["ثَمُودُ","thamūdu","kaum Samud"],["بِٱلنُّذُرِ","bil-nudhuri","dengan peringatan/ancaman"]]},{"t":"Maka mereka berkata, \"Bagaimana kita akan mengikuti seorang manusia (biasa) di antara kita? Sungguh, kalau begitu kita benar-benar telah sesat dan gila.","w":[["فَقَالُوٓا۟","faqālū","maka mereka berkata"],["أَبَشَرًۭا","abasharan","apakah sesorang manusia"],["مِّنَّا","minnā","dari antar kita"],["وَٰحِدًۭا","wāḥidan","satu/sendiri"],["نَّتَّبِعُهُۥٓ","nattabiʿuhu","kita mengikutinya"],["إِنَّآ","innā","sesungguhnya"],["إِذًۭا","idhan","apabila"],["لَّفِى","lafī","benar-benar dalam"],["ضَلَـٰلٍۢ","ḍalālin","kesesatan"],["وَسُعُرٍ","wasuʿurin","dan dalam siksaan/gila"]]},{"t":"Apakah wahyu itu diturunkan kepadanya di antara kita? Pastilah dia (Saleh) seorang yang sangat pendusta (dan) sombong.\"","w":[["أَءُلْقِىَ","a-ul'qiya","apakah diturunkan"],["ٱلذِّكْرُ","l-dhik'ru","peringatan"],["عَلَيْهِ","ʿalayhi","atasnya/kepadanya"],["مِنۢ","min","dari"],["بَيْنِنَا","bayninā","antara kita"],["بَلْ","bal","tetapi/bahkan"],["هُوَ","huwa","dia"],["كَذَّابٌ","kadhābun","pendusta"],["أَشِرٌۭ","ashirun","sombong"]]},{"t":"Kelak mereka akan mengetahui siapa yang sebenarnya sangat pendusta (dan) sombong itu.","w":[["سَيَعْلَمُونَ","sayaʿlamūna","mereka akan mengetahui"],["غَدًۭا","ghadan","besok"],["مَّنِ","mani","dari"],["ٱلْكَذَّابُ","l-kadhābu","amat pendusta"],["ٱلْأَشِرُ","l-ashiru","sombong"]]},{"t":"Sesungguhnya Kami akan mengirimkan unta betina sebagai cobaan bagi mereka, maka tunggulah mereka dan bersabarlah (Saleh).","w":[["إِنَّا","innā","sesungguhnya Kami"],["مُرْسِلُوا۟","mur'silū","mengirimkan"],["ٱلنَّاقَةِ","l-nāqati","unta betina"],["فِتْنَةًۭ","fit'natan","fitnah/cobaan"],["لَّهُمْ","lahum","bagi mereka"],["فَٱرْتَقِبْهُمْ","fa-ir'taqib'hum","maka tungguhlah mereka"],["وَٱصْطَبِرْ","wa-iṣ'ṭabir","dan bersabarlah"]]},{"t":"Dan beritahukanlah kepada mereka bahwa air itu dibagi di antara mereka (dengan unta betina itu); setiap orang berhak mendapat giliran minum.","w":[["وَنَبِّئْهُمْ","wanabbi'hum","dan beritakan kepada mereka"],["أَنَّ","anna","sesungguhnya/bahwasanya"],["ٱلْمَآءَ","l-māa","air"],["قِسْمَةٌۢ","qis'matun","terbagi"],["بَيْنَهُمْ ۖ","baynahum","diantara mereka"],["كُلُّ","kullu","tiap-tiap"],["شِرْبٍۢ","shir'bin","minum"],["مُّحْتَضَرٌۭ","muḥ'taḍarun","dihadiri"]]},{"t":"Maka mereka memanggil kawannya, lalu dia menangkap (unta itu) dan memotongnya.","w":[["فَنَادَوْا۟","fanādaw","maka mereka memanggil"],["صَاحِبَهُمْ","ṣāḥibahum","kawan mereka"],["فَتَعَاطَىٰ","fataʿāṭā","lalu ia berbuat nekat"],["فَعَقَرَ","faʿaqara","maka ia memunuh/melukai"]]},{"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!","w":[["فَكَيْفَ","fakayfa","maka bagaimanakah"],["كَانَ","kāna","adalah"],["عَذَابِى","ʿadhābī","azab-Ku"],["وَنُذُرِ","wanudhuri","dan peringatan-Ku"]]},{"t":"Kami kirimkan atas mereka satu suara yang keras mengguntur, maka jadilah mereka seperti batang-batang kering yang lapuk.","w":[["إِنَّآ","innā","sesungguhnya"],["أَرْسَلْنَا","arsalnā","Kami kirimkan"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["صَيْحَةًۭ","ṣayḥatan","suara keras"],["وَٰحِدَةًۭ","wāḥidatan","satu/sekali"],["فَكَانُوا۟","fakānū","maka jadilah mereka"],["كَهَشِيمِ","kahashīmi","seperti rumput kering"],["ٱلْمُحْتَظِرِ","l-muḥ'taẓiri","pengumpul binatang/pemelihara ternak"]]},{"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["يَسَّرْنَا","yassarnā","Kami mudahkan"],["ٱلْقُرْءَانَ","l-qur'āna","Al Quran"],["لِلذِّكْرِ","lildhik'ri","untuk peringatan/pelajaran"],["فَهَلْ","fahal","maka adakah"],["مِن","min","dari"],["مُّدَّكِرٍۢ","muddakirin","orang yang memikirkan"]]},{"t":"Kaum Luṭ pun telah mendustakan peringatan itu.","w":[["كَذَّبَتْ","kadhabat","telah mendustakan"],["قَوْمُ","qawmu","kaum"],["لُوطٍۭ","lūṭin","Lut"],["بِٱلنُّذُرِ","bil-nudhuri","dengan peringatan/ancaman"]]},{"t":"Sesungguhnya Kami kirimkan kepada mereka badai yang membawa batu-batu (yang menimpa mereka), kecuali keluarga Luṭ. Kami selamatkan mereka sebelum fajar menyingsing,","w":[["إِنَّآ","innā","sesungguhnya Kami"],["أَرْسَلْنَا","arsalnā","Kami kirimkan"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["حَاصِبًا","ḥāṣiban","angin yang mengandung batu"],["إِلَّآ","illā","kecuali"],["ءَالَ","āla","atas"],["لُوطٍۢ ۖ","lūṭin","Lut"],["نَّجَّيْنَـٰهُم","najjaynāhum","Kami selamatkan mereka"],["بِسَحَرٍۢ","bisaḥarin","diakhir malam/sebelum fajar"]]},{"t":"sebagai nikmat dari Kami. Demikianlah Kami memberi balasan kepada orang-orang yang bersyukur.","w":[["نِّعْمَةًۭ","niʿ'matan","ni'mat"],["مِّنْ","min","dari"],["عِندِنَا ۚ","ʿindinā","sisi Kami"],["كَذَٰلِكَ","kadhālika","demikianlah"],["نَجْزِى","najzī","Kami memberi balasan"],["مَن","man","orang"],["شَكَرَ","shakara","ia bersyukur"]]},{"t":"Dan sungguh, dia (Luṭ) telah memperingatkan mereka akan hukuman Kami, tetapi mereka mendustakan peringatan-Ku.","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["أَنذَرَهُم","andharahum","ia memperingatkan mereka"],["بَطْشَتَنَا","baṭshatanā","balasan/azab Kami"],["فَتَمَارَوْا۟","fatamāraw","maka (tetapi) mereka membantah/mendustakan"],["بِٱلنُّذُرِ","bil-nudhuri","dengan peringatan/ancaman"]]},{"t":"Dan sungguh, mereka telah membujuknya (agar menyerahkan) tamunya (kepada mereka), lalu Kami butakan mata mereka, maka rasakanlah azab-Ku dan peringatan-Ku!","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["رَٰوَدُوهُ","rāwadūhu","mereka membujuknya"],["عَن","ʿan","dari"],["ضَيْفِهِۦ","ḍayfihi","tamunya"],["فَطَمَسْنَآ","faṭamasnā","lalu Kami butakan"],["أَعْيُنَهُمْ","aʿyunahum","mata-mata mereka"],["فَذُوقُوا۟","fadhūqū","maka rasakanlah"],["عَذَابِى","ʿadhābī","azab-Ku"],["وَنُذُرِ","wanudhuri","dan peringatan/ancaman"]]},{"t":"Dan sungguh, pada esok harinya mereka benar-benar ditimpa azab yang tetap.","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["صَبَّحَهُم","ṣabbaḥahum","mengenai/menimpa mereka"],["بُكْرَةً","buk'ratan","pagi hari"],["عَذَابٌۭ","ʿadhābun","azab"],["مُّسْتَقِرٌّۭ","mus'taqirrun","tetap"]]},{"t":"Maka rasakanlah azab-Ku dan peringatan-Ku!","w":[["فَذُوقُوا۟","fadhūqū","maka rasakanlah"],["عَذَابِى","ʿadhābī","azab-Ku"],["وَنُذُرِ","wanudhuri","dan peringatan"]]},{"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["يَسَّرْنَا","yassarnā","Kami mudahkan"],["ٱلْقُرْءَانَ","l-qur'āna","Al Quran"],["لِلذِّكْرِ","lildhik'ri","untuk peringatan/pelajaran"],["فَهَلْ","fahal","maka adakah"],["مِن","min","dari"],["مُّدَّكِرٍۢ","muddakirin","orang-orang yang memikirkan"]]},{"t":"Dan sungguh, peringatan telah datang kepada keluarga Fir'aun.","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["جَآءَ","jāa","datang"],["ءَالَ","āla","keluarga/kaum"],["فِرْعَوْنَ","fir'ʿawna","Fir'aun"],["ٱلنُّذُرُ","l-nudhuru","pemberi peringatan/ancaman"]]},{"t":"Mereka mendustakan mukjizat-mukjizat Kami semuanya, maka Kami azab mereka dengan azab dari Żat Yang Mahaperkasa, Mahakuasa.","w":[["كَذَّبُوا۟","kadhabū","mereka telah mendustakan"],["بِـَٔايَـٰتِنَا","biāyātinā","pada ayat-ayat Kami"],["كُلِّهَا","kullihā","semuanya"],["فَأَخَذْنَـٰهُمْ","fa-akhadhnāhum","maka Kami ambil/azab mereka"],["أَخْذَ","akhdha","dengan azab"],["عَزِيزٍۢ","ʿazīzin","Maha Perkasa"],["مُّقْتَدِرٍ","muq'tadirin","Maha Kuasa"]]},{"t":"Apakah orang-orang kafir di lingkunganmu (kaum musyrikin) lebih baik dari mereka, ataukah kamu telah mempunyai jaminan kebebasan (dari azab) dalam kitab-kitab terdahulu?","w":[["أَكُفَّارُكُمْ","akuffārukum","apakah orang-orang kafir dari kamu"],["خَيْرٌۭ","khayrun","lebih baik"],["مِّنْ","min","dari"],["أُو۟لَـٰٓئِكُمْ","ulāikum","mereka itu"],["أَمْ","am","atau"],["لَكُم","lakum","bagi kalian"],["بَرَآءَةٌۭ","barāatun","berlepas diri"],["فِى","fī","pada"],["ٱلزُّبُرِ","l-zuburi","Kitab-Kitab terdahulu"]]},{"t":"Atau mereka mengatakan, \"Kami ini golongan yang bersatu yang pasti menang.\"","w":[["أَمْ","am","atau"],["يَقُولُونَ","yaqūlūna","mereka mengatakan"],["نَحْنُ","naḥnu","kami"],["جَمِيعٌۭ","jamīʿun","semua/bersatu/golongan"],["مُّنتَصِرٌۭ","muntaṣirun","dapat menolong/menang"]]},{"t":"Golongan itu pasti akan dikalahkan dan mereka akan mundur ke belakang.","w":[["سَيُهْزَمُ","sayuh'zamu","akan dihacurkan/dikalahkan"],["ٱلْجَمْعُ","l-jamʿu","semua/golongan"],["وَيُوَلُّونَ","wayuwallūna","dan mereka berpaling/mundur"],["ٱلدُّبُرَ","l-dubura","belakang"]]},{"t":"Bahkan hari Kiamat itulah hari yang dijanjikan kepada mereka dan hari Kiamat itu lebih dahsyat dan lebih pahit.","w":[["بَلِ","bali","bahkan"],["ٱلسَّاعَةُ","l-sāʿatu","hari kiamat"],["مَوْعِدُهُمْ","mawʿiduhum","dijanjikan pada mereka"],["وَٱلسَّاعَةُ","wal-sāʿatu","dan hari kiamat"],["أَدْهَىٰ","adhā","lebih buruk/dahsyat"],["وَأَمَرُّ","wa-amarru","dan lebih pahit"]]},{"t":"Sungguh, orang-orang yang berdosa berada dalam kesesatan (di dunia) dan akan berada dalam neraka (di akhirat).","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","orang-orang yang berdosa"],["فِى","fī","dalam"],["ضَلَـٰلٍۢ","ḍalālin","kesesatan"],["وَسُعُرٍۢ","wasuʿurin","dan dalam siksaan/gila"]]},{"t":"Pada hari mereka diseret ke neraka pada wajahnya. (Dikatakan kepada mereka), \"Rasakanlah sentuhan api neraka.\"","w":[["يَوْمَ","yawma","pada hari"],["يُسْحَبُونَ","yus'ḥabūna","mereka diseret"],["فِى","fī","pada"],["ٱلنَّارِ","l-nāri","api neraka"],["عَلَىٰ","ʿalā","atas"],["وُجُوهِهِمْ","wujūhihim","muka-muka mereka"],["ذُوقُوا۟","dhūqū","rasakanlah"],["مَسَّ","massa","sentuhan"],["سَقَرَ","saqara","api/neraka"]]},{"t":"Sungguh, Kami menciptakan segala sesuatu menurut ukuran.","w":[["إِنَّا","innā","sesunguhnya"],["كُلَّ","kulla","setiap"],["شَىْءٍ","shayin","sesuatu"],["خَلَقْنَـٰهُ","khalaqnāhu","Kami menciptakannya"],["بِقَدَرٍۢ","biqadarin","dengan/menurut ukuran"]]},{"t":"Dan perintah Kami hanyalah (dengan) satu perkataan seperti kejapan mata.","w":[["وَمَآ","wamā","dan tidaklah"],["أَمْرُنَآ","amrunā","perintah Kami"],["إِلَّا","illā","kecuali"],["وَٰحِدَةٌۭ","wāḥidatun","satu/sekali"],["كَلَمْحٍۭ","kalamḥin","seperti/secepat kejapan"],["بِٱلْبَصَرِ","bil-baṣari","dengan pandangan mata"]]},{"t":"Dan sungguh, telah Kami binasakan orang yang serupa dengan kamu (kekafirannya). Maka adakah orang yang mau mengambil pelajaran?","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["أَهْلَكْنَآ","ahlaknā","telah Kami binasakan"],["أَشْيَاعَكُمْ","ashyāʿakum","orang yang serupa dengan kamu"],["فَهَلْ","fahal","maka adakah"],["مِن","min","dari"],["مُّدَّكِرٍۢ","muddakirin","orang yang memikirkan"]]},{"t":"Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan.","w":[["وَكُلُّ","wakullu","dan setiap"],["شَىْءٍۢ","shayin","sesuatu"],["فَعَلُوهُ","faʿalūhu","telah mereka kerjakannya"],["فِى","fī","dalam"],["ٱلزُّبُرِ","l-zuburi","kitab"]]},{"t":"Dan segala (sesuatu) yang kecil maupun yang besar (semuanya) tertulis.","w":[["وَكُلُّ","wakullu","dan setiap"],["صَغِيرٍۢ","ṣaghīrin","yang kecil"],["وَكَبِيرٍۢ","wakabīrin","dan yang besar"],["مُّسْتَطَرٌ","mus'taṭarun","tertulis"]]},{"t":"Sungguh, orang-orang yang bertakwa berada di taman-taman dan sungai-sungai,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْمُتَّقِينَ","l-mutaqīna","orang-orang yang bertakwa"],["فِى","fī","dalam"],["جَنَّـٰتٍۢ","jannātin","surga/kebun-kebun"],["وَنَهَرٍۢ","wanaharin","dan sungai-sungai"]]},{"t":"di tempat yang disenangi di sisi Tuhan Yang Mahakuasa.","w":[["فِى","fī","dalam"],["مَقْعَدِ","maqʿadi","tempat duduk"],["صِدْقٍ","ṣid'qin","kebenaran"],["عِندَ","ʿinda","disisi"],["مَلِيكٍۢ","malīkin","yang menguasi/Raja (Tuhan)"],["مُّقْتَدِرٍۭ","muq'tadirin","berkuasa"]]}]}