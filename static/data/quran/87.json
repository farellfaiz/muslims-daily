{"n":87,"ayat":[{"t":"Sucikanlah nama Tuhanmu Yang Mahatinggi,","w":[["سَبِّحِ","sabbiḥi","sucikanlah"],["ٱسْمَ","is'ma","nama"],["رَبِّكَ","rabbika","Tuhanmu"],["ٱلْأَعْلَى","l-aʿlā","Maha Tinggi"]]},{"t":"yang menciptakan, lalu menyempurnakan (penciptaan-Nya),","w":[["ٱلَّذِى","alladhī","yang"],["خَلَقَ","khalaqa","Dia menciptakan"],["فَسَوَّىٰ","fasawwā","lalu Dia menyempurnakan"]]},{"t":"yang menentukan kadar (masing-masing) dan memberi petunjuk,","w":[["وَٱلَّذِى","wa-alladhī","dan yang"],["قَدَّرَ","qaddara","Dia menentukan"],["فَهَدَىٰ","fahadā","lalu Dia memberi petunjuk"]]},{"t":"dan Yang menumbuhkan rerumputan,","w":[["وَٱلَّذِىٓ","wa-alladhī","dan yang"],["أَخْرَجَ","akhraja","Dia keluarkan"],["ٱلْمَرْعَىٰ","l-marʿā","rumput-rumputan"]]},{"t":"lalu dijadikan-Nya (rumput-rumput) itu kering kehitam-hitaman.","w":[["فَجَعَلَهُۥ","fajaʿalahu","lalu Dia jadikannya"],["غُثَآءً","ghuthāan","kering"],["أَحْوَىٰ","aḥwā","kehitam-hitaman"]]},{"t":"Kami akan membacakan (Alquran) kepadamu (Muhammad) sehingga engkau tidak akan lupa,","w":[["سَنُقْرِئُكَ","sanuq'ri-uka","Kami bacakan kepadamu"],["فَلَا","falā","maka tidak"],["تَنسَىٰٓ","tansā","kamu lupa"]]},{"t":"kecuali jika Allah menghendaki. Sungguh, Dia mengetahui yang terang dan yang tersembunyi.","w":[["إِلَّا","illā","kecuali"],["مَا","mā","apa"],["شَآءَ","shāa","dikehendaki"],["ٱللَّهُ ۚ","l-lahu","Allah"],["إِنَّهُۥ","innahu","sesungguhnya Dia"],["يَعْلَمُ","yaʿlamu","mengetahui"],["ٱلْجَهْرَ","l-jahra","terang"],["وَمَا","wamā","dan apa"],["يَخْفَىٰ","yakhfā","tersembunyi"]]},{"t":"Dan Kami akan memudahkan bagimu ke jalan kemudahan (mencapai kebahagian dunia dan akhirat),","w":[["وَنُيَسِّرُكَ","wanuyassiruka","dan Kami memudahkan"],["لِلْيُسْرَىٰ","lil'yus'rā","untuk kemudahan"]]},{"t":"oleh sebab itu berikanlah peringatan, karena peringatan itu bermanfaat,","w":[["فَذَكِّرْ","fadhakkir","maka berilah peringatan"],["إِن","in","sesungguhnya"],["نَّفَعَتِ","nafaʿati","berguna"],["ٱلذِّكْرَىٰ","l-dhik'rā","peringatan"]]},{"t":"orang yang takut (kepada Allah) akan mendapat pelajaran,","w":[["سَيَذَّكَّرُ","sayadhakkaru","akan menerima peringatan"],["مَن","man","orang yang"],["يَخْشَىٰ","yakhshā","ia takut"]]},{"t":"dan orang yang celaka (kafir) akan menjauhinya,","w":[["وَيَتَجَنَّبُهَا","wayatajannabuhā","dan akan menjauhi"],["ٱلْأَشْقَى","l-ashqā","orang yang celaka"]]},{"t":"(yaitu) orang yang akan memasuki api yang besar (neraka),","w":[["ٱلَّذِى","alladhī","yang"],["يَصْلَى","yaṣlā","ia akan masuk"],["ٱلنَّارَ","l-nāra","api/neraka"],["ٱلْكُبْرَىٰ","l-kub'rā","yang besar"]]},{"t":"selanjutnya dia di sana tidak mati dan tidak (pula) hidup.","w":[["ثُمَّ","thumma","kemudian"],["لَا","lā","tidak"],["يَمُوتُ","yamūtu","ia mati"],["فِيهَا","fīhā","di dalamnya"],["وَلَا","walā","dan tidak"],["يَحْيَىٰ","yaḥyā","ia hidup"]]},{"t":"Sungguh beruntung orang yang menyucikan diri (dengan beriman),","w":[["قَدْ","qad","sungguh"],["أَفْلَحَ","aflaḥa","beruntung"],["مَن","man","siapa/orang"],["تَزَكَّىٰ","tazakkā","dia membersihkan diri"]]},{"t":"dan mengingat nama Tuhannya, lalu dia salat.","w":[["وَذَكَرَ","wadhakara","dan dia mengingat"],["ٱسْمَ","is'ma","nama"],["رَبِّهِۦ","rabbihi","Tuhannya"],["فَصَلَّىٰ","faṣallā","dan dia mendirikan sholat"]]},{"t":"Sedangkan kamu (orang-orang kafir) memilih kehidupan dunia,","w":[["بَلْ","bal","bahkan/tetapi"],["تُؤْثِرُونَ","tu'thirūna","kamu memilih"],["ٱلْحَيَوٰةَ","l-ḥayata","kehidupan"],["ٱلدُّنْيَا","l-dun'yā","dunia"]]},{"t":"padahal kehidupan akhirat itu lebih baik dan lebih kekal.","w":[["وَٱلْـَٔاخِرَةُ","wal-ākhiratu","dan akherat"],["خَيْرٌۭ","khayrun","lebih baik"],["وَأَبْقَىٰٓ","wa-abqā","dan lebih kekal"]]},{"t":"Sesungguhnya ini terdapat dalam kitab-kitab yang dahulu,","w":[["إِنَّ","inna","sungguh"],["هَـٰذَا","hādhā","ini"],["لَفِى","lafī","benar-benar dalam"],["ٱلصُّحُفِ","l-ṣuḥufi","kitab-kitab"],["ٱلْأُولَىٰ","l-ūlā","terdahulu"]]},{"t":"(yaitu) kitab-kitab Ibrahim dan Musa.","w":[["صُحُفِ","ṣuḥufi","kitab"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim"],["وَمُوسَىٰ","wamūsā","dan Musa"]]}]}