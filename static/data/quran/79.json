{"n":79,"ayat":[{"t":"Demi (malaikat) yang mencabut (nyawa) dengan keras.","w":[["وَٱلنَّـٰزِعَـٰتِ","wal-nāziʿāti","demi yang mencabut"],["غَرْقًۭا","gharqan","dengan keras"]]},{"t":"Demi (malaikat) yang mencabut (nyawa) dengan lemah lembut.","w":[["وَٱلنَّـٰشِطَـٰتِ","wal-nāshiṭāti","dan yang mencabut"],["نَشْطًۭا","nashṭan","perlahan-lahan"]]},{"t":"Demi (malaikat) yang turun dari langit dengan cepat,","w":[["وَٱلسَّـٰبِحَـٰتِ","wal-sābiḥāti","dan yang turun"],["سَبْحًۭا","sabḥan","cepat"]]},{"t":"dan (malaikat) yang mendahului dengan kencang,","w":[["فَٱلسَّـٰبِقَـٰتِ","fal-sābiqāti","dan yang mendahului"],["سَبْقًۭا","sabqan","dengan kencang"]]},{"t":"dan (malaikat) yang mengatur urusan (dunia).","w":[["فَٱلْمُدَبِّرَٰتِ","fal-mudabirāti","dan yang mengatur"],["أَمْرًۭا","amran","urusan"]]},{"t":"(Sungguh, kamu akan dibangkitkan) pada hari ketika tiupan pertama mengguncangkan alam,","w":[["يَوْمَ","yawma","hari"],["تَرْجُفُ","tarjufu","bergoncang"],["ٱلرَّاجِفَةُ","l-rājifatu","goncangan"]]},{"t":"(tiupan pertama) itu diiringi oleh tiupan kedua.","w":[["تَتْبَعُهَا","tatbaʿuhā","mengikutinya"],["ٱلرَّادِفَةُ","l-rādifatu","yang mengiringi"]]},{"t":"Hati manusia pada waktu itu merasa sangat takut,","w":[["قُلُوبٌۭ","qulūbun","hati-hati"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["وَاجِفَةٌ","wājifatun","berdebar/sangat takut"]]},{"t":"pandangannya tunduk.","w":[["أَبْصَـٰرُهَا","abṣāruhā","pandangannya"],["خَـٰشِعَةٌۭ","khāshiʿatun","takut/tertunduk"]]},{"t":"(orang-orang kafir) berkata, \"Apakah kita benar-benar akan dikembalikan kepada kehidupan yang semula?","w":[["يَقُولُونَ","yaqūlūna","mereka berkata"],["أَءِنَّا","a-innā","apakah sesungguhnya kami"],["لَمَرْدُودُونَ","lamardūdūna","sungguh akan dikembalikan"],["فِى","fī","dalam"],["ٱلْحَافِرَةِ","l-ḥāfirati","keadaan semula"]]},{"t":"Apakah (akan dibangkitkan juga) apabila kita telah menjadi tulang belulang yang hancur?\"","w":[["أَءِذَا","a-idhā","apakah apabila"],["كُنَّا","kunnā","kami adalah/menjadi"],["عِظَـٰمًۭا","ʿiẓāman","tulang belulang"],["نَّخِرَةًۭ","nakhiratan","hancur"]]},{"t":"Mereka berkata, \"Kalau demikian, itu adalah suatu pengembalian yang merugikan.\"","w":[["قَالُوا۟","qālū","mereka berkata"],["تِلْكَ","til'ka","itu"],["إِذًۭا","idhan","jika demikian"],["كَرَّةٌ","karratun","pengembalian"],["خَاسِرَةٌۭ","khāsiratun","kerugian"]]},{"t":"Maka pengembalian itu hanyalah dengan sekali tiupan saja.","w":[["فَإِنَّمَا","fa-innamā","maka sesungguhnya hanyalah"],["هِىَ","hiya","ia/pengembalian"],["زَجْرَةٌۭ","zajratun","teriakan"],["وَٰحِدَةٌۭ","wāḥidatun","satu/satu kali"]]},{"t":"Maka seketika itu mereka hidup kembali di bumi (yang baru).","w":[["فَإِذَا","fa-idhā","maka tiba-tiba"],["هُم","hum","mereka"],["بِٱلسَّاهِرَةِ","bil-sāhirati","di permukaan bumi"]]},{"t":"Sudahkah sampai kepadamu (Muhammad) kisah Musa?","w":[["هَلْ","hal","apakah"],["أَتَىٰكَ","atāka","telah sampai kepadamu"],["حَدِيثُ","ḥadīthu","cerita"],["مُوسَىٰٓ","mūsā","Musa"]]},{"t":"Ketika Tuhan memanggilnya (Musa) di lembah suci yaitu Lembah Tuwa;","w":[["إِذْ","idh","tatkala"],["نَادَىٰهُ","nādāhu","memanggilnya"],["رَبُّهُۥ","rabbuhu","Tuhannya"],["بِٱلْوَادِ","bil-wādi","di lembah"],["ٱلْمُقَدَّسِ","l-muqadasi","suci"],["طُوًى","ṭuwan","Tuwa"]]},{"t":"pergilah engkau kepada Fir'aun! Sesungguhnya dia telah melampaui batas,","w":[["ٱذْهَبْ","idh'hab","pergilah kamu"],["إِلَىٰ","ilā","kepada"],["فِرْعَوْنَ","fir'ʿawna","Fir'aun"],["إِنَّهُۥ","innahu","sesungguhnya dia"],["طَغَىٰ","ṭaghā","melampui batas"]]},{"t":"Maka katakanlah (kepada Fir'aun), \"Adakah keinginanmu untuk membersihkan diri (dari kesesatan),","w":[["فَقُلْ","faqul","maka katakanlah"],["هَل","hal","apakah/maukah"],["لَّكَ","laka","bagimu"],["إِلَىٰٓ","ilā","kepada (untuk)"],["أَن","an","untuk"],["تَزَكَّىٰ","tazakkā","kamu membersihkan diri"]]},{"t":"dan engkau akan kubimbing ke jalan Tuhanmu agar engkau takut kepada-Nya?\"","w":[["وَأَهْدِيَكَ","wa-ahdiyaka","dan aku tunjukkan/pimpin kamu"],["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["فَتَخْشَىٰ","fatakhshā","maka (supaya) kamu takut"]]},{"t":"Lalu (Musa) memperlihatkan kepadanya mukjizat yang besar.","w":[["فَأَرَىٰهُ","fa-arāhu","maka dia memperlihatkan padanya"],["ٱلْـَٔايَةَ","l-āyata","ayat-ayat/mu'jizat"],["ٱلْكُبْرَىٰ","l-kub'rā","yang besar"]]},{"t":"Tetapi dia (Fir'aun) mendustakan dan mendurhakai.","w":[["فَكَذَّبَ","fakadhaba","maka dia mendustakan"],["وَعَصَىٰ","waʿaṣā","dan dia mendurhakai"]]},{"t":"Kemudian dia berpaling seraya berusaha menantang (Musa).","w":[["ثُمَّ","thumma","kemudian"],["أَدْبَرَ","adbara","dia berpaling"],["يَسْعَىٰ","yasʿā","dia berusaha/berjalan"]]},{"t":"Kemudian dia mengumpulkan (pembesar-pembesarnya) lalu berseru (memanggil kaumnya).","w":[["فَحَشَرَ","faḥashara","maka dia mengumpulkan"],["فَنَادَىٰ","fanādā","lalu dia berseru"]]},{"t":"(Seraya) berkata, \"Akulah tuhanmu yang paling tinggi.\"","w":[["فَقَالَ","faqāla","maka dia berkata"],["أَنَا۠","anā","aku"],["رَبُّكُمُ","rabbukumu","Tuhan kalian"],["ٱلْأَعْلَىٰ","l-aʿlā","paling tinggi"]]},{"t":"Maka Allah menghukumnya dengan azab di akhirat dan siksaan di dunia.","w":[["فَأَخَذَهُ","fa-akhadhahu","maka mengambil/menyiksanya"],["ٱللَّهُ","l-lahu","Allah"],["نَكَالَ","nakāla","siksa"],["ٱلْـَٔاخِرَةِ","l-ākhirati","akhirat"],["وَٱلْأُولَىٰٓ","wal-ūlā","dan dunia"]]},{"t":"Sungguh, pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Allah).","w":[["إِنَّ","inna","sesungguhnya"],["فِى","fī","di dalam"],["ذَٰلِكَ","dhālika","itu"],["لَعِبْرَةًۭ","laʿib'ratan","benar-benar pelajaran"],["لِّمَن","liman","bagi orang"],["يَخْشَىٰٓ","yakhshā","takut"]]},{"t":"Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?","w":[["ءَأَنتُمْ","a-antum","apakah kamu"],["أَشَدُّ","ashaddu","sangat"],["خَلْقًا","khalqan","penciptaan"],["أَمِ","ami","atau"],["ٱلسَّمَآءُ ۚ","l-samāu","langit"],["بَنَىٰهَا","banāhā","Dia telah membinanya"]]},{"t":"Dia telah meninggikan bangunannya lalu menyempurnakannya,","w":[["رَفَعَ","rafaʿa","Dia meninggikan"],["سَمْكَهَا","samkahā","bangunannya"],["فَسَوَّىٰهَا","fasawwāhā","lalu Dia sempurnakannya"]]},{"t":"dan Dia menjadikan malamnya (gelap gulita), dan menjadikan siangnya (terang benderang).","w":[["وَأَغْطَشَ","wa-aghṭasha","dan Dia jadikan gelap"],["لَيْلَهَا","laylahā","malamnya"],["وَأَخْرَجَ","wa-akhraja","dan Dia keluarkan/jadikan"],["ضُحَىٰهَا","ḍuḥāhā","paginya/siangnya"]]},{"t":"Dan setelah itu bumi Dia hamparkan.","w":[["وَٱلْأَرْضَ","wal-arḍa","dan bumi"],["بَعْدَ","baʿda","sesudah"],["ذَٰلِكَ","dhālika","demikian itu"],["دَحَىٰهَآ","daḥāhā","Dia haparkannya"]]},{"t":"Darinya Dia pancarkan mata air, dan (ditumbuhkan) tumbuh-tumbuhannya.","w":[["أَخْرَجَ","akhraja","Dia keluarkan"],["مِنْهَا","min'hā","dari padanya"],["مَآءَهَا","māahā","airnya"],["وَمَرْعَىٰهَا","wamarʿāhā","dan padang rumput/tumbuh-tumbuhannya"]]},{"t":"Dan gunung-gunung Dia pancangkan dengan kokoh.","w":[["وَٱلْجِبَالَ","wal-jibāla","dan gunung-gunung"],["أَرْسَىٰهَا","arsāhā","Dia pancangkannya"]]},{"t":"(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu.","w":[["مَتَـٰعًۭا","matāʿan","kesenangan"],["لَّكُمْ","lakum","bagi kalian"],["وَلِأَنْعَـٰمِكُمْ","wali-anʿāmikum","dan untuk binatang ternakmu"]]},{"t":"Maka apabila malapetaka besar (hari Kiamat) telah datang,","w":[["فَإِذَا","fa-idhā","maka apabila"],["جَآءَتِ","jāati","telah datang"],["ٱلطَّآمَّةُ","l-ṭāmatu","keributan/malapetaka"],["ٱلْكُبْرَىٰ","l-kub'rā","besar"]]},{"t":"yaitu pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,","w":[["يَوْمَ","yawma","hari"],["يَتَذَكَّرُ","yatadhakkaru","teringat"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["مَا","mā","apa"],["سَعَىٰ","saʿā","ia telah kerjakan"]]},{"t":"dan neraka diperlihatkan dengan jelas kepada setiap orang yang melihat.","w":[["وَبُرِّزَتِ","waburrizati","dan diperlihatkan"],["ٱلْجَحِيمُ","l-jaḥīmu","neraka"],["لِمَن","liman","bagi/kepada orang"],["يَرَىٰ","yarā","ia melihat"]]},{"t":"Maka adapun orang yang melampaui batas,","w":[["فَأَمَّا","fa-ammā","maka adapun"],["مَن","man","siapa"],["طَغَىٰ","ṭaghā","melampui batas"]]},{"t":"dan lebih mengutamakan kehidupan dunia,","w":[["وَءَاثَرَ","waāthara","dan ia senang/mengutamakan"],["ٱلْحَيَوٰةَ","l-ḥayata","kehidupan"],["ٱلدُّنْيَا","l-dun'yā","dunia"]]},{"t":"maka sungguh, nerakalah tempat tinggalnya.","w":[["فَإِنَّ","fa-inna","maka sesungguhnya"],["ٱلْجَحِيمَ","l-jaḥīma","neraka"],["هِىَ","hiya","ia/neraka"],["ٱلْمَأْوَىٰ","l-mawā","tempat tinggal"]]},{"t":"Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,","w":[["وَأَمَّا","wa-ammā","dan adapun"],["مَنْ","man","siapa"],["خَافَ","khāfa","ia takut"],["مَقَامَ","maqāma","kedudukan/kebesaran"],["رَبِّهِۦ","rabbihi","Tuhannya"],["وَنَهَى","wanahā","dan ia menahan"],["ٱلنَّفْسَ","l-nafsa","jiwa/diri"],["عَنِ","ʿani","dari"],["ٱلْهَوَىٰ","l-hawā","keinginan/hawa nafsu"]]},{"t":"maka sungguh, surgalah tempat tinggal-(nya).","w":[["فَإِنَّ","fa-inna","maka sesungguhnya"],["ٱلْجَنَّةَ","l-janata","sorga"],["هِىَ","hiya","ia"],["ٱلْمَأْوَىٰ","l-mawā","tempat tinggal"]]},{"t":"Mereka (orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari Kiamat, \"Kapankah terjadinya?\"","w":[["يَسْـَٔلُونَكَ","yasalūnaka","mereka akan bertanya kepadamu"],["عَنِ","ʿani","dari"],["ٱلسَّاعَةِ","l-sāʿati","waktu/kiamat"],["أَيَّانَ","ayyāna","kepada/bila"],["مُرْسَىٰهَا","mur'sāhā","kedatangannya/terjadinya"]]},{"t":"Untuk apa engkau perlu menyebutkannya (waktunya)?","w":[["فِيمَ","fīma","dalam apa/mengapa"],["أَنتَ","anta","kamu"],["مِن","min","dari"],["ذِكْرَىٰهَآ","dhik'rāhā","mengingat/menyebut"]]},{"t":"Kepada Tuhanmulah (dikembalikan) kesudahannya (ketentuan waktunya).","w":[["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["مُنتَهَىٰهَآ","muntahāhā","kesudahannya"]]},{"t":"Engkau (Muhammad) hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari Kiamat).","w":[["إِنَّمَآ","innamā","sesungguhnya hanyalah"],["أَنتَ","anta","kamu"],["مُنذِرُ","mundhiru","pemberi peringatan"],["مَن","man","dari"],["يَخْشَىٰهَا","yakhshāhā","ia takut kepadanya"]]},{"t":"Pada hari ketika mereka melihat hari Kiamat itu (karena suasananya hebat), mereka merasa seakan-akan hanya (sebentar saja) tinggal (di dunia) pada waktu sore atau pagi hari.","w":[["كَأَنَّهُمْ","ka-annahum","seakan-akan mereka"],["يَوْمَ","yawma","hari"],["يَرَوْنَهَا","yarawnahā","mereka melihatnya"],["لَمْ","lam","tidak"],["يَلْبَثُوٓا۟","yalbathū","mereka tinggal"],["إِلَّا","illā","kecuali"],["عَشِيَّةً","ʿashiyyatan","di waktu sore"],["أَوْ","aw","atau"],["ضُحَىٰهَا","ḍuḥāhā","pagi harinya"]]}]}