{"n":1,"ayat":[{"t":"Dengan nama Allah Yang Maha Pengasih, Maha Penyayang.","w":[["بِسْمِ","bis'mi","dengan nama"],["ٱللَّهِ","l-lahi","Allah"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","Maha Pengasih"],["ٱلرَّحِيمِ","l-raḥīmi","Maha Penyayang"]]},{"t":"Segala puji bagi Allah, Tuhan seluruh alam,","w":[["ٱلْحَمْدُ","al-ḥamdu","pujian"],["لِلَّهِ","lillahi","bagi Allah"],["رَبِّ","rabbi","Tuhan"],["ٱلْعَـٰلَمِينَ","l-ʿālamīna","alam semesta"]]},{"t":"Yang Maha Pengasih, Maha Penyayang,","w":[["ٱلرَّحْمَـٰنِ","al-raḥmāni","Maha Pengasih"],["ٱلرَّحِيمِ","l-raḥīmi","Maha Penyayang"]]},{"t":"Pemilik hari pembalasan.","w":[["مَـٰلِكِ","māliki","Penguasa"],["يَوْمِ","yawmi","hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"Hanya kepada Engkaulah kami menyembah dan hanya kepada Engkaulah kami mohon pertolongan.","w":[["إِيَّاكَ","iyyāka","hanya kepadaMu"],["نَعْبُدُ","naʿbudu","kami menyembah"],["وَإِيَّاكَ","wa-iyyāka","dan hanya kepadaMu"],["نَسْتَعِينُ","nastaʿīnu","kami mohon pertolongan"]]},{"t":"Tunjukilah kami jalan yang lurus,","w":[["ٱهْدِنَا","ih'dinā","tunjukkan kami"],["ٱلصِّرَٰطَ","l-ṣirāṭa","jalan"],["ٱلْمُسْتَقِيمَ","l-mus'taqīma","lurus"]]},{"t":"(yaitu) jalan orang-orang yang telah Engkau beri nikmat kepadanya; bukan (jalan) mereka yang dimurkai, dan bukan (pula jalan) mereka yang sesat.","w":[["صِرَٰطَ","ṣirāṭa","jalan"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["أَنْعَمْتَ","anʿamta","diberi nikmat"],["عَلَيْهِمْ","ʿalayhim","kepadanya"],["غَيْرِ","ghayri","bukan"],["ٱلْمَغْضُوبِ","l-maghḍūbi","orang yang dimurkai"],["عَلَيْهِمْ","ʿalayhim","kepadanya"],["وَلَا","walā","dan tidak"],["ٱلضَّآلِّينَ","l-ḍālīna","orang-orang yang sesat"]]}]}