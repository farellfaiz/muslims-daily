{"n":82,"ayat":[{"t":"Apabila langit terbelah,","w":[["إِذَا","idhā","apabila"],["ٱلسَّمَآءُ","l-samāu","langit"],["ٱنفَطَرَتْ","infaṭarat","terbelah"]]},{"t":"dan apabila bintang-bintang jatuh berserakan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْكَوَاكِبُ","l-kawākibu","bintang-bintang"],["ٱنتَثَرَتْ","intatharat","jatuh bertaburan"]]},{"t":"dan apabila lautan dijadikan meluap,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْبِحَارُ","l-biḥāru","lautan"],["فُجِّرَتْ","fujjirat","dijadikan meluap"]]},{"t":"dan apabila kuburan-kuburan dibongkar,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْقُبُورُ","l-qubūru","kuburan-kuburan"],["بُعْثِرَتْ","buʿ'thirat","di bongkar"]]},{"t":"(maka) setiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikan(nya).","w":[["عَلِمَتْ","ʿalimat","mengetahui"],["نَفْسٌۭ","nafsun","jiwa"],["مَّا","mā","apa"],["قَدَّمَتْ","qaddamat","diusahakan"],["وَأَخَّرَتْ","wa-akharat","dan ditinggalkan"]]},{"t":"Wahai manusia! Apakah yang telah memperdayakan kamu (berbuat durhaka) terhadap Tuhanmu Yang Maha Pengasih.","w":[["يَـٰٓأَيُّهَا","yāayyuhā","wahai"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["مَا","mā","apa"],["غَرَّكَ","gharraka","yang menipu kamu"],["بِرَبِّكَ","birabbika","terhadap Tuhanmu"],["ٱلْكَرِيمِ","l-karīmi","Mulia/Pemurah"]]},{"t":"Yang telah menciptakanmu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)mu seimbang,","w":[["ٱلَّذِى","alladhī","yang"],["خَلَقَكَ","khalaqaka","telah menciptakan kamu"],["فَسَوَّىٰكَ","fasawwāka","lalu Dia menyempurnakan kamu"],["فَعَدَلَكَ","faʿadalaka","lalu Dia menjadikan kamu seimbang"]]},{"t":"dalam bentuk apa saja yang dikehendaki, Dia menyusun tubuhmu.","w":[["فِىٓ","fī","dalam"],["أَىِّ","ayyi","apa saja"],["صُورَةٍۢ","ṣūratin","gambar/bentuk"],["مَّا","mā","apa"],["شَآءَ","shāa","yang Dia kehendaki"],["رَكَّبَكَ","rakkabaka","Dia menyusunmu"]]},{"t":"Sekali-kali jangan begitu! Bahkan kamu mendustakan hari pembalasan.","w":[["كَلَّا","kallā","sekali-kali jangan"],["بَلْ","bal","tetap/bahkan"],["تُكَذِّبُونَ","tukadhibūna","kamu mendustakan"],["بِٱلدِّينِ","bil-dīni","pada hari pembalasan"]]},{"t":"Dan sesungguhnya bagi kamu ada (malaikat-malaikat) yang mengawasi (pekerjaanmu),","w":[["وَإِنَّ","wa-inna","dan sesungguhnya"],["عَلَيْكُمْ","ʿalaykum","atas kalian"],["لَحَـٰفِظِينَ","laḥāfiẓīna","sungguh ada penjaga"]]},{"t":"yang mulia (di sisi Allah) dan yang mencatat (perbuatanmu),","w":[["كِرَامًۭا","kirāman","yang mulia"],["كَـٰتِبِينَ","kātibīna","yang mencatat"]]},{"t":"mereka mengetahui apa yang kamu kerjakan.","w":[["يَعْلَمُونَ","yaʿlamūna","mereka mengetahui"],["مَا","mā","apa"],["تَفْعَلُونَ","tafʿalūna","kamu kerjakan"]]},{"t":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْأَبْرَارَ","l-abrāra","orang-orang yang baik"],["لَفِى","lafī","benar-benar dalam"],["نَعِيمٍۢ","naʿīmin","kesenangan/kenikmatan"]]},{"t":"dan sesungguhnya orang-orang yang durhaka benar-benar berada dalam neraka.","w":[["وَإِنَّ","wa-inna","dan sesungguhnya"],["ٱلْفُجَّارَ","l-fujāra","orang-orang durhaka"],["لَفِى","lafī","dalam"],["جَحِيمٍۢ","jaḥīmin","neraka"]]},{"t":"Mereka masuk ke dalamnya pada hari pembalasan.","w":[["يَصْلَوْنَهَا","yaṣlawnahā","mereka masuk kedalamnya"],["يَوْمَ","yawma","hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"Dan mereka tidak mungkin keluar dari neraka itu.","w":[["وَمَا","wamā","dan tidaklah"],["هُمْ","hum","mereka"],["عَنْهَا","ʿanhā","dari padanya"],["بِغَآئِبِينَ","bighāibīna","dengan gaib/meloloskan diri"]]},{"t":"Dan tahukah kamu apakah hari pembalasan itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu melihat"],["مَا","mā","apa"],["يَوْمُ","yawmu","hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"Sekali lagi, tahukah kamu apakah hari pembalasan itu?","w":[["ثُمَّ","thumma","kemudian"],["مَآ","mā","apakah"],["أَدْرَىٰكَ","adrāka","kamu melihat"],["مَا","mā","apa"],["يَوْمُ","yawmu","hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"(Yaitu) pada hari (ketika) seseorang sama sekali tidak berdaya (menolong) orang lain. Dan segala urusan pada hari itu dalam kekuasaan Allah.","w":[["يَوْمَ","yawma","hari"],["لَا","lā","tidak"],["تَمْلِكُ","tamliku","berdaya/berkuasa"],["نَفْسٌۭ","nafsun","manusia"],["لِّنَفْسٍۢ","linafsin","bagi diri/seseorang"],["شَيْـًۭٔا ۖ","shayan","sesuatu/sedikitpun"],["وَٱلْأَمْرُ","wal-amru","dan urusan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلَّهِ","lillahi","bagi Allah"]]}]}