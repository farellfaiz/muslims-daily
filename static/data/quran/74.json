{"n":74,"ayat":[{"t":"Wahai orang yang berkemul (berselimut)!","w":[["يَـٰٓأَيُّهَا","yāayyuhā","wahai"],["ٱلْمُدَّثِّرُ","l-mudathiru","orang yang berkemul"]]},{"t":"bangunlah, lalu berilah peringatan!","w":[["قُمْ","qum","bangunlah"],["فَأَنذِرْ","fa-andhir","lalu berilah peringatan"]]},{"t":"dan agungkanlah Tuhanmu,","w":[["وَرَبَّكَ","warabbaka","dan Tuhanmu"],["فَكَبِّرْ","fakabbir","maka besarkan/agungkan"]]},{"t":"dan bersihkanlah pakaianmu,","w":[["وَثِيَابَكَ","wathiyābaka","dan pakaianmu"],["فَطَهِّرْ","faṭahhir","maka bersihkan"]]},{"t":"dan tinggalkanlah segala (perbuatan) yang keji,","w":[["وَٱلرُّجْزَ","wal-ruj'za","dan perbuatan dosa"],["فَٱهْجُرْ","fa-uh'jur","maka tinggalkan"]]},{"t":"dan janganlah engkau (Muhammad) memberi (dengan maksud) memperoleh (balasan) yang lebih banyak.","w":[["وَلَا","walā","dan jangan"],["تَمْنُن","tamnun","kamu memberi/anugerah"],["تَسْتَكْثِرُ","tastakthiru","kamu mengharap lebih banyak"]]},{"t":"Dan karena Tuhanmu, bersabarlah.","w":[["وَلِرَبِّكَ","walirabbika","dan untuk Tuhanmu"],["فَٱصْبِرْ","fa-iṣ'bir","maka bersabarlah"]]},{"t":"Maka apabila sangkakala ditiup,","w":[["فَإِذَا","fa-idhā","maka apabila"],["نُقِرَ","nuqira","ditiup"],["فِى","fī","pada"],["ٱلنَّاقُورِ","l-nāqūri","sangkakala"]]},{"t":"maka itulah hari yang serba sulit,","w":[["فَذَٰلِكَ","fadhālika","maka demikian itu"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["يَوْمٌ","yawmun","hari"],["عَسِيرٌ","ʿasīrun","sulit"]]},{"t":"bagi orang-orang kafir tidak mudah.","w":[["عَلَى","ʿalā","atas/bagi"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","orang-orang kafir"],["غَيْرُ","ghayru","tidak"],["يَسِيرٍۢ","yasīrin","mudah"]]},{"t":"Biarkanlah Aku (yang bertindak) terhadap orang yang Aku sendiri telah menciptakannya,","w":[["ذَرْنِى","dharnī","biarkan Aku"],["وَمَنْ","waman","dan orang"],["خَلَقْتُ","khalaqtu","Aku ciptakan"],["وَحِيدًۭا","waḥīdan","satu/sendiri"]]},{"t":"dan Aku berikan baginya kekayaan yang melimpah,","w":[["وَجَعَلْتُ","wajaʿaltu","dan Aku jadikan"],["لَهُۥ","lahu","baginya"],["مَالًۭا","mālan","harta"],["مَّمْدُودًۭا","mamdūdan","panjang/banyak"]]},{"t":"dan anak-anak yang selalu bersamanya,","w":[["وَبَنِينَ","wabanīna","dan anak-anak"],["شُهُودًۭا","shuhūdan","saksi-saksi/hadir"]]},{"t":"dan Aku berikan baginya kelapangan (hidup) seluas-luasnya.","w":[["وَمَهَّدتُّ","wamahhadttu","dan Aku lapangkan (rizki)"],["لَهُۥ","lahu","baginya"],["تَمْهِيدًۭا","tamhīdan","selapang-lapangnya"]]},{"t":"kemudian dia ingin sekali agar Aku menambahnya.","w":[["ثُمَّ","thumma","kemudian"],["يَطْمَعُ","yaṭmaʿu","dia ingin sekali"],["أَنْ","an","bahwa/supaya"],["أَزِيدَ","azīda","Aku menambahnya"]]},{"t":"Tidak bisa! Sesungguhnya dia telah menentang ayat-ayat Kami (Alquran).","w":[["كَلَّآ ۖ","kallā","sekali-kali tidak"],["إِنَّهُۥ","innahu","karena sesungguhnya"],["كَانَ","kāna","adalah"],["لِـَٔايَـٰتِنَا","liāyātinā","kepada ayat-ayat Kami"],["عَنِيدًۭا","ʿanīdan","menentang"]]},{"t":"Aku akan membebaninya dengan pendakian yang meletihkan.","w":[["سَأُرْهِقُهُۥ","sa-ur'hiquhu","akan aku timpakan"],["صَعُودًا","ṣaʿūdan","siksaan yang payah/berat"]]},{"t":"Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),","w":[["إِنَّهُۥ","innahu","sesungguhnya"],["فَكَّرَ","fakkara","dia telah memikirkan"],["وَقَدَّرَ","waqaddara","dan telah menetapkan"]]},{"t":"maka celakalah dia! Bagaimana dia menetapkan?","w":[["فَقُتِلَ","faqutila","maka celakalah ia"],["كَيْفَ","kayfa","bagaimanakah"],["قَدَّرَ","qaddara","dia menetapkan"]]},{"t":"sekali lagi, celakalah dia! Bagaimana dia menetapkan?","w":[["ثُمَّ","thumma","sesungguhnya"],["قُتِلَ","qutila","celakalah dia"],["كَيْفَ","kayfa","bagaimanakah"],["قَدَّرَ","qaddara","dia menetapkan"]]},{"t":"kemudian dia (merenung) memikirkan,","w":[["ثُمَّ","thumma","kemudian"],["نَظَرَ","naẓara","dia memperhatikan/memikirkan"]]},{"t":"lalu berwajah masam dan cemberut,","w":[["ثُمَّ","thumma","kemudian"],["عَبَسَ","ʿabasa","dia bermasam muka"],["وَبَسَرَ","wabasara","dan dia merengut"]]},{"t":"kemudian berpaling (dari kebenaran) dan menyombongkan diri,","w":[["ثُمَّ","thumma","kemudian"],["أَدْبَرَ","adbara","dia berpaling"],["وَٱسْتَكْبَرَ","wa-is'takbara","dan dia menyombongkan diri"]]},{"t":"lalu dia berkata, \"(Alquran) ini hanyalah sihir yang dipelajari (dari orang-orang dahulu).","w":[["فَقَالَ","faqāla","lalu dia berkata"],["إِنْ","in","tidaklah"],["هَـٰذَآ","hādhā","ini"],["إِلَّا","illā","kecuali"],["سِحْرٌۭ","siḥ'run","sihir"],["يُؤْثَرُ","yu'tharu","diceritakan/dipelajari"]]},{"t":"Ini hanyalah perkataan manusia.\"","w":[["إِنْ","in","tidaklah"],["هَـٰذَآ","hādhā","ini"],["إِلَّا","illā","kecuali"],["قَوْلُ","qawlu","perkataan"],["ٱلْبَشَرِ","l-bashari","manusia"]]},{"t":"Kelak, Aku akan memasukkannya ke dalam (neraka) Saqar,","w":[["سَأُصْلِيهِ","sa-uṣ'līhi","akan Aku masukkan dia"],["سَقَرَ","saqara","neraka saqar"]]},{"t":"Dan tahukah kamu apa (neraka) Saqar itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu mengetahui"],["مَا","mā","apa"],["سَقَرُ","saqaru","neraka saqar"]]},{"t":"Ia (Saqar itu) tidak meninggalkan dan tidak membiarkan,","w":[["لَا","lā","tidak"],["تُبْقِى","tub'qī","ia meninggalkan"],["وَلَا","walā","dan tidak"],["تَذَرُ","tadharu","ia membiarkan"]]},{"t":"yang menghanguskan kulit manusia.","w":[["لَوَّاحَةٌۭ","lawwāḥatun","yang membakar"],["لِّلْبَشَرِ","lil'bashari","bagi manusia"]]},{"t":"Di atasnya ada sembilan belas (malaikat penjaga).","w":[["عَلَيْهَا","ʿalayhā","di atasnya"],["تِسْعَةَ","tis'ʿata","sembilan"],["عَشَرَ","ʿashara","belas"]]},{"t":"Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah membiarkan sesat orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia.","w":[["وَمَا","wamā","dan tidak"],["جَعَلْنَآ","jaʿalnā","Kami jadikan"],["أَصْحَـٰبَ","aṣḥāba","penghuni/penjaga"],["ٱلنَّارِ","l-nāri","neraka"],["إِلَّا","illā","kecuali"],["مَلَـٰٓئِكَةًۭ ۙ","malāikatan","malaikat"],["وَمَا","wamā","dan tidak"],["جَعَلْنَا","jaʿalnā","Kami jadikan"],["عِدَّتَهُمْ","ʿiddatahum","bilangan mereka"],["إِلَّا","illā","kecuali"],["فِتْنَةًۭ","fit'natan","fitnah/cobaan"],["لِّلَّذِينَ","lilladhīna","bagi orang-orang yang"],["كَفَرُوا۟","kafarū","kafir/ingkar"],["لِيَسْتَيْقِنَ","liyastayqina","supaya meyakini"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["أُوتُوا۟","ūtū","(mereka) diberi"],["ٱلْكِتَـٰبَ","l-kitāba","Kitab"],["وَيَزْدَادَ","wayazdāda","dan bertambah"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوٓا۟","āmanū","beriman"],["إِيمَـٰنًۭا ۙ","īmānan","keimanan"],["وَلَا","walā","dan tidak"],["يَرْتَابَ","yartāba","ragu-ragu"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["أُوتُوا۟","ūtū","(mereka) diberi"],["ٱلْكِتَـٰبَ","l-kitāba","Kitab"],["وَٱلْمُؤْمِنُونَ ۙ","wal-mu'minūna","dan orang-orang yang beriman"],["وَلِيَقُولَ","waliyaqūla","dan supaya mengatakan"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["فِى","fī","dalam"],["قُلُوبِهِم","qulūbihim","hati mereka"],["مَّرَضٌۭ","maraḍun","penyakit"],["وَٱلْكَـٰفِرُونَ","wal-kāfirūna","dan orang-orang kafir"],["مَاذَآ","mādhā","apakah"],["أَرَادَ","arāda","menghendaki"],["ٱللَّهُ","l-lahu","Allah"],["بِهَـٰذَا","bihādhā","dengan ini"],["مَثَلًۭا ۚ","mathalan","perumpamaan"],["كَذَٰلِكَ","kadhālika","demikianlah"],["يُضِلُّ","yuḍillu","menyesatkan"],["ٱللَّهُ","l-lahu","Allah"],["مَن","man","siapa/orang"],["يَشَآءُ","yashāu","Dia kehendaki"],["وَيَهْدِى","wayahdī","dan Dia memberi petunjuk"],["مَن","man","siapa/orang"],["يَشَآءُ ۚ","yashāu","Dia kehendaki"],["وَمَا","wamā","dan tidak"],["يَعْلَمُ","yaʿlamu","mengetahui"],["جُنُودَ","junūda","bala tentara"],["رَبِّكَ","rabbika","Tuhanmu"],["إِلَّا","illā","kecuali"],["هُوَ ۚ","huwa","Dia"],["وَمَا","wamā","dan tidaklah"],["هِىَ","hiya","ia"],["إِلَّا","illā","kecuali"],["ذِكْرَىٰ","dhik'rā","peringatan"],["لِلْبَشَرِ","lil'bashari","bagi manusia"]]},{"t":"Tidak! Demi bulan,","w":[["كَلَّا","kallā","sekali-kali tidak"],["وَٱلْقَمَرِ","wal-qamari","demi bulan"]]},{"t":"dan demi malam ketika telah berlalu,","w":[["وَٱلَّيْلِ","wa-al-layli","dan malam"],["إِذْ","idh","tatkala"],["أَدْبَرَ","adbara","mundur/berlalu"]]},{"t":"dan demi subuh apabila mulai terang,","w":[["وَٱلصُّبْحِ","wal-ṣub'ḥi","dan subuh"],["إِذَآ","idhā","tatkala"],["أَسْفَرَ","asfara","terbit/terang"]]},{"t":"sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,","w":[["إِنَّهَا","innahā","sesungguhnya ia (saqar)"],["لَإِحْدَى","la-iḥ'dā","salah satu"],["ٱلْكُبَرِ","l-kubari","amat besar"]]},{"t":"sebagai peringatan bagi manusia,","w":[["نَذِيرًۭا","nadhīran","peringatan"],["لِّلْبَشَرِ","lil'bashari","bagi manusia"]]},{"t":"(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur.","w":[["لِمَن","liman","bagi siapa"],["شَآءَ","shāa","menghendaki"],["مِنكُمْ","minkum","diantara kamu"],["أَن","an","bahwa"],["يَتَقَدَّمَ","yataqaddama","akan maju"],["أَوْ","aw","atau"],["يَتَأَخَّرَ","yata-akhara","akan mundur"]]},{"t":"Setiap orang bertanggung jawab atas apa yang telah dilakukannya,","w":[["كُلُّ","kullu","tiap-tiap"],["نَفْسٍۭ","nafsin","jiwa/diri"],["بِمَا","bimā","terhadap apa"],["كَسَبَتْ","kasabat","ia usahakan/ia perbuat"],["رَهِينَةٌ","rahīnatun","tergadai/terikat"]]},{"t":"kecuali golongan kanan,","w":[["إِلَّآ","illā","kecuali"],["أَصْحَـٰبَ","aṣḥāba","kaum/golongan"],["ٱلْيَمِينِ","l-yamīni","kanan"]]},{"t":"berada di dalam surga, mereka saling menanyakan,","w":[["فِى","fī","dalam"],["جَنَّـٰتٍۢ","jannātin","sorga"],["يَتَسَآءَلُونَ","yatasāalūna","mereka saling bertanya"]]},{"t":"tentang (keadaan) orang-orang yang berdosa,","w":[["عَنِ","ʿani","dari/tentang"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","orang-orang yang berdosa"]]},{"t":"\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\"","w":[["مَا","mā","apa yang"],["سَلَكَكُمْ","salakakum","memasukkan kamu"],["فِى","fī","dalam"],["سَقَرَ","saqara","neraka saqar"]]},{"t":"Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,","w":[["قَالُوا۟","qālū","mereka berkata"],["لَمْ","lam","tidak ada"],["نَكُ","naku","kami"],["مِنَ","mina","dari"],["ٱلْمُصَلِّينَ","l-muṣalīna","orang-orang yang mengerjakan sholat"]]},{"t":"dan kami (juga) tidak memberi makan orang miskin,","w":[["وَلَمْ","walam","dan tidak ada"],["نَكُ","naku","kami"],["نُطْعِمُ","nuṭ'ʿimu","kami memberi makan"],["ٱلْمِسْكِينَ","l-mis'kīna","orang-orang miskin"]]},{"t":"bahkan kami biasa berbincang (untuk tujuan yang batil), bersama orang-orang yang membicarakannya,","w":[["وَكُنَّا","wakunnā","dan kami adalah"],["نَخُوضُ","nakhūḍu","kami mencela/memperolok-olok"],["مَعَ","maʿa","bersama"],["ٱلْخَآئِضِينَ","l-khāiḍīna","orang-orang yang mencela/memperolok-olok"]]},{"t":"dan kami mendustakan hari pembalasan,","w":[["وَكُنَّا","wakunnā","dan kami adalah"],["نُكَذِّبُ","nukadhibu","kami mendustakan"],["بِيَوْمِ","biyawmi","dengan hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"sampai datang kepada kami kematian.\"","w":[["حَتَّىٰٓ","ḥattā","sehingga"],["أَتَىٰنَا","atānā","datang kepada kami"],["ٱلْيَقِينُ","l-yaqīnu","kepastian"]]},{"t":"Maka tidak berguna lagi bagi mereka syafaat (pertolongan) dari orang-orang yang memberikan syafaat.","w":[["فَمَا","famā","maka tidak"],["تَنفَعُهُمْ","tanfaʿuhum","berguna kepada mereka"],["شَفَـٰعَةُ","shafāʿatu","pertolongan/syafaat"],["ٱلشَّـٰفِعِينَ","l-shāfiʿīna","orang-orang yang memberi pertolongan/syafaat"]]},{"t":"Lalu mengapa mereka (orang-orang kafir) berpaling dari peringatan (Allah)?","w":[["فَمَا","famā","maka mengapa"],["لَهُمْ","lahum","bagi mereka"],["عَنِ","ʿani","dari"],["ٱلتَّذْكِرَةِ","l-tadhkirati","peringatan"],["مُعْرِضِينَ","muʿ'riḍīna","orang-orang yang berpaling"]]},{"t":"seakan-akan mereka keledai liar yang lari terkejut,","w":[["كَأَنَّهُمْ","ka-annahum","seakan-akan mereka"],["حُمُرٌۭ","ḥumurun","keledai"],["مُّسْتَنفِرَةٌۭ","mus'tanfiratun","yang terkejut"]]},{"t":"lari dari singa.","w":[["فَرَّتْ","farrat","ia lari"],["مِن","min","dari"],["قَسْوَرَةٍۭ","qaswaratin","singa"]]},{"t":"Bahkan setiap orang dari mereka ingin agar diberikan kepadanya lembaran-lembaran (kitab) yang terbuka.","w":[["بَلْ","bal","bahkan"],["يُرِيدُ","yurīdu","menghendaki"],["كُلُّ","kullu","tiap-tiap"],["ٱمْرِئٍۢ","im'ri-in","seseorang"],["مِّنْهُمْ","min'hum","di antara mereka"],["أَن","an","untuk"],["يُؤْتَىٰ","yu'tā","diberi ia"],["صُحُفًۭا","ṣuḥufan","lembaran-lembaran"],["مُّنَشَّرَةًۭ","munasharatan","ditebarkan/terbuka"]]},{"t":"Tidak! Sebenarnya mereka tidak takut kepada akhirat.","w":[["كَلَّا ۖ","kallā","sekali-kali tidak"],["بَل","bal","bahkan"],["لَّا","lā","tidak"],["يَخَافُونَ","yakhāfūna","mereka takut"],["ٱلْـَٔاخِرَةَ","l-ākhirata","hari akhirat"]]},{"t":"Tidak! Sesungguhnya (Alquran) itu benar-benar suatu peringatan.","w":[["كَلَّآ","kallā","sekali-kali tidak"],["إِنَّهُۥ","innahu","sesungguhnya ia"],["تَذْكِرَةٌۭ","tadhkiratun","peringatan/pelajaran"]]},{"t":"Maka barangsiapa menghendaki, tentu dia mengambil pelajaran darinya.","w":[["فَمَن","faman","maka barangsiapa"],["شَآءَ","shāa","dia menghendaki"],["ذَكَرَهُۥ","dhakarahu","dia mengingatnya"]]},{"t":"Dan mereka tidak akan mengambil pelajaran darinya (Alquran) kecuali (jika) Allah menghendakinya. Dialah Tuhan yang patut (kita) bertakwa kepada-Nya dan yang berhak memberi ampun.","w":[["وَمَا","wamā","dan tidak"],["يَذْكُرُونَ","yadhkurūna","mereka mengingat"],["إِلَّآ","illā","kecuali"],["أَن","an","bahwa"],["يَشَآءَ","yashāa","menghendaki"],["ٱللَّهُ ۚ","l-lahu","Allah"],["هُوَ","huwa","Dia"],["أَهْلُ","ahlu","berhak/patut"],["ٱلتَّقْوَىٰ","l-taqwā","takwa/taat"],["وَأَهْلُ","wa-ahlu","dan berhak/patut"],["ٱلْمَغْفِرَةِ","l-maghfirati","ampunan"]]}]}