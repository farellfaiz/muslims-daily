{"n":105,"ayat":[{"t":"Tidakkah engkau (Muhammad) perhatikan bagaimana Tuhanmu telah bertindak terhadap pasukan bergajah?","w":[["أَلَمْ","alam","apakah tidak"],["تَرَ","tara","kamu perhatikan"],["كَيْفَ","kayfa","bagaimana"],["فَعَلَ","faʿala","berbuat/bertindak"],["رَبُّكَ","rabbuka","Tuhanmu"],["بِأَصْحَـٰبِ","bi-aṣḥābi","terhadap golongan (tentara)"],["ٱلْفِيلِ","l-fīli","gajah"]]},{"t":"Bukankah Dia telah menjadikan tipu daya mereka itu sia-sia?","w":[["أَلَمْ","alam","apakah tidak"],["يَجْعَلْ","yajʿal","Dia jadikan"],["كَيْدَهُمْ","kaydahum","tipu daya mereka"],["فِى","fī","dalam"],["تَضْلِيلٍۢ","taḍlīlin","kesesatan/sia-sia"]]},{"t":"dan Dia mengirimkan kepada mereka burung yang berbondong-bondong,","w":[["وَأَرْسَلَ","wa-arsala","dan Dia mengirimkan"],["عَلَيْهِمْ","ʿalayhim","kepada mereka"],["طَيْرًا","ṭayran","burung"],["أَبَابِيلَ","abābīla","yang berbondong-bondong"]]},{"t":"yang melempari mereka dengan batu dari tanah liat yang dibakar,","w":[["تَرْمِيهِم","tarmīhim","yang melempari mereka"],["بِحِجَارَةٍۢ","biḥijāratin","dengan batu-batu"],["مِّن","min","dari"],["سِجِّيلٍۢ","sijjīlin","tanah keras/terbakar"]]},{"t":"sehingga mereka dijadikan-Nya seperti daun-daun yang dimakan (ulat).","w":[["فَجَعَلَهُمْ","fajaʿalahum","lalu Dia menjadikan mereka"],["كَعَصْفٍۢ","kaʿaṣfin","seperti daun"],["مَّأْكُولٍۭ","makūlin","dimakan"]]}]}