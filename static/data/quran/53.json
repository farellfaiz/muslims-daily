{"n":53,"ayat":[{"t":"Demi bintang ketika terbenam,","w":[["وَٱلنَّجْمِ","wal-najmi","demi bintang"],["إِذَا","idhā","apabila"],["هَوَىٰ","hawā","terbenam"]]},{"t":"kawanmu (Muhammad) tidak sesat dan tidak (pula) keliru,","w":[["مَا","mā","tidak"],["ضَلَّ","ḍalla","sesat"],["صَاحِبُكُمْ","ṣāḥibukum","kawanmu"],["وَمَا","wamā","dan tidak"],["غَوَىٰ","ghawā","keliru/sesat"]]},{"t":"dan tidaklah yang diucapkannya itu (Alquran) menurut keinginannya.","w":[["وَمَا","wamā","dan tidak"],["يَنطِقُ","yanṭiqu","dia mengucap/berkata"],["عَنِ","ʿani","dari"],["ٱلْهَوَىٰٓ","l-hawā","hawa nafsu"]]},{"t":"Tidak lain (Alquran itu) adalah wahyu yang diwahyukan (kepadanya),","w":[["إِنْ","in","tidak lain"],["هُوَ","huwa","dia"],["إِلَّا","illā","kecuali"],["وَحْىٌۭ","waḥyun","wahyu"],["يُوحَىٰ","yūḥā","diwahyukan"]]},{"t":"yang diajarkan kepadanya oleh (Jibril) yang sangat kuat,","w":[["عَلَّمَهُۥ","ʿallamahu","mengajarkan kepadanya"],["شَدِيدُ","shadīdu","sangat"],["ٱلْقُوَىٰ","l-quwā","kuat"]]},{"t":"yang mempunyai keteguhan; maka (Jibril itu) menampakkan diri dengan rupa yang asli (rupa yang bagus dan perkasa)","w":[["ذُو","dhū","mempunyai"],["مِرَّةٍۢ","mirratin","kekuatan/kecerdasan"],["فَٱسْتَوَىٰ","fa-is'tawā","lalu dia cukup sempurna"]]},{"t":"Sedang dia berada di ufuk yang tinggi.","w":[["وَهُوَ","wahuwa","dan dia"],["بِٱلْأُفُقِ","bil-ufuqi","di ufuk"],["ٱلْأَعْلَىٰ","l-aʿlā","yang tinggi"]]},{"t":"Kemudian dia mendekat (pada Muhammad), lalu bertambah dekat,","w":[["ثُمَّ","thumma","kemudian"],["دَنَا","danā","dia mendekat"],["فَتَدَلَّىٰ","fatadallā","lalu dia turun"]]},{"t":"sehingga jaraknya (sekitar) dua busur panah atau lebih dekat (lagi).","w":[["فَكَانَ","fakāna","maka adalah dia"],["قَابَ","qāba","ukuran/jarak"],["قَوْسَيْنِ","qawsayni","dua busur panah"],["أَوْ","aw","atau"],["أَدْنَىٰ","adnā","lebih dekat"]]},{"t":"Lalu disampaikannya wahyu kepada hamba-Nya (Muhammad) apa yang telah diwahyukan Allah.","w":[["فَأَوْحَىٰٓ","fa-awḥā","maka Dia mewahyukan"],["إِلَىٰ","ilā","kepada"],["عَبْدِهِۦ","ʿabdihi","hamba-Nya"],["مَآ","mā","apa yang"],["أَوْحَىٰ","awḥā","Dia wahyukan"]]},{"t":"Hatinya tidak mendustakan apa yang telah dilihatnya.","w":[["مَا","mā","tidak"],["كَذَبَ","kadhaba","mendustakan"],["ٱلْفُؤَادُ","l-fuādu","hati itu"],["مَا","mā","apa"],["رَأَىٰٓ","raā","dia lihat"]]},{"t":"Maka apakah kamu (musyrikin Mekkah) hendak membantahnya tentang apa yang dilihatnya itu?","w":[["أَفَتُمَـٰرُونَهُۥ","afatumārūnahu","apakah maka kamu membantahnya"],["عَلَىٰ","ʿalā","atas"],["مَا","mā","apa yang"],["يَرَىٰ","yarā","dia lihat"]]},{"t":"Dan sungguh, dia (Muhammad) telah melihatnya (dalam rupanya yang asli) pada waktu yang lain,","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["رَءَاهُ","raāhu","dia telah melihatnya"],["نَزْلَةً","nazlatan","satu kali turun"],["أُخْرَىٰ","ukh'rā","yang lain"]]},{"t":"(yaitu) di Sidratilmuntahā,","w":[["عِندَ","ʿinda","di sisi"],["سِدْرَةِ","sid'rati","Sidratil"],["ٱلْمُنتَهَىٰ","l-muntahā","Muntaha"]]},{"t":"di dekatnya ada surga tempat tinggal,","w":[["عِندَهَا","ʿindahā","di sisinya"],["جَنَّةُ","jannatu","surga"],["ٱلْمَأْوَىٰٓ","l-mawā","tempat tinggal"]]},{"t":"(Muhammad melihat Jibril) ketika Sidratilmuntahā diliputi oleh sesuatu yang meliputinya,","w":[["إِذْ","idh","ketika"],["يَغْشَى","yaghshā","meliputi"],["ٱلسِّدْرَةَ","l-sid'rata","Sidratil"],["مَا","mā","apa/sesuatu"],["يَغْشَىٰ","yaghshā","yang meliputi"]]},{"t":"penglihatannya (Muhammad) tidak menyimpang dari yang dilihatnya itu dan tidak (pula) melampauinya.","w":[["مَا","mā","tidak"],["زَاغَ","zāgha","berpaling"],["ٱلْبَصَرُ","l-baṣaru","penglihatan"],["وَمَا","wamā","dan tidak"],["طَغَىٰ","ṭaghā","melampaui batas"]]},{"t":"Sungguh, dia telah melihat sebagian tanda-tanda (kebesaran) Tuhannya yang paling besar.","w":[["لَقَدْ","laqad","sesungguhnya"],["رَأَىٰ","raā","dia telah melihat"],["مِنْ","min","dari/sebagian"],["ءَايَـٰتِ","āyāti","tanda-tanda"],["رَبِّهِ","rabbihi","Tuhannya"],["ٱلْكُبْرَىٰٓ","l-kub'rā","paling besar"]]},{"t":"Maka apakah patut kamu (orang-orang musyrik) menganggap (berhala) Al-Lāta dan Al-'Uzzā,","w":[["أَفَرَءَيْتُمُ","afara-aytumu","apakah maka kamu perhatikan"],["ٱللَّـٰتَ","l-lāta","Al Lata"],["وَٱلْعُزَّىٰ","wal-ʿuzā","dan Al 'Uzza"]]},{"t":"dan Manāt, yang ketiga yang paling kemudian (sebagai anak perempuan Allah).","w":[["وَمَنَوٰةَ","wamanata","dan Manah"],["ٱلثَّالِثَةَ","l-thālithata","yang ketiga"],["ٱلْأُخْرَىٰٓ","l-ukh'rā","yang lain/hina"]]},{"t":"Apakah (pantas) untuk kamu yang laki-laki dan untuk-Nya yang perempuan?","w":[["أَلَكُمُ","alakumu","apakah bagimu"],["ٱلذَّكَرُ","l-dhakaru","laki-laki"],["وَلَهُ","walahu","dan bagi-Nya"],["ٱلْأُنثَىٰ","l-unthā","perempuan"]]},{"t":"Yang demikian itu tentulah suatu pembagian yang timpang.","w":[["تِلْكَ","til'ka","itu"],["إِذًۭا","idhan","jika demikian"],["قِسْمَةٌۭ","qis'matun","pembagian"],["ضِيزَىٰٓ","ḍīzā","tidak adil"]]},{"t":"Itu tidak lain hanyalah nama-nama yang kamu dan nenek moyangmu mengada-adakannya; Allah tidak menurunkan suatu keterangan apa pun untuk (menyembah)nya. Mereka hanya mengikuti dugaan, dan apa yang diingini oleh keinginannya. Padahal sungguh, telah datang petunjuk dari Tuhan mereka.","w":[["إِنْ","in","tidak lain"],["هِىَ","hiya","dia"],["إِلَّآ","illā","kecuali"],["أَسْمَآءٌۭ","asmāon","nama-nama"],["سَمَّيْتُمُوهَآ","sammaytumūhā","kamu menamainya"],["أَنتُمْ","antum","kamu"],["وَءَابَآؤُكُم","waābāukum","dan bapak-bapakmu"],["مَّآ","mā","tidak"],["أَنزَلَ","anzala","menurunkan"],["ٱللَّهُ","l-lahu","Allah"],["بِهَا","bihā","dengannya"],["مِن","min","dari"],["سُلْطَـٰنٍ ۚ","sul'ṭānin","kekuasaan"],["إِن","in","tidak lain"],["يَتَّبِعُونَ","yattabiʿūna","mereka mengikuti"],["إِلَّا","illā","kecuali"],["ٱلظَّنَّ","l-ẓana","sangkaan"],["وَمَا","wamā","dan apa yang"],["تَهْوَى","tahwā","menginginkan"],["ٱلْأَنفُسُ ۖ","l-anfusu","hawa nafsu"],["وَلَقَدْ","walaqad","dan sesungguhnya"],["جَآءَهُم","jāahum","telah datang kepada mereka"],["مِّن","min","dari"],["رَّبِّهِمُ","rabbihimu","Tuhan mereka"],["ٱلْهُدَىٰٓ","l-hudā","petunjuk"]]},{"t":"Atau apakah manusia akan mendapat segala yang dicita-citakannya?","w":[["أَمْ","am","ataukah/apakah"],["لِلْإِنسَـٰنِ","lil'insāni","bagi manusia"],["مَا","mā","apa yang"],["تَمَنَّىٰ","tamannā","ia inginkan"]]},{"t":"(Tidak!) Maka milik Allah lah kehidupan akhirat dan kehidupan dunia.","w":[["فَلِلَّهِ","falillahi","maka kepunyaan Allah"],["ٱلْـَٔاخِرَةُ","l-ākhiratu","kehidupan akhirat"],["وَٱلْأُولَىٰ","wal-ūlā","dan kehidupan dunia"]]},{"t":"Dan betapa banyak malaikat di langit, syafaat (pertolongan) mereka sedikit pun tidak berguna kecuali apabila Allah telah mengizinkan (dan hanya) bagi siapa yang Dia kehendaki dan Dia ridai.","w":[["۞ وَكَم","wakam","dan berapa banyak"],["مِّن","min","dari"],["مَّلَكٍۢ","malakin","malaikat"],["فِى","fī","di"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["لَا","lā","tidak"],["تُغْنِى","tugh'nī","berguna"],["شَفَـٰعَتُهُمْ","shafāʿatuhum","pertolongan mereka"],["شَيْـًٔا","shayan","sedikitpun"],["إِلَّا","illā","kecuali"],["مِنۢ","min","dari"],["بَعْدِ","baʿdi","sesudah"],["أَن","an","bahwa"],["يَأْذَنَ","yadhana","memberi izin"],["ٱللَّهُ","l-lahu","Allah"],["لِمَن","liman","bagi siapa"],["يَشَآءُ","yashāu","Dia kehendaki"],["وَيَرْضَىٰٓ","wayarḍā","dan Dia ridhai"]]},{"t":"Sesungguhnya orang-orang yang tidak beriman kepada kehidupan akhirat, sungguh mereka menamakan para malaikat dengan nama perempuan.","w":[["إِنَّ","inna","sesungguhnya"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["لَا","lā","tidak"],["يُؤْمِنُونَ","yu'minūna","beriman"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","kepada akhirat"],["لَيُسَمُّونَ","layusammūna","sungguh mereka menamakan"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","malaikat"],["تَسْمِيَةَ","tasmiyata","nama"],["ٱلْأُنثَىٰ","l-unthā","perempuan"]]},{"t":"Dan mereka tidak mempunyai ilmu tentang itu. Mereka tidak lain hanyalah mengikuti dugaan, dan sesungguhnya dugaan itu tidak berfaedah sedikit pun terhadap kebenaran.","w":[["وَمَا","wamā","dan tidak"],["لَهُم","lahum","mereka mempunyai"],["بِهِۦ","bihi","dengannya"],["مِنْ","min","dari"],["عِلْمٍ ۖ","ʿil'min","pengetahuan"],["إِن","in","tidak lain"],["يَتَّبِعُونَ","yattabiʿūna","mereka mengikuti"],["إِلَّا","illā","kecuali"],["ٱلظَّنَّ ۖ","l-ẓana","sangkaan"],["وَإِنَّ","wa-inna","dan sesungguhnya"],["ٱلظَّنَّ","l-ẓana","sankaan"],["لَا","lā","tidak"],["يُغْنِى","yugh'nī","berguna"],["مِنَ","mina","dari"],["ٱلْحَقِّ","l-ḥaqi","kebenaran"],["شَيْـًۭٔا","shayan","sedikitpun"]]},{"t":"Maka tinggalkanlah (Muhammad) orang yang berpaling dari peringatan Kami, dan dia hanya mengingini kehidupan dunia.","w":[["فَأَعْرِضْ","fa-aʿriḍ","maka berpalinglah"],["عَن","ʿan","dari"],["مَّن","man","siapa yang"],["تَوَلَّىٰ","tawallā","dia berpaling"],["عَن","ʿan","dari"],["ذِكْرِنَا","dhik'rinā","mengingat Kami"],["وَلَمْ","walam","dan tidak"],["يُرِدْ","yurid","dia menghendaki"],["إِلَّا","illā","kecuali"],["ٱلْحَيَوٰةَ","l-ḥayata","kehidupan"],["ٱلدُّنْيَا","l-dun'yā","dunia"]]},{"t":"Itulah kadar ilmu mereka. Sungguh, Tuhanmu, Dia lebih mengetahui siapa yang tersesat dari jalan-Nya dan Dia pula yang lebih mengetahui siapa yang mendapat petunjuk.","w":[["ذَٰلِكَ","dhālika","demikian itu"],["مَبْلَغُهُم","mablaghuhum","kesudahan mereka"],["مِّنَ","mina","dari"],["ٱلْعِلْمِ ۚ","l-ʿil'mi","penegtahuan"],["إِنَّ","inna","sesungguhnya"],["رَبَّكَ","rabbaka","Tuhanmu"],["هُوَ","huwa","Dia"],["أَعْلَمُ","aʿlamu","lebih mengetahui"],["بِمَن","biman","kepada siapa"],["ضَلَّ","ḍalla","dia tersesat"],["عَن","ʿan","dari"],["سَبِيلِهِۦ","sabīlihi","jalan-Nya"],["وَهُوَ","wahuwa","dan Dia"],["أَعْلَمُ","aʿlamu","lebih mengetahui"],["بِمَنِ","bimani","kepada siapa"],["ٱهْتَدَىٰ","ih'tadā","mendapat petunjuk"]]},{"t":"Dan milik Allah lah apa yang ada di langit dan apa yang ada di bumi. (Dengan demikian) Dia akan memberi balasan kepada orang-orang yang berbuat jahat sesuai dengan apa yang telah mereka kerjakan dan Dia akan memberi balasan kepada orang-orang yang berbuat baik dengan pahala yang lebih baik (surga).","w":[["وَلِلَّهِ","walillahi","dan kepunyaan Allah"],["مَا","mā","apa yang"],["فِى","fī","ada di"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["وَمَا","wamā","dan apa yang"],["فِى","fī","ada di"],["ٱلْأَرْضِ","l-arḍi","bumi"],["لِيَجْزِىَ","liyajziya","Dia akan memberi balasan"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["أَسَـٰٓـُٔوا۟","asāū","mereka berbuat jahat"],["بِمَا","bimā","terhadap apa"],["عَمِلُوا۟","ʿamilū","mereka kerjakan"],["وَيَجْزِىَ","wayajziya","dan dia akan memberi balasan"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["أَحْسَنُوا۟","aḥsanū","mereka berbuat baik"],["بِٱلْحُسْنَى","bil-ḥus'nā","denganyang lebih baik"]]},{"t":"(Yaitu) mereka yang menjauhi dosa-dosa besar dan perbuatan keji, kecuali kesalahan-kesalahan kecil. Sungguh, Tuhanmu Mahaluas ampunan-Nya. Dia mengetahui tentang kamu, sejak Dia menjadikan kamu dari tanah lalu ketika kamu masih janin dalam perut ibumu. Maka janganlah kamu menganggap dirimu suci. Dia mengetahui tentang orang yang bertakwa.","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["يَجْتَنِبُونَ","yajtanibūna","mereka menjauhi"],["كَبَـٰٓئِرَ","kabāira","besar"],["ٱلْإِثْمِ","l-ith'mi","dosa"],["وَٱلْفَوَٰحِشَ","wal-fawāḥisha","dan perbuatan keji"],["إِلَّا","illā","kecuali"],["ٱللَّمَمَ ۚ","l-lamama","teringat sepintas lalu"],["إِنَّ","inna","sesungguhnya"],["رَبَّكَ","rabbaka","Tuhanmu"],["وَٰسِعُ","wāsiʿu","Maha Luas"],["ٱلْمَغْفِرَةِ ۚ","l-maghfirati","ampunan"],["هُوَ","huwa","Dia"],["أَعْلَمُ","aʿlamu","lebih mengetahui"],["بِكُمْ","bikum","dengan/untuk kalian"],["إِذْ","idh","ketika"],["أَنشَأَكُم","ansha-akum","Dia menjadikan kamu"],["مِّنَ","mina","dari"],["ٱلْأَرْضِ","l-arḍi","bumi"],["وَإِذْ","wa-idh","dan ketika"],["أَنتُمْ","antum","kamu"],["أَجِنَّةٌۭ","ajinnatun","janin"],["فِى","fī","dalam"],["بُطُونِ","buṭūni","perut"],["أُمَّهَـٰتِكُمْ ۖ","ummahātikum","ibu-ibu kamu"],["فَلَا","falā","maka jangan"],["تُزَكُّوٓا۟","tuzakkū","kamu menganggap suci"],["أَنفُسَكُمْ ۖ","anfusakum","diri kalian sendiri"],["هُوَ","huwa","Dia"],["أَعْلَمُ","aʿlamu","lebih mengetahui"],["بِمَنِ","bimani","dengan siapa"],["ٱتَّقَىٰٓ","ittaqā","yang bertakwa"]]},{"t":"Maka tidakkah engkau melihat orang yang berpaling (dari Alquran)?","w":[["أَفَرَءَيْتَ","afara-ayta","maka apakah kamu memperhatikan"],["ٱلَّذِى","alladhī","orang yang"],["تَوَلَّىٰ","tawallā","dia berpaling"]]},{"t":"dan dia memberikan sedikit (dari apa yang dijanjikan) lalu menahan sisanya.","w":[["وَأَعْطَىٰ","wa-aʿṭā","dan Dia memberi"],["قَلِيلًۭا","qalīlan","sedikit"],["وَأَكْدَىٰٓ","wa-akdā","dan Dia menahan/tidak memberi"]]},{"t":"Apakah dia mempunyai ilmu tentang yang gaib sehingga dia dapat melihat(nya)?","w":[["أَعِندَهُۥ","aʿindahu","apakah di sisi"],["عِلْمُ","ʿil'mu","pengetahuan"],["ٱلْغَيْبِ","l-ghaybi","gaib"],["فَهُوَ","fahuwa","maka dia"],["يَرَىٰٓ","yarā","dia melihat"]]},{"t":"Ataukah belum diberitakan (kepadanya) apa yang ada dalam lembaran-lembaran (Kitab Suci yang diturunkan kepada) Musa?","w":[["أَمْ","am","ataukah/apakah"],["لَمْ","lam","belum"],["يُنَبَّأْ","yunabba","diberitakan dia"],["بِمَا","bimā","dengan apa"],["فِى","fī","dalam"],["صُحُفِ","ṣuḥufi","lembaran-lembaran"],["مُوسَىٰ","mūsā","Musa"]]},{"t":"Dan (lembaran-lembaran) Ibrahim yang selalu menyempurnakan janji?","w":[["وَإِبْرَٰهِيمَ","wa-ib'rāhīma","dan Ibrahim"],["ٱلَّذِى","alladhī","yang"],["وَفَّىٰٓ","waffā","dia sempurnakan"]]},{"t":"(yaitu) bahwa seseorang yang berdosa tidak akan memikul dosa orang lain,","w":[["أَلَّا","allā","bahwa tidak"],["تَزِرُ","taziru","kamu memikul dosa"],["وَازِرَةٌۭ","wāziratun","orang yang berdosa"],["وِزْرَ","wiz'ra","beban/dosa"],["أُخْرَىٰ","ukh'rā","orang lain"]]},{"t":"dan bahwa manusia hanya memperoleh apa yang telah diusahakannya,","w":[["وَأَن","wa-an","dan bahwa"],["لَّيْسَ","laysa","tidak"],["لِلْإِنسَـٰنِ","lil'insāni","bagi manusia"],["إِلَّا","illā","kecuali"],["مَا","mā","apa yang"],["سَعَىٰ","saʿā","ia usahakan"]]},{"t":"dan sesungguhnya usahanya itu kelak akan diperlihatkan (kepadanya),","w":[["وَأَنَّ","wa-anna","dan bahwasanya"],["سَعْيَهُۥ","saʿyahu","usahanya"],["سَوْفَ","sawfa","kelak"],["يُرَىٰ","yurā","diperlihatkan"]]},{"t":"kemudian akan diberi balasan kepadanya dengan balasan yang paling sempurna,","w":[["ثُمَّ","thumma","kemudian"],["يُجْزَىٰهُ","yuj'zāhu","diberi balasan kepadanya"],["ٱلْجَزَآءَ","l-jazāa","balasan"],["ٱلْأَوْفَىٰ","l-awfā","cukup/sempurna"]]},{"t":"dan sesungguhnya kepada Tuhanmulah kesudahannya (segala sesuatu),","w":[["وَأَنَّ","wa-anna","dan bahwasanya"],["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["ٱلْمُنتَهَىٰ","l-muntahā","akhir tujuan"]]},{"t":"dan sesungguhnya Dialah yang menjadikan orang tertawa dan menangis,","w":[["وَأَنَّهُۥ","wa-annahu","dan bahwasanya"],["هُوَ","huwa","Dia"],["أَضْحَكَ","aḍḥaka","menjadikan ia tertawa"],["وَأَبْكَىٰ","wa-abkā","dan menjadikan ia menangis"]]},{"t":"dan sesungguhnya Dialah yang mematikan dan menghidupkan,","w":[["وَأَنَّهُۥ","wa-annahu","dan bahwasanya"],["هُوَ","huwa","Dia"],["أَمَاتَ","amāta","mematikan"],["وَأَحْيَا","wa-aḥyā","dan menghidupkan"]]},{"t":"dan sesungguhnya Dialah yang menciptakan pasangan laki-laki dan perempuan,","w":[["وَأَنَّهُۥ","wa-annahu","dan bahwasanya"],["خَلَقَ","khalaqa","Dia menciptakan"],["ٱلزَّوْجَيْنِ","l-zawjayni","berpasangan"],["ٱلذَّكَرَ","l-dhakara","laki-laki"],["وَٱلْأُنثَىٰ","wal-unthā","dan perempuan"]]},{"t":"dari mani, apabila dipancarkan,","w":[["مِن","min","dari"],["نُّطْفَةٍ","nuṭ'fatin","air mani"],["إِذَا","idhā","apabila"],["تُمْنَىٰ","tum'nā","dipancarkan"]]},{"t":"dan sesungguhnya Dialah yang menetapkan penciptaan yang lain (kebangkitan setelah mati),","w":[["وَأَنَّ","wa-anna","dan bahwasanya"],["عَلَيْهِ","ʿalayhi","atasnya"],["ٱلنَّشْأَةَ","l-nashata","kejadian"],["ٱلْأُخْرَىٰ","l-ukh'rā","yang lain"]]},{"t":"dan sesungguhnya Dialah yang memberikan kekayaan dan kecukupan.","w":[["وَأَنَّهُۥ","wa-annahu","dan bahwasanya"],["هُوَ","huwa","Dia"],["أَغْنَىٰ","aghnā","memberikan kekayaan"],["وَأَقْنَىٰ","wa-aqnā","dan memberikan kecukupan"]]},{"t":"dan sesungguhnya Dialah Tuhan (yang memiliki) bintang Syi'rā,","w":[["وَأَنَّهُۥ","wa-annahu","dan bahwasanya"],["هُوَ","huwa","dia"],["رَبُّ","rabbu","Tuhan"],["ٱلشِّعْرَىٰ","l-shiʿ'rā","bintang syi'ra"]]},{"t":"dan sesungguhnya Dialah yang telah membinasakan kaum 'Ād dahulu kala,","w":[["وَأَنَّهُۥٓ","wa-annahu","dan bahwasanya"],["أَهْلَكَ","ahlaka","Dia telah membinasakan"],["عَادًا","ʿādan","kaum'Ad"],["ٱلْأُولَىٰ","l-ūlā","dahulu"]]},{"t":"dan kaum Samud, tidak seorang pun yang ditinggalkan-Nya (hidup),","w":[["وَثَمُودَا۟","wathamūdā","dan kaum Tsamud"],["فَمَآ","famā","maka tidak"],["أَبْقَىٰ","abqā","Dia tertinggal"]]},{"t":"dan (juga) kaum Nuh sebelum itu. Sungguh, mereka adalah orang-orang yang paling zalim dan paling durhaka.","w":[["وَقَوْمَ","waqawma","dan kaum"],["نُوحٍۢ","nūḥin","Nuh"],["مِّن","min","dari"],["قَبْلُ ۖ","qablu","sebelum itu"],["إِنَّهُمْ","innahum","sesungguhnya mereka"],["كَانُوا۟","kānū","adalah mereka"],["هُمْ","hum","mereka"],["أَظْلَمَ","aẓlama","lebih zalim"],["وَأَطْغَىٰ","wa-aṭghā","dan lebih durhaka"]]},{"t":"Dan prahara angin telah meruntuhkan (negeri kaum Luṭ),","w":[["وَٱلْمُؤْتَفِكَةَ","wal-mu'tafikata","dan Mu'tafikah"],["أَهْوَىٰ","ahwā","Dia hancurkan"]]},{"t":"lalu menimbuni negeri itu (sebagai azab) dengan (puing-puing) yang menimpanya.","w":[["فَغَشَّىٰهَا","faghashāhā","maka Dia menutupinya"],["مَا","mā","apa(azab)"],["غَشَّىٰ","ghashā","menutupi/menimpa"]]},{"t":"Maka terhadap nikmat Tuhanmu yang manakah yang masih kamu ragukan?","w":[["فَبِأَىِّ","fabi-ayyi","maka terhadap"],["ءَالَآءِ","ālāi","atas"],["رَبِّكَ","rabbika","Tuhanmu"],["تَتَمَارَىٰ","tatamārā","ragu"]]},{"t":"Ini (Muhammad) salah seorang pemberi peringatan di antara para pemberi peringatan yang telah terdahulu.","w":[["هَـٰذَا","hādhā","Ini"],["نَذِيرٌۭ","nadhīrun","pemberi peringatan"],["مِّنَ","mina","dari"],["ٱلنُّذُرِ","l-nudhuri","antara pemberi peringatan"],["ٱلْأُولَىٰٓ","l-ūlā","terdahulu"]]},{"t":"Yang dekat (hari Kiamat) telah makin mendekat.","w":[["أَزِفَتِ","azifati","telah dekat"],["ٱلْـَٔازِفَةُ","l-āzifatu","kiamat"]]},{"t":"Tidak ada yang akan dapat mengungkapkan (terjadinya hari itu) selain Allah.","w":[["لَيْسَ","laysa","tidak"],["لَهَا","lahā","padanya"],["مِن","min","dari"],["دُونِ","dūni","sisi"],["ٱللَّهِ","l-lahi","Allah"],["كَاشِفَةٌ","kāshifatun","menyatakan"]]},{"t":"Maka apakah kamu merasa heran terhadap pemberitaan ini?","w":[["أَفَمِنْ","afamin","maka apakah"],["هَـٰذَا","hādhā","ini"],["ٱلْحَدِيثِ","l-ḥadīthi","pemberitaan"],["تَعْجَبُونَ","taʿjabūna","kamu heran"]]},{"t":"dan kamu tertawakan dan tidak menangis,","w":[["وَتَضْحَكُونَ","wataḍḥakūna","dan kamu mentertawakan"],["وَلَا","walā","dan tidak"],["تَبْكُونَ","tabkūna","menangis"]]},{"t":"sedang kamu lengah (darinya).","w":[["وَأَنتُمْ","wa-antum","dan kalian"],["سَـٰمِدُونَ","sāmidūna","melengahkan"]]},{"t":"Maka bersujudlah kepada Allah dan sembahlah (Dia)!","w":[["فَٱسْجُدُوا۟","fa-us'judū","maka bersujudlah"],["لِلَّهِ","lillahi","kepada Allah"],["وَٱعْبُدُوا۟ ۩","wa-uʿ'budū","dan sembahlah (Dia)"]]}]}