{"n":70,"ayat":[{"t":"Seseorang bertanya tentang azab yang pasti terjadi,","w":[["سَأَلَ","sa-ala","bertanya"],["سَآئِلٌۢ","sāilun","seorang penanya"],["بِعَذَابٍۢ","biʿadhābin","dengan/tentang azab"],["وَاقِعٍۢ","wāqiʿin","jatuh/terjadi"]]},{"t":"Bagi orang-orang kafir, yang tidak seorang pun dapat menolaknya,","w":[["لِّلْكَـٰفِرِينَ","lil'kāfirīna","untuk orang-orang kafir"],["لَيْسَ","laysa","tidak"],["لَهُۥ","lahu","baginya"],["دَافِعٌۭ","dāfiʿun","menolak"]]},{"t":"(Azab) dari Allah, yang memiliki tempat-tempat naik.","w":[["مِّنَ","mina","dari"],["ٱللَّهِ","l-lahi","Allah"],["ذِى","dhī","mempunyai"],["ٱلْمَعَارِجِ","l-maʿāriji","tempat-tempat naik"]]},{"t":"Para malaikat dan Jibril naik (menghadap) kepada Tuhan, dalam sehari setara dengan lima puluh ribu tahun.","w":[["تَعْرُجُ","taʿruju","naik"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","Malaikat"],["وَٱلرُّوحُ","wal-rūḥu","dan Roh/Jibril"],["إِلَيْهِ","ilayhi","kepada-Nya"],["فِى","fī","dalam"],["يَوْمٍۢ","yawmin","sehari"],["كَانَ","kāna","adalah"],["مِقْدَارُهُۥ","miq'dāruhu","ukurannya/kadarnya"],["خَمْسِينَ","khamsīna","lima puluh"],["أَلْفَ","alfa","ribu"],["سَنَةٍۢ","sanatin","tahun"]]},{"t":"Maka bersabarlah engkau (Muhammad) dengan kesabaran yang baik.","w":[["فَٱصْبِرْ","fa-iṣ'bir","maka bersabarlah"],["صَبْرًۭا","ṣabran","kesabaran"],["جَمِيلًا","jamīlan","bagus/baik"]]},{"t":"Mereka memandang (azab) itu jauh (mustahil).","w":[["إِنَّهُمْ","innahum","sesungguhnya mereka"],["يَرَوْنَهُۥ","yarawnahu","mereka mamandangnya (azab)"],["بَعِيدًۭا","baʿīdan","jauh"]]},{"t":"Sedang Kami memandangnya dekat (pasti terjadi).","w":[["وَنَرَىٰهُ","wanarāhu","dan Kami memandangnya (azab)"],["قَرِيبًۭا","qarīban","dekat"]]},{"t":"(Ingatlah) pada hari ketika langit menjadi bagaikan cairan tembaga,","w":[["يَوْمَ","yawma","pada hari"],["تَكُونُ","takūnu","adalah"],["ٱلسَّمَآءُ","l-samāu","langit"],["كَٱلْمُهْلِ","kal-muh'li","seperti leburan perak"]]},{"t":"dan gunung-gunung bagaikan bulu (yang beterbangan),","w":[["وَتَكُونُ","watakūnu","dan adalah"],["ٱلْجِبَالُ","l-jibālu","gunung-gunung"],["كَٱلْعِهْنِ","kal-ʿih'ni","seperti bulu"]]},{"t":"dan tidak ada seorang teman karib pun menanyakan temannya,","w":[["وَلَا","walā","dan tidak"],["يَسْـَٔلُ","yasalu","menanyakan"],["حَمِيمٌ","ḥamīmun","teman akrab"],["حَمِيمًۭا","ḥamīman","teman akrab"]]},{"t":"sedang mereka saling melihat. Pada hari itu, orang yang berdosa ingin sekiranya dia dapat menebus (dirinya) dari azab dengan anak-anaknya,","w":[["يُبَصَّرُونَهُمْ ۚ","yubaṣṣarūnahum","mereka saling melihat mereka"],["يَوَدُّ","yawaddu","ingin"],["ٱلْمُجْرِمُ","l-muj'rimu","orang yang berdosa"],["لَوْ","law","sekiranya"],["يَفْتَدِى","yaftadī","ia menebus"],["مِنْ","min","dari"],["عَذَابِ","ʿadhābi","azab"],["يَوْمِئِذٍۭ","yawmi-idhin","pada hari itu"],["بِبَنِيهِ","bibanīhi","dengan anak-anaknya"]]},{"t":"dan istrinya juga saudaranya,","w":[["وَصَـٰحِبَتِهِۦ","waṣāḥibatihi","dan isterinya"],["وَأَخِيهِ","wa-akhīhi","dan saudaranya"]]},{"t":"dan keluarga yang melindunginya (di dunia),","w":[["وَفَصِيلَتِهِ","wafaṣīlatihi","dan keluarganya"],["ٱلَّتِى","allatī","yang"],["تُـْٔوِيهِ","tu'wīhi","melindunginya"]]},{"t":"dan orang-orang di bumi seluruhnya, kemudian mengharapkan (tebusan) itu dapat menyelamatkannya.","w":[["وَمَن","waman","dan orang"],["فِى","fī","di"],["ٱلْأَرْضِ","l-arḍi","bumi"],["جَمِيعًۭا","jamīʿan","seluruhnya"],["ثُمَّ","thumma","kemudian"],["يُنجِيهِ","yunjīhi","ia menyelamatkannya"]]},{"t":"Sama sekali tidak! Sungguh, neraka itu api yang bergejolak,","w":[["كَلَّآ ۖ","kallā","sekali-kali tidak"],["إِنَّهَا","innahā","sesungguhnya ia"],["لَظَىٰ","laẓā","api yang menyala-nyala"]]},{"t":"yang mengelupaskan kulit kepala.","w":[["نَزَّاعَةًۭ","nazzāʿatan","mencabut/mengelupas"],["لِّلشَّوَىٰ","lilshawā","bagi kulit kepala"]]},{"t":"Yang memanggil orang yang membelakangi dan yang berpaling (dari agama),","w":[["تَدْعُوا۟","tadʿū","ia memanggil"],["مَنْ","man","orang"],["أَدْبَرَ","adbara","dia membelakang"],["وَتَوَلَّىٰ","watawallā","dan dia berpaling"]]},{"t":"dan orang yang mengumpulkan (harta benda) lalu menyimpannya.","w":[["وَجَمَعَ","wajamaʿa","dan dia mengumpulkan"],["فَأَوْعَىٰٓ","fa-awʿā","lalu dia menyimpannya"]]},{"t":"Sungguh, manusia diciptakan bersifat suka mengeluh.","w":[["۞ إِنَّ","inna","sesungguhnya"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["خُلِقَ","khuliqa","diciptakan"],["هَلُوعًا","halūʿan","keluh-kesah/loba-kikir"]]},{"t":"Apabila dia ditimpa kesusahan dia berkeluh kesah,","w":[["إِذَا","idhā","apabila"],["مَسَّهُ","massahu","menimpanya"],["ٱلشَّرُّ","l-sharu","kejahatan/kesusahan"],["جَزُوعًۭا","jazūʿan","berkeluh-kesah"]]},{"t":"dan apabila mendapat kebaikan (harta) dia jadi kikir,","w":[["وَإِذَا","wa-idhā","dan apabila"],["مَسَّهُ","massahu","menimpanya/mendapatkan"],["ٱلْخَيْرُ","l-khayru","kebaikan"],["مَنُوعًا","manūʿan","menahan/amat kikir"]]},{"t":"kecuali orang-orang yang melaksanakan salat,","w":[["إِلَّا","illā","kecuali"],["ٱلْمُصَلِّينَ","l-muṣalīna","orang-orang yang menegakkan sholat"]]},{"t":"mereka yang tetap setia melaksanakan salatnya,","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["هُمْ","hum","mereka"],["عَلَىٰ","ʿalā","atas"],["صَلَاتِهِمْ","ṣalātihim","sholat mereka"],["دَآئِمُونَ","dāimūna","orang-orang yang menetapi"]]},{"t":"dan orang-orang yang dalam hartanya disiapkan bagian tertentu,","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["فِىٓ","fī","pada"],["أَمْوَٰلِهِمْ","amwālihim","harta mereka"],["حَقٌّۭ","ḥaqqun","hak/bagian"],["مَّعْلُومٌۭ","maʿlūmun","tertentu"]]},{"t":"bagi orang (miskin) yang meminta dan yang tidak meminta,","w":[["لِّلسَّآئِلِ","lilssāili","untuk orang yang meminta"],["وَٱلْمَحْرُومِ","wal-maḥrūmi","dan orang yang kekurangan"]]},{"t":"dan orang-orang yang mempercayai hari pembalasan,","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["يُصَدِّقُونَ","yuṣaddiqūna","membenarkan/mempercayai"],["بِيَوْمِ","biyawmi","dengan hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"dan orang-orang yang takut terhadap azab Tuhannya,","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["هُم","hum","mereka"],["مِّنْ","min","dari/terhadap"],["عَذَابِ","ʿadhābi","azab"],["رَبِّهِم","rabbihim","Tuhan mereka"],["مُّشْفِقُونَ","mush'fiqūna","orang-orang yang takut"]]},{"t":"sesungguhnya terhadap azab Tuhan mereka, tidak ada seseorang yang merasa aman (dari kedatangannya),","w":[["إِنَّ","inna","sesungguhnya"],["عَذَابَ","ʿadhāba","siksaan/azab"],["رَبِّهِمْ","rabbihim","Tuhan mereka"],["غَيْرُ","ghayru","lain/tidak"],["مَأْمُونٍۢ","mamūnin","orang yang merasa aman"]]},{"t":"dan orang-orang yang memelihara kemaluannya,","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang yang pergi"],["هُمْ","hum","mereka"],["لِفُرُوجِهِمْ","lifurūjihim","bagi kemaluan mereka"],["حَـٰفِظُونَ","ḥāfiẓūna","orang-orang yang memelihara/menjaga"]]},{"t":"kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki maka sesungguhnya mereka tidak tercela.","w":[["إِلَّا","illā","kecuali"],["عَلَىٰٓ","ʿalā","atas/terhadap"],["أَزْوَٰجِهِمْ","azwājihim","isteri-isteri mereka"],["أَوْ","aw","atau"],["مَا","mā","apa"],["مَلَكَتْ","malakat","yang dimiliki"],["أَيْمَـٰنُهُمْ","aymānuhum","tangan kanan mereka"],["فَإِنَّهُمْ","fa-innahum","maka sesungguhnya mereka"],["غَيْرُ","ghayru","bukan/tidak"],["مَلُومِينَ","malūmīna","tercela"]]},{"t":"Maka barangsiapa mencari di luar itu (seperti zina, homoseks, dan lesbian), mereka itulah orang-orang yang melampaui batas.","w":[["فَمَنِ","famani","maka barang siapa"],["ٱبْتَغَىٰ","ib'taghā","mencari"],["وَرَآءَ","warāa","belakang/selain"],["ذَٰلِكَ","dhālika","demikian/itu"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","maka mereka itu"],["هُمُ","humu","mereka"],["ٱلْعَادُونَ","l-ʿādūna","orang-orang yang melampaui batas"]]},{"t":"Dan orang-orang yang memelihara amanat dan janjinya,","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["هُمْ","hum","mereka"],["لِأَمَـٰنَـٰتِهِمْ","li-amānātihim","bagi amanat mereka"],["وَعَهْدِهِمْ","waʿahdihim","dan janji mereka"],["رَٰعُونَ","rāʿūna","orang-orang yang memelihara"]]},{"t":"dan orang-orang yang berpegang teguh pada kesaksiannya,","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["هُم","hum","mereka"],["بِشَهَـٰدَٰتِهِمْ","bishahādātihim","dengan kesaksian mereka"],["قَآئِمُونَ","qāimūna","orang-orang yang menegakkan"]]},{"t":"dan orang-orang yang memelihara salatnya.","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["هُمْ","hum","mereka"],["عَلَىٰ","ʿalā","atas"],["صَلَاتِهِمْ","ṣalātihim","sholat mereka"],["يُحَافِظُونَ","yuḥāfiẓūna","mereka memelihara/menjaga"]]},{"t":"Mereka itu dimuliakan di dalam surga.","w":[["أُو۟لَـٰٓئِكَ","ulāika","mereka itu"],["فِى","fī","dalam"],["جَنَّـٰتٍۢ","jannātin","sorga"],["مُّكْرَمُونَ","muk'ramūna","orang-orang yang dimuliakan"]]},{"t":"Maka mengapa orang-orang kafir itu datang bergegas ke hadapanmu (Muhammad),","w":[["فَمَالِ","famāli","maka mengapa"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["كَفَرُوا۟","kafarū","kafir/ingkar"],["قِبَلَكَ","qibalaka","datang ke arahmu"],["مُهْطِعِينَ","muh'ṭiʿīna","bersegera"]]},{"t":"dari kanan dan dari kiri dengan berkelompok-kelompok?","w":[["عَنِ","ʿani","dari"],["ٱلْيَمِينِ","l-yamīni","kanan"],["وَعَنِ","waʿani","dan dari"],["ٱلشِّمَالِ","l-shimāli","kiri"],["عِزِينَ","ʿizīna","berkelompok-kelompok"]]},{"t":"Apakah setiap orang dari orang-orang kafir itu ingin masuk surga yang penuh kenikmatan?","w":[["أَيَطْمَعُ","ayaṭmaʿu","apakah ingin"],["كُلُّ","kullu","setiap"],["ٱمْرِئٍۢ","im'ri-in","seseorang"],["مِّنْهُمْ","min'hum","dari mereka"],["أَن","an","akan"],["يُدْخَلَ","yud'khala","ia masuk"],["جَنَّةَ","jannata","sorga"],["نَعِيمٍۢ","naʿīmin","penuh kenikmatan"]]},{"t":"tidak mungkin! Sesungguhnya Kami menciptakan mereka dari apa yang mereka ketahui.","w":[["كَلَّآ ۖ","kallā","sekali-kali tidak"],["إِنَّا","innā","sesungguhnya Kami"],["خَلَقْنَـٰهُم","khalaqnāhum","Kami ciptakan mereka"],["مِّمَّا","mimmā","dari apa"],["يَعْلَمُونَ","yaʿlamūna","mereka ketahui"]]},{"t":"Maka Aku bersumpah demi Tuhan yang mengatur tempat-tempat terbit dan terbenamnya (matahari, bulan dan bintang), sungguh, Kami pasti mampu,","w":[["فَلَآ","falā","maka"],["أُقْسِمُ","uq'simu","Aku bersumpah"],["بِرَبِّ","birabbi","dengan Tuhan/pemelihara"],["ٱلْمَشَـٰرِقِ","l-mashāriqi","timur"],["وَٱلْمَغَـٰرِبِ","wal-maghāribi","dan barat"],["إِنَّا","innā","sesungguhnya Kami"],["لَقَـٰدِرُونَ","laqādirūna","sungguh Maha Kuasa"]]},{"t":"untuk mengganti (mereka) dengan kaum yang lebih baik dari mereka, dan Kami tidak dapat dikalahkan.","w":[["عَلَىٰٓ","ʿalā","atas"],["أَن","an","untuk"],["نُّبَدِّلَ","nubaddila","Kami mengganti"],["خَيْرًۭا","khayran","lebih baik"],["مِّنْهُمْ","min'hum","dari mereka"],["وَمَا","wamā","dan tidaklah"],["نَحْنُ","naḥnu","Kami"],["بِمَسْبُوقِينَ","bimasbūqīna","dengan dikalahkan"]]},{"t":"Maka biarkanlah mereka tenggelam dan bermain-main (dalam kesesatan) sampai mereka menjumpai hari yang diancamkan kepada mereka,","w":[["فَذَرْهُمْ","fadharhum","maka biarkan mereka"],["يَخُوضُوا۟","yakhūḍū","mereka tenggelam"],["وَيَلْعَبُوا۟","wayalʿabū","dan mereka main-main"],["حَتَّىٰ","ḥattā","sehingga"],["يُلَـٰقُوا۟","yulāqū","mereka menemui"],["يَوْمَهُمُ","yawmahumu","hari mereka"],["ٱلَّذِى","alladhī","yang"],["يُوعَدُونَ","yūʿadūna","mereka dijanjikan"]]},{"t":"(yaitu) pada hari ketika mereka keluar dari kubur dengan cepat seakan-akan mereka pergi dengan segera kepada berhala-berhala (sewaktu di dunia),","w":[["يَوْمَ","yawma","pada hari"],["يَخْرُجُونَ","yakhrujūna","mereka keluar"],["مِنَ","mina","dari"],["ٱلْأَجْدَاثِ","l-ajdāthi","kubur"],["سِرَاعًۭا","sirāʿan","dengan cepat"],["كَأَنَّهُمْ","ka-annahum","seakan-akan mereka"],["إِلَىٰ","ilā","kepada"],["نُصُبٍۢ","nuṣubin","berhala-berhala"],["يُوفِضُونَ","yūfiḍūna","mereka pergi dengan segera"]]},{"t":"pandangan mereka tertunduk ke bawah diliputi kehinaan. Itulah hari yang diancamkan kepada mereka.","w":[["خَـٰشِعَةً","khāshiʿatan","menundukkan"],["أَبْصَـٰرُهُمْ","abṣāruhum","pandangan mereka"],["تَرْهَقُهُمْ","tarhaquhum","meliputi/menimpa mereka"],["ذِلَّةٌۭ ۚ","dhillatun","kerendahan/kehinaan"],["ذَٰلِكَ","dhālika","demikian/itu"],["ٱلْيَوْمُ","l-yawmu","hari"],["ٱلَّذِى","alladhī","yang"],["كَانُوا۟","kānū","adalah mereka"],["يُوعَدُونَ","yūʿadūna","mereka diancam/dijanjikan"]]}]}