{"n":110,"ayat":[{"t":"Apabila telah datang pertolongan Allah dan kemenangan,","w":[["إِذَا","idhā","apabila"],["جَآءَ","jāa","datang"],["نَصْرُ","naṣru","pertolongan"],["ٱللَّهِ","l-lahi","Allah"],["وَٱلْفَتْحُ","wal-fatḥu","dan kemenangan"]]},{"t":"dan engkau melihat manusia berbondong-bondong masuk agama Allah.","w":[["وَرَأَيْتَ","wara-ayta","dan kamu lihat"],["ٱلنَّاسَ","l-nāsa","manusia"],["يَدْخُلُونَ","yadkhulūna","masuk"],["فِى","fī","kedalam"],["دِينِ","dīni","agama"],["ٱللَّهِ","l-lahi","Allah"],["أَفْوَاجًۭا","afwājan","berbondong-bondong"]]},{"t":"maka bertasbihlah dengan memuji Tuhanmu dan mohonlah ampunan kepada-Nya. Sungguh, Dia Maha Penerima tobat.","w":[["فَسَبِّحْ","fasabbiḥ","maka bertasbihlah"],["بِحَمْدِ","biḥamdi","dengan memuji"],["رَبِّكَ","rabbika","Tuhanmu"],["وَٱسْتَغْفِرْهُ ۚ","wa-is'taghfir'hu","dan mohonlah ampun"],["إِنَّهُۥ","innahu","sesungguhnya Dia"],["كَانَ","kāna","adalah Dia"],["تَوَّابًۢا","tawwāban","Maha Penerima Taubat"]]}]}