{"n":89,"ayat":[{"t":"Demi fajar,","w":[["وَٱلْفَجْرِ","wal-fajri","demi fajar"]]},{"t":"demi malam yang sepuluh,","w":[["وَلَيَالٍ","walayālin","dan malam-malam"],["عَشْرٍۢ","ʿashrin","sepuluh"]]},{"t":"demi yang genap dan yang ganjil,","w":[["وَٱلشَّفْعِ","wal-shafʿi","dan yang genap"],["وَٱلْوَتْرِ","wal-watri","dan yang ganjil"]]},{"t":"demi malam apabila berlalu.","w":[["وَٱلَّيْلِ","wa-al-layli","dan malam"],["إِذَا","idhā","apabila"],["يَسْرِ","yasri","berlalu"]]},{"t":"Adakah pada yang demikian itu terdapat sumpah (yang dapat diterima) bagi orang-orang yang berakal?","w":[["هَلْ","hal","apakah/bukankah"],["فِى","fī","pada"],["ذَٰلِكَ","dhālika","itu/yang demikian"],["قَسَمٌۭ","qasamun","sumpah"],["لِّذِى","lidhī","bagi memiliki"],["حِجْرٍ","ḥij'rin","akal"]]},{"t":"Tidakkah engkau (Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) 'Ād?","w":[["أَلَمْ","alam","tidakkah"],["تَرَ","tara","lihat/perhatikan"],["كَيْفَ","kayfa","bagaimana"],["فَعَلَ","faʿala","berbuat"],["رَبُّكَ","rabbuka","Tuhanmu"],["بِعَادٍ","biʿādin","terhadap kaum 'Ad"]]},{"t":"(yaitu) penduduk Iram (ibukota kaum 'Ād) yang mempunyai bangunan-bangunan yang tinggi,","w":[["إِرَمَ","irama","kaum Iram"],["ذَاتِ","dhāti","memiliki"],["ٱلْعِمَادِ","l-ʿimādi","tiang/bangunan tinggi"]]},{"t":"yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,","w":[["ٱلَّتِى","allatī","yang"],["لَمْ","lam","tidak/belum"],["يُخْلَقْ","yukh'laq","diciptakan/dibangun"],["مِثْلُهَا","mith'luhā","seperti itu/serupa itu"],["فِى","fī","pada"],["ٱلْبِلَـٰدِ","l-bilādi","negeri"]]},{"t":"dan (terhadap) kaum Samud yang memotong batu-batu besar di lembah,","w":[["وَثَمُودَ","wathamūda","dan Samud"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["جَابُوا۟","jābū","(mereka) memotong"],["ٱلصَّخْرَ","l-ṣakhra","batu-batu besar"],["بِٱلْوَادِ","bil-wādi","di lembah"]]},{"t":"dan (terhadap) Fir'aun yang mempunyai pasak-pasak (bangunan yang besar),","w":[["وَفِرْعَوْنَ","wafir'ʿawna","dan Fir'aun"],["ذِى","dhī","memiliki"],["ٱلْأَوْتَادِ","l-awtādi","pasak-pasak (bala tentara)"]]},{"t":"yang berbuat sewenang-wenang dalam negeri,","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["طَغَوْا۟","ṭaghaw","(mereka) melampui batas"],["فِى","fī","pada"],["ٱلْبِلَـٰدِ","l-bilādi","negeri-negeri itu"]]},{"t":"lalu mereka banyak berbuat kerusakan dalam negeri itu,","w":[["فَأَكْثَرُوا۟","fa-aktharū","lalu mereka banyak berbuat"],["فِيهَا","fīhā","didalamnya"],["ٱلْفَسَادَ","l-fasāda","kerusakan"]]},{"t":"karena itu Tuhanmu menimpakan cemeti azab kepada mereka,","w":[["فَصَبَّ","faṣabba","maka menimpakan"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["رَبُّكَ","rabbuka","Tuhanmu"],["سَوْطَ","sawṭa","cemeti/cambuk"],["عَذَابٍ","ʿadhābin","azab"]]},{"t":"sungguh, Tuhanmu benar-benar mengawasi.","w":[["إِنَّ","inna","sesungguhnya"],["رَبَّكَ","rabbaka","Tuhanmu"],["لَبِٱلْمِرْصَادِ","labil-mir'ṣādi","benar-benar mengawasi"]]},{"t":"Adapun manusia, apabila Tuhan mengujinya lalu memuliakannya dan memberinya kesenangan, maka dia berkata, \"Tuhanku telah memuliakanku.\"","w":[["فَأَمَّا","fa-ammā","maka adapun"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["إِذَا","idhā","apabila"],["مَا","mā","apa"],["ٱبْتَلَىٰهُ","ib'talāhu","mengujinya"],["رَبُّهُۥ","rabbuhu","Tuhannya"],["فَأَكْرَمَهُۥ","fa-akramahu","lalu Dia memuliakannya"],["وَنَعَّمَهُۥ","wanaʿʿamahu","dan Dia memberikan nikmat padanya"],["فَيَقُولُ","fayaqūlu","maka ia akan berkata"],["رَبِّىٓ","rabbī","Tuhanku"],["أَكْرَمَنِ","akramani","Dia telah memuliakanku"]]},{"t":"Namun apabila Tuhan mengujinya lalu membatasi rezekinya, maka dia berkata, \"Tuhanku telah menghinaku.\"","w":[["وَأَمَّآ","wa-ammā","dan adapun/tetapi"],["إِذَا","idhā","apabila"],["مَا","mā","apa"],["ٱبْتَلَىٰهُ","ib'talāhu","mengujinya"],["فَقَدَرَ","faqadara","lalu Dia menentukan/menyempitkan"],["عَلَيْهِ","ʿalayhi","atasnya"],["رِزْقَهُۥ","riz'qahu","rizkinya"],["فَيَقُولُ","fayaqūlu","lalu dia akan berkata"],["رَبِّىٓ","rabbī","Tuhanku"],["أَهَـٰنَنِ","ahānani","Dia menghinaku"]]},{"t":"Sekali-kali tidak! Bahkan kamu tidak memuliakan anak yatim,","w":[["كَلَّا ۖ","kallā","sekali-kali tidak"],["بَل","bal","tetapi/bahkan"],["لَّا","lā","tidak"],["تُكْرِمُونَ","tuk'rimūna","kamu memuliakan"],["ٱلْيَتِيمَ","l-yatīma","anak yatim"]]},{"t":"dan kamu tidak saling mengajak memberi makan orang miskin,","w":[["وَلَا","walā","dan tidak"],["تَحَـٰٓضُّونَ","taḥāḍḍūna","saling menganjurkan"],["عَلَىٰ","ʿalā","atas"],["طَعَامِ","ṭaʿāmi","memberi makan"],["ٱلْمِسْكِينِ","l-mis'kīni","orang miskin"]]},{"t":"sedangkan kamu memakan harta warisan dengan cara mencampurbaurkan (yang halal dan yang haram),","w":[["وَتَأْكُلُونَ","watakulūna","dan kamu memakan"],["ٱلتُّرَاثَ","l-turātha","harta warisan"],["أَكْلًۭا","aklan","dengan makan"],["لَّمًّۭا","lamman","loba"]]},{"t":"dan kamu mencintai harta dengan kecintaan yang berlebihan.","w":[["وَتُحِبُّونَ","watuḥibbūna","dan kamu mencintai"],["ٱلْمَالَ","l-māla","harta"],["حُبًّۭا","ḥubban","cinta"],["جَمًّۭا","jamman","berlebihan"]]},{"t":"Sekali-kali tidak! Apabila bumi diguncangkan berturut-turut (berbenturan),","w":[["كَلَّآ","kallā","sekali-kali tidak"],["إِذَا","idhā","apabila"],["دُكَّتِ","dukkati","digoncangkan/dihancurkan"],["ٱلْأَرْضُ","l-arḍu","bumi"],["دَكًّۭا","dakkan","goncangan"],["دَكًّۭا","dakkan","goncangan"]]},{"t":"dan datanglah Tuhanmu; dan malaikat berbaris-baris,","w":[["وَجَآءَ","wajāa","dan datang"],["رَبُّكَ","rabbuka","Tuhanmu"],["وَٱلْمَلَكُ","wal-malaku","dan malaikat"],["صَفًّۭا","ṣaffan","berbaris"],["صَفًّۭا","ṣaffan","baris"]]},{"t":"dan pada hari itu diperlihatkan neraka Jahanam; pada hari itu sadarlah manusia, tetapi tidak berguna lagi baginya kesadaran itu.","w":[["وَجِا۟ىٓءَ","wajīa","dan didatangkan/diperlihatkan"],["يَوْمَئِذٍۭ","yawma-idhin","pada hari itu"],["بِجَهَنَّمَ ۚ","bijahannama","neraka Jahanam"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["يَتَذَكَّرُ","yatadhakkaru","akan ingat"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["وَأَنَّىٰ","wa-annā","dan bagaimana"],["لَهُ","lahu","baginya"],["ٱلذِّكْرَىٰ","l-dhik'rā","ingat/mengingat"]]},{"t":"Dia berkata, \"Alangkah baiknya sekiranya dahulu aku mengerjakan (kebajikan) untuk hidupku ini.\"","w":[["يَقُولُ","yaqūlu","dia berkata"],["يَـٰلَيْتَنِى","yālaytanī","alangkah baiknya aku dulu"],["قَدَّمْتُ","qaddamtu","aku dahulukan/kerjakan"],["لِحَيَاتِى","liḥayātī","untuk hidupku"]]},{"t":"Maka pada hari itu tidak ada seorang pun yang mengazab seperti azab-Nya (yang adil),","w":[["فَيَوْمَئِذٍۢ","fayawma-idhin","maka pada hari itu"],["لَّا","lā","tidak"],["يُعَذِّبُ","yuʿadhibu","menyiksa"],["عَذَابَهُۥٓ","ʿadhābahu","siksa-Nya"],["أَحَدٌۭ","aḥadun","seorang/satu"]]},{"t":"dan tidak ada seorang pun yang mengikat seperti ikatan-Nya.","w":[["وَلَا","walā","dan tidak"],["يُوثِقُ","yūthiqu","mengikat"],["وَثَاقَهُۥٓ","wathāqahu","ikatan-Nya"],["أَحَدٌۭ","aḥadun","seorang/satu"]]},{"t":"Wahai jiwa yang tenang!","w":[["يَـٰٓأَيَّتُهَا","yāayyatuhā","hai"],["ٱلنَّفْسُ","l-nafsu","jiwa/diri"],["ٱلْمُطْمَئِنَّةُ","l-muṭ'ma-inatu","tenang"]]},{"t":"Kembalilah kepada Tuhanmu dengan hati yang rida dan diridai-Nya.","w":[["ٱرْجِعِىٓ","ir'jiʿī","kembalilah"],["إِلَىٰ","ilā","kepada"],["رَبِّكِ","rabbiki","Tuhanmu"],["رَاضِيَةًۭ","rāḍiyatan","rida/puas"],["مَّرْضِيَّةًۭ","marḍiyyatan","diridhoi"]]},{"t":"Maka masuklah ke dalam golongan hamba-hamba-Ku,","w":[["فَٱدْخُلِى","fa-ud'khulī","maka masuklah"],["فِى","fī","dalam"],["عِبَـٰدِى","ʿibādī","hamba-Ku"]]},{"t":"dan masuklah ke dalam surga-Ku.","w":[["وَٱدْخُلِى","wa-ud'khulī","dan masuklah"],["جَنَّتِى","jannatī","surga-Ku"]]}]}