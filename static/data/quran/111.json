{"n":111,"ayat":[{"t":"Binasalah kedua tangan Abu Lahab dan benar-benar binasa dia!","w":[["تَبَّتْ","tabbat","binasalah"],["يَدَآ","yadā","kedua tangan"],["أَبِى","abī","Abu"],["لَهَبٍۢ","lahabin","Lahab"],["وَتَبَّ","watabba","sebenar-benar binasa"]]},{"t":"Tidaklah berguna baginya hartanya dan apa yang dia usahakan.","w":[["مَآ","mā","tidak"],["أَغْنَىٰ","aghnā","berguna"],["عَنْهُ","ʿanhu","dari padanya/kepadanya"],["مَالُهُۥ","māluhu","hartanya"],["وَمَا","wamā","dan apa"],["كَسَبَ","kasaba","yang ia usahakan"]]},{"t":"Kelak dia akan masuk ke dalam api yang bergejolak (neraka).","w":[["سَيَصْلَىٰ","sayaṣlā","kelak ia akan masuk"],["نَارًۭا","nāran","api"],["ذَاتَ","dhāta","mempunyai"],["لَهَبٍۢ","lahabin","begejolak"]]},{"t":"Dan (begitu pula) istrinya, pembawa kayu bakar (penyebar fitnah).","w":[["وَٱمْرَأَتُهُۥ","wa-im'ra-atuhu","dan istrinya"],["حَمَّالَةَ","ḥammālata","pembawa"],["ٱلْحَطَبِ","l-ḥaṭabi","kayu bakar"]]},{"t":"Di lehernya ada tali dari sabut yang dipintal.","w":[["فِى","fī","pada"],["جِيدِهَا","jīdihā","lehernya"],["حَبْلٌۭ","ḥablun","tali"],["مِّن","min","dari"],["مَّسَدٍۭ","masadin","sabut"]]}]}