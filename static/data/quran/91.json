{"n":91,"ayat":[{"t":"Demi matahari dan sinarnya pada pagi hari,","w":[["وَٱلشَّمْسِ","wal-shamsi","demi matahari"],["وَضُحَىٰهَا","waḍuḥāhā","dan cahayanya pagi hari"]]},{"t":"demi bulan apabila mengiringinya,","w":[["وَٱلْقَمَرِ","wal-qamari","dan bulan"],["إِذَا","idhā","apabila"],["تَلَىٰهَا","talāhā","mengiringinya"]]},{"t":"demi siang apabila menampakkannya,","w":[["وَٱلنَّهَارِ","wal-nahāri","dan siang"],["إِذَا","idhā","apabila"],["جَلَّىٰهَا","jallāhā","menampakkannya"]]},{"t":"demi malam apabila menutupinya (gelap gulita),","w":[["وَٱلَّيْلِ","wa-al-layli","dan malam"],["إِذَا","idhā","apabila"],["يَغْشَىٰهَا","yaghshāhā","menutupinya"]]},{"t":"demi langit serta perancangannya (yang menakjubkan),","w":[["وَٱلسَّمَآءِ","wal-samāi","dan langit"],["وَمَا","wamā","dan apa"],["بَنَىٰهَا","banāhā","pembinaannya"]]},{"t":"demi bumi serta penghamparannya,","w":[["وَٱلْأَرْضِ","wal-arḍi","dan bumi"],["وَمَا","wamā","dan apa"],["طَحَىٰهَا","ṭaḥāhā","penghamparannya"]]},{"t":"demi jiwa serta penyempurnaan (ciptaan)nya,","w":[["وَنَفْسٍۢ","wanafsin","dan manusia/jiwa"],["وَمَا","wamā","dan apa"],["سَوَّىٰهَا","sawwāhā","penyempurnaanya"]]},{"t":"maka Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,","w":[["فَأَلْهَمَهَا","fa-alhamahā","maka Dia mengilhamkan padanya"],["فُجُورَهَا","fujūrahā","kedurhakaanya"],["وَتَقْوَىٰهَا","wataqwāhā","dan ketaqwaannya"]]},{"t":"sungguh beruntung orang yang menyucikannya (jiwa itu),","w":[["قَدْ","qad","sesungguhnya"],["أَفْلَحَ","aflaḥa","beruntung"],["مَن","man","siapa/orang"],["زَكَّىٰهَا","zakkāhā","mensucikannya"]]},{"t":"dan sungguh rugi orang yang mengotorinya.","w":[["وَقَدْ","waqad","dan sesungguhnya"],["خَابَ","khāba","celaka/rugi"],["مَن","man","orang"],["دَسَّىٰهَا","dassāhā","mengotorinya"]]},{"t":"(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas (zalim),","w":[["كَذَّبَتْ","kadhabat","telah mendustakan"],["ثَمُودُ","thamūdu","Samud"],["بِطَغْوَىٰهَآ","biṭaghwāhā","dan melampui batas"]]},{"t":"ketika bangkit orang yang paling celaka di antara mereka,","w":[["إِذِ","idhi","ketika"],["ٱنۢبَعَثَ","inbaʿatha","bangkit"],["أَشْقَىٰهَا","ashqāhā","orang yang lebih celaka diantaranya"]]},{"t":"lalu Rasul Allah (Saleh) berkata kepada mereka, \"(Biarkanlah) unta betina dari Allah ini dengan minumannya.\"","w":[["فَقَالَ","faqāla","dan berkata"],["لَهُمْ","lahum","kepada mereka"],["رَسُولُ","rasūlu","rasul"],["ٱللَّهِ","l-lahi","Allah"],["نَاقَةَ","nāqata","unta betina"],["ٱللَّهِ","l-lahi","Allah"],["وَسُقْيَـٰهَا","wasuq'yāhā","dan minumannya"]]},{"t":"Namun mereka mendustakannya dan menyembelihnya, karena itu Tuhan membinasakan mereka karena dosanya, lalu diratakan-Nya (dengan tanah).","w":[["فَكَذَّبُوهُ","fakadhabūhu","dan mendustakan"],["فَعَقَرُوهَا","faʿaqarūhā","maka mereka melukai/menyembelih"],["فَدَمْدَمَ","fadamdama","maka menurunkan azab/membinasakan"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["رَبُّهُم","rabbuhum","Tuhan mereka"],["بِذَنۢبِهِمْ","bidhanbihim","dengan dosa-dosa mereka"],["فَسَوَّىٰهَا","fasawwāhā","dan Dia meratakannya"]]},{"t":"Dan Dia tidak takut terhadap akibatnya.","w":[["وَلَا","walā","dan tidak"],["يَخَافُ","yakhāfu","takut"],["عُقْبَـٰهَا","ʿuq'bāhā","akibatnya"]]}]}