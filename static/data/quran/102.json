{"n":102,"ayat":[{"t":"Bermegah-megahan telah melalaikan kamu,","w":[["أَلْهَىٰكُمُ","alhākumu","telah melalaikan kamu"],["ٱلتَّكَاثُرُ","l-takāthuru","berbanyak-banyak/bermegah-megah"]]},{"t":"sampai kamu masuk ke dalam kubur.","w":[["حَتَّىٰ","ḥattā","hingga"],["زُرْتُمُ","zur'tumu","kamu melewati/masuk"],["ٱلْمَقَابِرَ","l-maqābira","kuburan-kuburan"]]},{"t":"Sekali-kali tidak! Kelak kamu akan mengetahui (akibat perbuatanmu itu),","w":[["كَلَّا","kallā","sekali-kali tidak"],["سَوْفَ","sawfa","kelak"],["تَعْلَمُونَ","taʿlamūna","(kalian) mengetahui"]]},{"t":"kemudian sekali-kali tidak! Kelak kamu akan mengetahui.","w":[["ثُمَّ","thumma","kemudian"],["كَلَّا","kallā","sekali-kali tidak"],["سَوْفَ","sawfa","kelak"],["تَعْلَمُونَ","taʿlamūna","(kalian) mengetahui"]]},{"t":"Sekali-kali tidak! Sekiranya kamu mengetahui dengan pasti,","w":[["كَلَّا","kallā","sekali-kali tidak"],["لَوْ","law","jika"],["تَعْلَمُونَ","taʿlamūna","(kalian) mengetahui"],["عِلْمَ","ʿil'ma","pengetahuan"],["ٱلْيَقِينِ","l-yaqīni","pasti/yakin"]]},{"t":"niscaya kamu benar-benar akan melihat neraka Jahim,","w":[["لَتَرَوُنَّ","latarawunna","sungguh kamu akan melihat"],["ٱلْجَحِيمَ","l-jaḥīma","neraka Jahim"]]},{"t":"kemudian kamu benar-benar akan melihatnya dengan mata kepala sendiri,","w":[["ثُمَّ","thumma","kemudian"],["لَتَرَوُنَّهَا","latarawunnahā","sungguh kamu akan melihatnya"],["عَيْنَ","ʿayna","mata/penglihatan"],["ٱلْيَقِينِ","l-yaqīni","pasti/yakin"]]},{"t":"kemudian kamu benar-benar akan ditanya pada hari itu tentang kenikmatan (yang megah di dunia itu).","w":[["ثُمَّ","thumma","kemudian"],["لَتُسْـَٔلُنَّ","latus'alunna","sungguh kamu akan ditanya"],["يَوْمَئِذٍ","yawma-idhin","pada hari itu"],["عَنِ","ʿani","dari/tetang"],["ٱلنَّعِيمِ","l-naʿīmi","kenikmatan"]]}]}