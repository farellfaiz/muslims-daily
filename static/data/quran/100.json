{"n":100,"ayat":[{"t":"Demi kuda perang yang berlari kencang terengah-engah,","w":[["وَٱلْعَـٰدِيَـٰتِ","wal-ʿādiyāti","demi yang berlari kencang"],["ضَبْحًۭا","ḍabḥan","terengah-engah"]]},{"t":"dan kuda yang memercikkan bunga api (dengan pukulan kuku kakinya),","w":[["فَٱلْمُورِيَـٰتِ","fal-mūriyāti","lalu yang memercikkan/terbitkan"],["قَدْحًۭا","qadḥan","api"]]},{"t":"dan kuda yang menyerang (dengan tiba-tiba) pada waktu pagi,","w":[["فَٱلْمُغِيرَٰتِ","fal-mughīrāti","lalu yang menyerang"],["صُبْحًۭا","ṣub'ḥan","diwaktu subuh/pagi"]]},{"t":"sehingga menerbangkan debu,","w":[["فَأَثَرْنَ","fa-atharna","lalu ia menerbangkan"],["بِهِۦ","bihi","dengannya/karenanya"],["نَقْعًۭا","naqʿan","debu"]]},{"t":"lalu menyerbu ke tengah-tengah kumpulan musuh,","w":[["فَوَسَطْنَ","fawasaṭna","maka ia menyerbu ketengah"],["بِهِۦ","bihi","dengannya"],["جَمْعًا","jamʿan","kumpulan"]]},{"t":"sungguh, manusia itu sangat ingkar, (tidak bersyukur) kepada Tuhannya,","w":[["إِنَّ","inna","sungguh"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["لِرَبِّهِۦ","lirabbihi","kepada Tuhannya"],["لَكَنُودٌۭ","lakanūdun","sangat ingkar/tidak berterima kasih"]]},{"t":"dan sesungguhnya dia (manusia) menyaksikan (mengakui) keingkarannya,","w":[["وَإِنَّهُۥ","wa-innahu","dan sesungguhnya ia"],["عَلَىٰ","ʿalā","atas"],["ذَٰلِكَ","dhālika","yang demikian/itu"],["لَشَهِيدٌۭ","lashahīdun","benar-benar menyaksikan"]]},{"t":"dan sesungguhnya cintanya kepada harta benar-benar berlebihan.","w":[["وَإِنَّهُۥ","wa-innahu","dan sesungguhnya dia"],["لِحُبِّ","liḥubbi","benar-benar cinta"],["ٱلْخَيْرِ","l-khayri","kebaikan (harta)"],["لَشَدِيدٌ","lashadīdun","sungguh sangat"]]},{"t":"Maka tidakkah dia mengetahui apabila apa yang di dalam kubur dikeluarkan,","w":[["۞ أَفَلَا","afalā","maka apakah tidak"],["يَعْلَمُ","yaʿlamu","dia mengetahui"],["إِذَا","idhā","apabila"],["بُعْثِرَ","buʿ'thira","dibangkitkan"],["مَا","mā","apa"],["فِى","fī","dalam"],["ٱلْقُبُورِ","l-qubūri","kubur"]]},{"t":"dan apa yang tersimpan di dalam dada dikeluarkan?","w":[["وَحُصِّلَ","waḥuṣṣila","dan dilahirkan"],["مَا","mā","apa"],["فِى","fī","dalam"],["ٱلصُّدُورِ","l-ṣudūri","dada"]]},{"t":"sungguh, Tuhan mereka pada hari itu Mahateliti terhadap keadaan mereka.","w":[["إِنَّ","inna","sesungguhnya"],["رَبَّهُم","rabbahum","Tuhan mereka"],["بِهِمْ","bihim","pada mereka"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لَّخَبِيرٌۢ","lakhabīrun","benar-benar Maha Mengetahui"]]}]}