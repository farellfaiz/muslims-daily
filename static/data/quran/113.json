{"n":113,"ayat":[{"t":"Katakanlah, \"Aku berlindung kepada Tuhan yang menguasai subuh (fajar),","w":[["قُلْ","qul","katakanlah"],["أَعُوذُ","aʿūdhu","aku berlindung"],["بِرَبِّ","birabbi","Tuhan/Pemelihara"],["ٱلْفَلَقِ","l-falaqi","subuh"]]},{"t":"dari kejahatan (makhluk yang) Dia ciptakan,","w":[["مِن","min","dari"],["شَرِّ","sharri","kejahatan"],["مَا","mā","apa"],["خَلَقَ","khalaqa","Dia ciptakan"]]},{"t":"dan dari kejahatan malam apabila telah gelap gulita,","w":[["وَمِن","wamin","dan dari"],["شَرِّ","sharri","kejahatan"],["غَاسِقٍ","ghāsiqin","malam yang gelap"],["إِذَا","idhā","apabila"],["وَقَبَ","waqaba","telah gelap/kelam"]]},{"t":"dan dari kejahatan (perempuan-perempuan) penyihir yang meniup pada buhul-buhul (talinya),","w":[["وَمِن","wamin","dan dari"],["شَرِّ","sharri","kejahatan"],["ٱلنَّفَّـٰثَـٰتِ","l-nafāthāti","orang yang meniup-niup"],["فِى","fī","dalam"],["ٱلْعُقَدِ","l-ʿuqadi","ikatan/simpul"]]},{"t":"dan dari kejahatan orang yang dengki apabila dia dengki.\"","w":[["وَمِن","wamin","dan dari"],["شَرِّ","sharri","kejahatan"],["حَاسِدٍ","ḥāsidin","orang yang dengki"],["إِذَا","idhā","apabila"],["حَسَدَ","ḥasada","ia dengki"]]}]}