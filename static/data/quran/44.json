{"n":44,"ayat":[{"t":"Ḥā Mīm.","w":[["حمٓ","hha-meem","Haa Miim."]]},{"t":"Demi Kitab (Alquran) yang jelas,","w":[["وَٱلْكِتَـٰبِ","wal-kitābi","demi kitab"],["ٱلْمُبِينِ","l-mubīni","yang jelas"]]},{"t":"Sesungguhnya Kami menurunkannya pada malam yang diberkahi. Sungguh, Kamilah yang memberi peringatan.","w":[["إِنَّآ","innā","sesungguhnya Kami"],["أَنزَلْنَـٰهُ","anzalnāhu","Kami menurunkannya"],["فِى","fī","pada"],["لَيْلَةٍۢ","laylatin","malam hari"],["مُّبَـٰرَكَةٍ ۚ","mubārakatin","yang diberkati"],["إِنَّا","innā","sesungguhnya Kami"],["كُنَّا","kunnā","adalah Kami"],["مُنذِرِينَ","mundhirīna","Pemberi peringatan"]]},{"t":"Pada (malam itu) dijelaskan segala urusan yang penuh hikmah,","w":[["فِيهَا","fīhā","didalamnya"],["يُفْرَقُ","yuf'raqu","dijelaskan"],["كُلُّ","kullu","segala"],["أَمْرٍ","amrin","perkara/urusan"],["حَكِيمٍ","ḥakīmin","hikmah/bijaksana"]]},{"t":"(yaitu) urusan dari sisi Kami. Sungguh, Kamilah yang mengutus rasul-rasul,","w":[["أَمْرًۭا","amran","perintah/urusan"],["مِّنْ","min","dari"],["عِندِنَآ ۚ","ʿindinā","sisi Kami"],["إِنَّا","innā","sesungguhnya Kami"],["كُنَّا","kunnā","adalah Kami"],["مُرْسِلِينَ","mur'silīna","yang mengutus"]]},{"t":"sebagai rahmat dari Tuhanmu. Sungguh, Dia Maha Mendengar, Maha Mengetahui,","w":[["رَحْمَةًۭ","raḥmatan","rahmat"],["مِّن","min","dari"],["رَّبِّكَ ۚ","rabbika","Tuhanmu"],["إِنَّهُۥ","innahu","sesungguhnya"],["هُوَ","huwa","Dia"],["ٱلسَّمِيعُ","l-samīʿu","Maha Mendengar"],["ٱلْعَلِيمُ","l-ʿalīmu","Maha Mengetahui"]]},{"t":"Tuhan (yang memelihara) langit dan bumi dan apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini.","w":[["رَبِّ","rabbi","Tuhan"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["وَٱلْأَرْضِ","wal-arḍi","dan bumi"],["وَمَا","wamā","dan apa"],["بَيْنَهُمَآ ۖ","baynahumā","yang ada di antara keduanya"],["إِن","in","jika"],["كُنتُم","kuntum","kalian adalah"],["مُّوقِنِينَ","mūqinīna","orang yang meyakini"]]},{"t":"Tidak ada tuhan selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu.","w":[["لَآ","lā","tidak ada"],["إِلَـٰهَ","ilāha","Tuhan"],["إِلَّا","illā","kecuali"],["هُوَ","huwa","Dia"],["يُحْىِۦ","yuḥ'yī","Dia menghidupkan"],["وَيُمِيتُ ۖ","wayumītu","dan Dia mematikan"],["رَبُّكُمْ","rabbukum","Tuhan kalian"],["وَرَبُّ","warabbu","dan Tuhan"],["ءَابَآئِكُمُ","ābāikumu","bapak-bapak kamu"],["ٱلْأَوَّلِينَ","l-awalīna","terdahulu"]]},{"t":"Tetapi mereka dalam keraguan, mereka bermain-main.","w":[["بَلْ","bal","tetapi"],["هُمْ","hum","mereka"],["فِى","fī","dalam"],["شَكٍّۢ","shakkin","keragu-raguan"],["يَلْعَبُونَ","yalʿabūna","mereka bermain-main"]]},{"t":"Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,","w":[["فَٱرْتَقِبْ","fa-ir'taqib","maka tunggulah"],["يَوْمَ","yawma","hari"],["تَأْتِى","tatī","datang/membawa"],["ٱلسَّمَآءُ","l-samāu","langit"],["بِدُخَانٍۢ","bidukhānin","dengan asap/kabut"],["مُّبِينٍۢ","mubīnin","nyata"]]},{"t":"yang meliputi manusia. Inilah azab yang pedih.","w":[["يَغْشَى","yaghshā","menutupi"],["ٱلنَّاسَ ۖ","l-nāsa","manusia"],["هَـٰذَا","hādhā","ini"],["عَذَابٌ","ʿadhābun","azab"],["أَلِيمٌۭ","alīmun","yang pedih"]]},{"t":"(Mereka berdoa), \"Ya Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\"","w":[["رَّبَّنَا","rabbanā","ya Tuhan kami"],["ٱكْشِفْ","ik'shif","hilangkanlah"],["عَنَّا","ʿannā","dari kami"],["ٱلْعَذَابَ","l-ʿadhāba","azab"],["إِنَّا","innā","sesungguhnya kami"],["مُؤْمِنُونَ","mu'minūna","orang-orang yang beriman"]]},{"t":"Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,","w":[["أَنَّىٰ","annā","bagaimana"],["لَهُمُ","lahumu","bagi mereka"],["ٱلذِّكْرَىٰ","l-dhik'rā","peringatan"],["وَقَدْ","waqad","dan sungguh"],["جَآءَهُمْ","jāahum","telah datang kepada mereka"],["رَسُولٌۭ","rasūlun","seorang rasul"],["مُّبِينٌۭ","mubīnun","nyata/jelas"]]},{"t":"kemudian mereka berpaling darinya dan berkata, \"Dia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\"","w":[["ثُمَّ","thumma","kemudian"],["تَوَلَّوْا۟","tawallaw","mereka berpaling"],["عَنْهُ","ʿanhu","dari padanya"],["وَقَالُوا۟","waqālū","dan mereka berkata"],["مُعَلَّمٌۭ","muʿallamun","seorang yang diajar"],["مَّجْنُونٌ","majnūnun","seorang gila"]]},{"t":"Sungguh, (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar).","w":[["إِنَّا","innā","sesungguhnya Kami"],["كَاشِفُوا۟","kāshifū","menghilangkan"],["ٱلْعَذَابِ","l-ʿadhābi","azab"],["قَلِيلًا ۚ","qalīlan","sedikit"],["إِنَّكُمْ","innakum","sesungguhnya kalian"],["عَآئِدُونَ","ʿāidūna","orang-orang yang kembali"]]},{"t":"(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras. Kami pasti memberi balasan.","w":[["يَوْمَ","yawma","pada hari"],["نَبْطِشُ","nabṭishu","Kami menghantam/menyerang"],["ٱلْبَطْشَةَ","l-baṭshata","hantaman/serangan"],["ٱلْكُبْرَىٰٓ","l-kub'rā","yang keras"],["إِنَّا","innā","sesungguhnya Kami"],["مُنتَقِمُونَ","muntaqimūna","pemberi siksaan"]]},{"t":"Dan sungguh, sebelum mereka, Kami benar-benar telah menguji kaum Fir'aun dan telah datang kepada mereka seorang Rasul yang mulia,","w":[["۞ وَلَقَدْ","walaqad","dan sesungguhnya"],["فَتَنَّا","fatannā","Kami telah menguji"],["قَبْلَهُمْ","qablahum","sebelum mereka"],["قَوْمَ","qawma","kaum"],["فِرْعَوْنَ","fir'ʿawna","Fir'aun"],["وَجَآءَهُمْ","wajāahum","dan telah datang kepada mereka"],["رَسُولٌۭ","rasūlun","seorang rasul"],["كَرِيمٌ","karīmun","yang mulia"]]},{"t":"(dengan berkata), \"Serahkanlah kepadaku hamba-hamba Allah (Bani Israil). Sesungguhnya aku adalah utusan (Allah) yang dapat kamu percaya,","w":[["أَنْ","an","hendaklah"],["أَدُّوٓا۟","addū","serahkan"],["إِلَىَّ","ilayya","kepadaku"],["عِبَادَ","ʿibāda","hamba-hamba"],["ٱللَّهِ ۖ","l-lahi","Allah"],["إِنِّى","innī","sesungguhnya aku"],["لَكُمْ","lakum","bagi kalian"],["رَسُولٌ","rasūlun","seorang rasul"],["أَمِينٌۭ","amīnun","terpercaya"]]},{"t":"dan jangalah kamu menyombongkan diri terhadap Allah. Sungguh, aku datang kepadamu dengan membawa bukti yang nyata.","w":[["وَأَن","wa-an","dan sesungguhnya"],["لَّا","lā","janganlah"],["تَعْلُوا۟","taʿlū","kamu menyombongkan diri"],["عَلَى","ʿalā","terhadap"],["ٱللَّهِ ۖ","l-lahi","Allah"],["إِنِّىٓ","innī","sesungguhnya aku"],["ءَاتِيكُم","ātīkum","aku datang kepadamu"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","dengan kekuasaan/bukti"],["مُّبِينٍۢ","mubīnin","nyata"]]},{"t":"Dan sesungguhnya aku berlindung kepada Tuhanku dan Tuhanmu, dari ancamanmu untuk merajamku,","w":[["وَإِنِّى","wa-innī","dan sesungguhnya aku"],["عُذْتُ","ʿudh'tu","aku berlindung"],["بِرَبِّى","birabbī","kepada Tuhanku"],["وَرَبِّكُمْ","warabbikum","dan Tuhanmu"],["أَن","an","bahwa"],["تَرْجُمُونِ","tarjumūni","kamu akan merajamku"]]},{"t":"dan jika kamu tidak beriman kepadaku, maka biarkanlah aku (memimpin Bani Israil).\"","w":[["وَإِن","wa-in","dan jika"],["لَّمْ","lam","tidak"],["تُؤْمِنُوا۟","tu'minū","kamu beriman"],["لِى","lī","kepadaku"],["فَٱعْتَزِلُونِ","fa-iʿ'tazilūni","maka tinggalkanlah aku"]]},{"t":"Kemudian dia (Musa) berdoa kepada Tuhannya, \"Sungguh, mereka ini adalah kaum yang berdosa (segerakanlah azab kepada mereka).\"","w":[["فَدَعَا","fadaʿā","maka dia berdo'a"],["رَبَّهُۥٓ","rabbahu","Tuhannya"],["أَنَّ","anna","bahwasanya"],["هَـٰٓؤُلَآءِ","hāulāi","mereka ini"],["قَوْمٌۭ","qawmun","kaum"],["مُّجْرِمُونَ","muj'rimūna","orang-orang yang berdosa"]]},{"t":"(Allah berfirman), \"Karena itu berjalanlah dengan hamba-hamba-Ku pada malam hari, sesungguhnya kamu akan dikejar,","w":[["فَأَسْرِ","fa-asri","maka berjalanlah kamu"],["بِعِبَادِى","biʿibādī","dengan hamba-hamba-Ku"],["لَيْلًا","laylan","pada malam hari"],["إِنَّكُم","innakum","sesungguhnya kalian"],["مُّتَّبَعُونَ","muttabaʿūna","orang-orang yang diikuti/di kejar"]]},{"t":"dan biarkanlah laut itu terbelah. Sesungguhnya mereka bala tentara yang akan ditenggelamkan.\"","w":[["وَٱتْرُكِ","wa-ut'ruki","dan tinggalkan/biarkan"],["ٱلْبَحْرَ","l-baḥra","laut"],["رَهْوًا ۖ","rahwan","tenang"],["إِنَّهُمْ","innahum","sesungguhnya mereka"],["جُندٌۭ","jundun","bala tentara"],["مُّغْرَقُونَ","mugh'raqūna","orang-orang yang ditenggelamkan"]]},{"t":"Betapa banyak taman-taman dan mata air-mata air yang mereka tinggalkan,","w":[["كَمْ","kam","berapa banyak"],["تَرَكُوا۟","tarakū","mereka tinggalkan"],["مِن","min","dari"],["جَنَّـٰتٍۢ","jannātin","taman-taman"],["وَعُيُونٍۢ","waʿuyūnin","dan mata air"]]},{"t":"juga kebun-kebun serta tempat-tempat kediaman yang indah,","w":[["وَزُرُوعٍۢ","wazurūʿin","dan tanaman-tanaman"],["وَمَقَامٍۢ","wamaqāmin","dan tempat-tempat"],["كَرِيمٍۢ","karīmin","mulia/indah"]]},{"t":"dan kesenangan-kesenangan yang dapat mereka nikmati di sana,","w":[["وَنَعْمَةٍۢ","wanaʿmatin","dan kenikmatan"],["كَانُوا۟","kānū","adalah mereka"],["فِيهَا","fīhā","di dalamnya"],["فَـٰكِهِينَ","fākihīna","bersenang-senang"]]},{"t":"demikianlah, dan Kami wariskan (semua) itu kepada kaum yang lain.","w":[["كَذَٰلِكَ ۖ","kadhālika","seperti demikian"],["وَأَوْرَثْنَـٰهَا","wa-awrathnāhā","Kami wariskannya"],["قَوْمًا","qawman","kaum"],["ءَاخَرِينَ","ākharīna","yang lain"]]},{"t":"Maka langit dan bumi tidak menangisi mereka dan mereka pun tidak diberi penangguhan waktu.","w":[["فَمَا","famā","maka tidaklah"],["بَكَتْ","bakat","menangis"],["عَلَيْهِمُ","ʿalayhimu","atas mereka"],["ٱلسَّمَآءُ","l-samāu","langit"],["وَٱلْأَرْضُ","wal-arḍu","dan bumi"],["وَمَا","wamā","dan tidak ada"],["كَانُوا۟","kānū","mereka"],["مُنظَرِينَ","munẓarīna","orang-orang yang diberi tangguh"]]},{"t":"Dan sungguh, telah Kami selamatkan Bani Israil dari siksaan yang menghinakan,","w":[["وَلَقَدْ","walaqad","dan sesungguhya"],["نَجَّيْنَا","najjaynā","Kami telah menyelamatkan"],["بَنِىٓ","banī","Bani"],["إِسْرَٰٓءِيلَ","is'rāīla","Israil"],["مِنَ","mina","dari"],["ٱلْعَذَابِ","l-ʿadhābi","azab"],["ٱلْمُهِينِ","l-muhīni","yang hina"]]},{"t":"dari (siksaan) Fir'aun, sungguh, dia itu orang yang sombong, termasuk orang-orang yang melampaui batas.","w":[["مِن","min","dari"],["فِرْعَوْنَ ۚ","fir'ʿawna","Fir'aun"],["إِنَّهُۥ","innahu","sesungguhnya"],["كَانَ","kāna","adalah"],["عَالِيًۭا","ʿāliyan","tinggi/sombong"],["مِّنَ","mina","dari/termasuk"],["ٱلْمُسْرِفِينَ","l-mus'rifīna","orang-orang yang melampaui batas"]]},{"t":"Dan sungguh, Kami pilih mereka (Bani Israil) dengan ilmu (Kami) di atas semua bangsa (pada masa itu).","w":[["وَلَقَدِ","walaqadi","dan sesungguhnya"],["ٱخْتَرْنَـٰهُمْ","ikh'tarnāhum","Kami telah memilih mereka"],["عَلَىٰ","ʿalā","dengan"],["عِلْمٍ","ʿil'min","pengetahuan"],["عَلَى","ʿalā","di atas"],["ٱلْعَـٰلَمِينَ","l-ʿālamīna","alam semesta"]]},{"t":"Dan telah Kami berikan kepada mereka di antara tanda-tanda (kebesaran Kami) sesuatu yang di dalamnya terdapat nikmat yang nyata.","w":[["وَءَاتَيْنَـٰهُم","waātaynāhum","dan Kami telah berikan kepada mereka"],["مِّنَ","mina","dari"],["ٱلْـَٔايَـٰتِ","l-āyāti","tanda-tanda"],["مَا","mā","apa yang"],["فِيهِ","fīhi","di dalamnya"],["بَلَـٰٓؤٌۭا۟","balāon","percobaan/ujian"],["مُّبِينٌ","mubīnun","nyata"]]},{"t":"Sesungguhnya mereka (kaum musyrik) itu pasti akan berkata,","w":[["إِنَّ","inna","sesungguhnya"],["هَـٰٓؤُلَآءِ","hāulāi","mereka itu"],["لَيَقُولُونَ","layaqūlūna","benar-benar mereka berkata"]]},{"t":"\"Tidak ada kematian selain kematian di dunia ini. Dan kami tidak akan dibangkitkan,","w":[["إِنْ","in","bahwa"],["هِىَ","hiya","ia"],["إِلَّا","illā","kecuali"],["مَوْتَتُنَا","mawtatunā","kematian kami"],["ٱلْأُولَىٰ","l-ūlā","pertama"],["وَمَا","wamā","dan tidaklah"],["نَحْنُ","naḥnu","kami"],["بِمُنشَرِينَ","bimunsharīna","orang-orang yang di bangkitkan"]]},{"t":"maka hadirkanlah (kembali) nenek moyang kami jika kamu orang yang benar.\"","w":[["فَأْتُوا۟","fatū","maka datanglah"],["بِـَٔابَآئِنَآ","biābāinā","dengan bapak-bapak kami"],["إِن","in","jika"],["كُنتُمْ","kuntum","kalian adalah"],["صَـٰدِقِينَ","ṣādiqīna","orang-orang yang benar"]]},{"t":"Apakah mereka (kaum musyrikin) yang lebih baik atau kaum Tubba', dan orang-orang sebelum mereka yang telah Kami binasakan karena mereka adalah orang-orang yang sungguh berdosa.","w":[["أَهُمْ","ahum","apakah mereka"],["خَيْرٌ","khayrun","lebih baik"],["أَمْ","am","atau"],["قَوْمُ","qawmu","kaum"],["تُبَّعٍۢ","tubbaʿin","Tubba'"],["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["مِن","min","dari"],["قَبْلِهِمْ ۚ","qablihim","sebelum mereka"],["أَهْلَكْنَـٰهُمْ ۖ","ahlaknāhum","Kami telah membinasakan mereka"],["إِنَّهُمْ","innahum","sesungguhnya mereka"],["كَانُوا۟","kānū","adalah mereka"],["مُجْرِمِينَ","muj'rimīna","orang-orang yang berdosa"]]},{"t":"Dan tidaklah Kami bermain-main menciptakan langit dan bumi dan apa yang ada di antara keduanya.","w":[["وَمَا","wamā","dan tidak"],["خَلَقْنَا","khalaqnā","Kami menciptakan/menjadikan"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["وَٱلْأَرْضَ","wal-arḍa","dan bumi"],["وَمَا","wamā","dan apa"],["بَيْنَهُمَا","baynahumā","diantara keduanya"],["لَـٰعِبِينَ","lāʿibīna","bermain-main"]]},{"t":"Tidaklah Kami ciptakan keduanya melainkan dengan hak (benar), tetapi kebanyakan mereka tidak mengetahui.","w":[["مَا","mā","tidak"],["خَلَقْنَـٰهُمَآ","khalaqnāhumā","Kami menjadikan keduanya"],["إِلَّا","illā","kecuali"],["بِٱلْحَقِّ","bil-ḥaqi","dengan hak"],["وَلَـٰكِنَّ","walākinna","tetapi"],["أَكْثَرَهُمْ","aktharahum","kebanyakan mereka"],["لَا","lā","tidak"],["يَعْلَمُونَ","yaʿlamūna","mereka mengetahui"]]},{"t":"Sungguh, hari keputusan (hari Kiamat) adalah waktu yang dijanjikan bagi mereka semuanya,","w":[["إِنَّ","inna","sesungguhnya"],["يَوْمَ","yawma","hari"],["ٱلْفَصْلِ","l-faṣli","keputusan"],["مِيقَـٰتُهُمْ","mīqātuhum","waktu mereka"],["أَجْمَعِينَ","ajmaʿīna","semuanya"]]},{"t":"(yaitu) pada hari (ketika) seorang teman sama sekali tidak dapat memberi manfaat kepada teman lainnya, dan mereka tidak akan mendapat pertolongan,","w":[["يَوْمَ","yawma","hari"],["لَا","lā","tidak"],["يُغْنِى","yugh'nī","berguna"],["مَوْلًى","mawlan","kawan karib"],["عَن","ʿan","dari"],["مَّوْلًۭى","mawlan","kawan karib"],["شَيْـًۭٔا","shayan","sesuatu/sedikit"],["وَلَا","walā","dan tidaklah"],["هُمْ","hum","mereka"],["يُنصَرُونَ","yunṣarūna","mereka mendapat pertolongan"]]},{"t":"kecuali orang yang diberi rahmat oleh Allah. Sungguh, Dia Mahaperkasa, Maha Penyayang.","w":[["إِلَّا","illā","kecuali"],["مَن","man","orang"],["رَّحِمَ","raḥima","merahmati"],["ٱللَّهُ ۚ","l-lahu","Allah"],["إِنَّهُۥ","innahu","sesungguhnya Dia"],["هُوَ","huwa","Dia"],["ٱلْعَزِيزُ","l-ʿazīzu","Maha Perkasa"],["ٱلرَّحِيمُ","l-raḥīmu","Maha Penyayang"]]},{"t":"Sungguh pohon zaqqūm itu,","w":[["إِنَّ","inna","sesungguhnya"],["شَجَرَتَ","shajarata","pohon"],["ٱلزَّقُّومِ","l-zaqūmi","zaqqum"]]},{"t":"makanan bagi orang yang banyak dosa.","w":[["طَعَامُ","ṭaʿāmu","makanan"],["ٱلْأَثِيمِ","l-athīmi","orang yang berdosa"]]},{"t":"Seperti cairan tembaga yang mendidih di dalam perut,","w":[["كَٱلْمُهْلِ","kal-muh'li","seperti minyak"],["يَغْلِى","yaghlī","ia mendidih"],["فِى","fī","di dalam"],["ٱلْبُطُونِ","l-buṭūni","perut"]]},{"t":"seperti mendidihnya air yang sangat panas.","w":[["كَغَلْىِ","kaghalyi","seperti mendidihnya"],["ٱلْحَمِيمِ","l-ḥamīmi","air yang sangat panas"]]},{"t":"\"Peganglah dia, kemudian seretlah dia sampai ke tengah-tengah neraka,","w":[["خُذُوهُ","khudhūhu","tangkaplah dia"],["فَٱعْتِلُوهُ","fa-iʿ'tilūhu","lalu seretlah dia"],["إِلَىٰ","ilā","sampai"],["سَوَآءِ","sawāi","ke tengah-tengah"],["ٱلْجَحِيمِ","l-jaḥīmi","neraka jahim"]]},{"t":"kemudian tuangkanlah di atas kepalanya azab (dari) air yang sangat panas.\"","w":[["ثُمَّ","thumma","kemudian"],["صُبُّوا۟","ṣubbū","tuangkanlah"],["فَوْقَ","fawqa","di atas"],["رَأْسِهِۦ","rasihi","kepalanya"],["مِنْ","min","dari"],["عَذَابِ","ʿadhābi","azab"],["ٱلْحَمِيمِ","l-ḥamīmi","air yang sangat panas"]]},{"t":"\"Rasakanlah, sesungguhnya engkau benar-benar orang yang perkasa lagi mulia (di tengah kaummu).\"","w":[["ذُقْ","dhuq","rasakanlah"],["إِنَّكَ","innaka","sesungguhnya kamu"],["أَنتَ","anta","kamu"],["ٱلْعَزِيزُ","l-ʿazīzu","seorang perkasa"],["ٱلْكَرِيمُ","l-karīmu","seorang mulia"]]},{"t":"Sungguh, inilah azab yang dahulu kamu ragukan.","w":[["إِنَّ","inna","sesungguhnya"],["هَـٰذَا","hādhā","ini"],["مَا","mā","apa (azab)"],["كُنتُم","kuntum","kalian adalah"],["بِهِۦ","bihi","padanya"],["تَمْتَرُونَ","tamtarūna","kamu meragukan"]]},{"t":"Sungguh, orang-orang yang bertakwa berada dalam tempat yang aman,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْمُتَّقِينَ","l-mutaqīna","orang-orang yang bertakwa"],["فِى","fī","dalam"],["مَقَامٍ","maqāmin","tempat"],["أَمِينٍۢ","amīnin","aman"]]},{"t":"(yaitu) di dalam taman-taman dan mata air-mata air;","w":[["فِى","fī","dalam"],["جَنَّـٰتٍۢ","jannātin","taman-taman"],["وَعُيُونٍۢ","waʿuyūnin","dan mata air"]]},{"t":"mereka memakai sutera yang halus dan sutera yang tebal, (duduk) berhadapan,","w":[["يَلْبَسُونَ","yalbasūna","mereka memakai"],["مِن","min","dari"],["سُندُسٍۢ","sundusin","kain sutera halus"],["وَإِسْتَبْرَقٍۢ","wa-is'tabraqin","dan sutera tebal"],["مُّتَقَـٰبِلِينَ","mutaqābilīna","mereka berhadap-hadapan"]]},{"t":"demikianlah, kemudian Kami berikan kepada mereka pasangan bidadari yang bermata indah.","w":[["كَذَٰلِكَ","kadhālika","seperti demikian"],["وَزَوَّجْنَـٰهُم","wazawwajnāhum","Kami jodohkan mereka"],["بِحُورٍ","biḥūrin","dengan jelita/bidadari"],["عِينٍۢ","ʿīnin","matanya"]]},{"t":"Di dalamnya mereka dapat meminta segala macam buah-buahan dengan aman dan tenteram,","w":[["يَدْعُونَ","yadʿūna","mereka meminta"],["فِيهَا","fīhā","di dalamnya"],["بِكُلِّ","bikulli","dengan segala macam"],["فَـٰكِهَةٍ","fākihatin","buah-buahan"],["ءَامِنِينَ","āminīna","dengan aman"]]},{"t":"mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka,","w":[["لَا","lā","tidak"],["يَذُوقُونَ","yadhūqūna","mereka merasakan"],["فِيهَا","fīhā","di dalamnya"],["ٱلْمَوْتَ","l-mawta","mati"],["إِلَّا","illā","kecuali"],["ٱلْمَوْتَةَ","l-mawtata","kematian"],["ٱلْأُولَىٰ ۖ","l-ūlā","pertama"],["وَوَقَىٰهُمْ","wawaqāhum","dan Dia memelihara mereka"],["عَذَابَ","ʿadhāba","azab"],["ٱلْجَحِيمِ","l-jaḥīmi","neraka jahim"]]},{"t":"itu merupakan karunia dari Tuhanmu. Demikian itulah kemenangan yang agung.","w":[["فَضْلًۭا","faḍlan","karunia"],["مِّن","min","dari"],["رَّبِّكَ ۚ","rabbika","Tuhanmu"],["ذَٰلِكَ","dhālika","demikian itu"],["هُوَ","huwa","ia/itu"],["ٱلْفَوْزُ","l-fawzu","keuntungan"],["ٱلْعَظِيمُ","l-ʿaẓīmu","yang besar"]]},{"t":"Sungguh, Kami mudahkan Alquran itu dengan bahasamu agar mereka mendapat pelajaran.","w":[["فَإِنَّمَا","fa-innamā","maka sesungguhnya"],["يَسَّرْنَـٰهُ","yassarnāhu","Kami mudahkannya"],["بِلِسَانِكَ","bilisānika","dengan lisan/bahasamu"],["لَعَلَّهُمْ","laʿallahum","supaya mereka"],["يَتَذَكَّرُونَ","yatadhakkarūna","mereka mendapat pelajaran"]]},{"t":"Maka tunggulah; sungguh, mereka itu (juga sedang) menunggu.","w":[["فَٱرْتَقِبْ","fa-ir'taqib","maka tunggulah"],["إِنَّهُم","innahum","sesungguhnya mereka"],["مُّرْتَقِبُونَ","mur'taqibūna","orang-orang yang menunggu"]]}]}