{"n":95,"ayat":[{"t":"Demi (buah) Tin dan (buah) Zaitun,","w":[["وَٱلتِّينِ","wal-tīni","demi tin"],["وَٱلزَّيْتُونِ","wal-zaytūni","dan zaitun"]]},{"t":"demi gunung Sinai,","w":[["وَطُورِ","waṭūri","dan bukit"],["سِينِينَ","sīnīna","Sinai"]]},{"t":"dan demi negeri (Mekkah) yang aman ini.","w":[["وَهَـٰذَا","wahādhā","dan ini"],["ٱلْبَلَدِ","l-baladi","negri"],["ٱلْأَمِينِ","l-amīni","aman"]]},{"t":"Sungguh, Kami telah menciptakan manusia dalam bentuk yang sebaik-baiknya,","w":[["لَقَدْ","laqad","sesungguhnya"],["خَلَقْنَا","khalaqnā","Kami telah menciptakan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["فِىٓ","fī","dalam"],["أَحْسَنِ","aḥsani","sebaik-baik"],["تَقْوِيمٍۢ","taqwīmin","bentuk"]]},{"t":"kemudian Kami kembalikan dia ke tempat yang serendah-rendahnya,","w":[["ثُمَّ","thumma","kemudian"],["رَدَدْنَـٰهُ","radadnāhu","Kami kembalikan"],["أَسْفَلَ","asfala","lebih rendah/paling rendah"],["سَـٰفِلِينَ","sāfilīna","tempat yang rendah"]]},{"t":"kecuali orang-orang yang beriman dan mengerjakan kebajikan; maka mereka akan mendapat pahala yang tidak ada putus-putusnya.","w":[["إِلَّا","illā","kecuali"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوا۟","āmanū","beriman"],["وَعَمِلُوا۟","waʿamilū","dan mereka berbuat/beramal"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","kebajikan/saleh"],["فَلَهُمْ","falahum","maka bagi mereka"],["أَجْرٌ","ajrun","pahala"],["غَيْرُ","ghayru","bukan/tidak"],["مَمْنُونٍۢ","mamnūnin","terputus"]]},{"t":"Maka apa yang menyebabkan (mereka) mendustakanmu (tentang) hari pembalasan setelah (adanya keterangan-keterangan) itu?","w":[["فَمَا","famā","maka apakah"],["يُكَذِّبُكَ","yukadhibuka","mendustakanmu"],["بَعْدُ","baʿdu","sesudah"],["بِٱلدِّينِ","bil-dīni","hari pembalasan/agama"]]},{"t":"Bukankah Allah Hakim yang paling adil?","w":[["أَلَيْسَ","alaysa","bukankah"],["ٱللَّهُ","l-lahu","Allah"],["بِأَحْكَمِ","bi-aḥkami","lebih bijaksana/seadil-adilnya"],["ٱلْحَـٰكِمِينَ","l-ḥākimīna","para hakim"]]}]}