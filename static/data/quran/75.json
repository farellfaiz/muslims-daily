{"n":75,"ayat":[{"t":"Aku bersumpah dengan hari Kiamat,","w":[["لَآ","lā","benar-benar"],["أُقْسِمُ","uq'simu","aku bersumpah"],["بِيَوْمِ","biyawmi","dengan hari"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","kiamat"]]},{"t":"dan aku bersumpah demi jiwa yang selalu menyesali (dirinya sendiri).","w":[["وَلَآ","walā","dan benar-benar"],["أُقْسِمُ","uq'simu","aku bersumpah"],["بِٱلنَّفْسِ","bil-nafsi","dengan jiwa"],["ٱللَّوَّامَةِ","l-lawāmati","mencela/menyesali"]]},{"t":"Apakah manusia mengira, bahwa Kami tidak akan mengumpulkan (kembali) tulang belulangnya?","w":[["أَيَحْسَبُ","ayaḥsabu","apakah mengira"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["أَلَّن","allan","bahwa tidak"],["نَّجْمَعَ","najmaʿa","Kami mengumpulkan"],["عِظَامَهُۥ","ʿiẓāmahu","tulang-belulangnya"]]},{"t":"(Bahkan) Kami mampu menyusun (kembali) jari jemarinya dengan sempurna.","w":[["بَلَىٰ","balā","yang benar/bahkan"],["قَـٰدِرِينَ","qādirīna","berkuasa"],["عَلَىٰٓ","ʿalā","atas"],["أَن","an","dari"],["نُّسَوِّىَ","nusawwiya","Kami menyempurnakan"],["بَنَانَهُۥ","banānahu","jari-jemarinya"]]},{"t":"Tetapi manusia hendak membuat maksiat terus menerus.","w":[["بَلْ","bal","bahkan"],["يُرِيدُ","yurīdu","menghendaki"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["لِيَفْجُرَ","liyafjura","untuk membuat durhaka"],["أَمَامَهُۥ","amāmahu","di hadapannya/di masa depan"]]},{"t":"Dia bertanya, \"Kapankah hari Kiamat itu?\"","w":[["يَسْـَٔلُ","yasalu","ia bertanya"],["أَيَّانَ","ayyāna","bilakah"],["يَوْمُ","yawmu","hari"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","kiamat"]]},{"t":"Maka apabila mata terbelalak (ketakutan),","w":[["فَإِذَا","fa-idhā","maka tatkala"],["بَرِقَ","bariqa","bingung/takut"],["ٱلْبَصَرُ","l-baṣaru","pandangan/mata"]]},{"t":"dan bulan pun telah hilang cahayanya,","w":[["وَخَسَفَ","wakhasafa","dan gelap/hilang cahaya"],["ٱلْقَمَرُ","l-qamaru","bulan"]]},{"t":"lalu matahari dan bulan dikumpulkan,","w":[["وَجُمِعَ","wajumiʿa","dan dikumpulkan"],["ٱلشَّمْسُ","l-shamsu","matahari"],["وَٱلْقَمَرُ","wal-qamaru","dan bulan"]]},{"t":"pada hari itu manusia berkata, \"Ke mana tempat pelarian?\"","w":[["يَقُولُ","yaqūlu","berkata"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["يَوْمَئِذٍ","yawma-idhin","pada hari itu"],["أَيْنَ","ayna","dimana/kemana"],["ٱلْمَفَرُّ","l-mafaru","tempat lari"]]},{"t":"Tidak! Tidak ada tempat berlindung!","w":[["كَلَّا","kallā","sekali-kali tidak"],["لَا","lā","tidak"],["وَزَرَ","wazara","tempat lari/berlindung"]]},{"t":"Hanya kepada Tuhanmu tempat kembali pada hari itu.","w":[["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["يَوْمَئِذٍ","yawma-idhin","pada hari itu"],["ٱلْمُسْتَقَرُّ","l-mus'taqaru","tempat menetap/kembali"]]},{"t":"Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya.","w":[["يُنَبَّؤُا۟","yunabba-u","diberitahukan"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["يَوْمَئِذٍۭ","yawma-idhin","pada hari itu"],["بِمَا","bimā","tentang apa"],["قَدَّمَ","qaddama","dia kerjakan/dahulukan"],["وَأَخَّرَ","wa-akhara","dia akhirkan/lalaikan"]]},{"t":"Bahkan manusia menjadi saksi atas dirinya sendiri,","w":[["بَلِ","bali","bahkan"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["عَلَىٰ","ʿalā","atas"],["نَفْسِهِۦ","nafsihi","dirinya"],["بَصِيرَةٌۭ","baṣīratun","melihat terang (menjadi saksi)"]]},{"t":"dan meskipun dia mengemukakan alasan-alasannya.","w":[["وَلَوْ","walaw","walaupun/meskipun"],["أَلْقَىٰ","alqā","dia lemparkan/kemukakan"],["مَعَاذِيرَهُۥ","maʿādhīrahu","uzurnya/alasan-alasannya"]]},{"t":"Jangan engkau (Muhammad) gerakkan lidahmu (untuk membaca Alquran) karena hendak cepat-cepat (menguasai)nya.","w":[["لَا","lā","jangan"],["تُحَرِّكْ","tuḥarrik","kamu gerakkan"],["بِهِۦ","bihi","dengannya/padanya"],["لِسَانَكَ","lisānaka","lisanmu/lidahmu"],["لِتَعْجَلَ","litaʿjala","karena kamu hendak bersegera"],["بِهِۦٓ","bihi","dengannya/padanya"]]},{"t":"Sesungguhnya Kami yang akan mengumpulkannya (di dadamu) dan membacakannya.","w":[["إِنَّ","inna","sesungguhnya"],["عَلَيْنَا","ʿalaynā","atas Kami"],["جَمْعَهُۥ","jamʿahu","mengumpulkannya"],["وَقُرْءَانَهُۥ","waqur'ānahu","dan membacakannya"]]},{"t":"Apabila Kami telah selesai membacakannya maka ikutilah bacaannya itu.","w":[["فَإِذَا","fa-idhā","maka apabila"],["قَرَأْنَـٰهُ","qaranāhu","Kami telah membacakannya"],["فَٱتَّبِعْ","fa-ittabiʿ","maka ikutilah"],["قُرْءَانَهُۥ","qur'ānahu","bacaannya"]]},{"t":"Kemudian sesungguhnya Kami yang akan menjelaskannya.","w":[["ثُمَّ","thumma","kemudian"],["إِنَّ","inna","sesungguhnya"],["عَلَيْنَا","ʿalaynā","atas Kami"],["بَيَانَهُۥ","bayānahu","penjelasannya"]]},{"t":"Tidak! Bahkan Kamu mencintai kehidupan dunia,","w":[["كَلَّا","kallā","tidak sekali-kali"],["بَلْ","bal","bahkan/tetapi"],["تُحِبُّونَ","tuḥibbūna","kamu mencintai"],["ٱلْعَاجِلَةَ","l-ʿājilata","yang cepat"]]},{"t":"dan mengabaikan (kehidupan) akhirat.","w":[["وَتَذَرُونَ","watadharūna","dan kamu meninggalkan"],["ٱلْـَٔاخِرَةَ","l-ākhirata","akhirat"]]},{"t":"Wajah-wajah (orang mukmin) pada hari itu berseri-seri.","w":[["وُجُوهٌۭ","wujūhun","wajah-wajah"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["نَّاضِرَةٌ","nāḍiratun","berseri-seri"]]},{"t":"Memandang Tuhannya.","w":[["إِلَىٰ","ilā","kepada"],["رَبِّهَا","rabbihā","Tuhannya"],["نَاظِرَةٌۭ","nāẓiratun","melihat"]]},{"t":"Dan wajah-wajah (orang kafir) pada hari itu muram,","w":[["وَوُجُوهٌۭ","wawujūhun","dan wajah-wajah"],["يَوْمَئِذٍۭ","yawma-idhin","pada hari itu"],["بَاسِرَةٌۭ","bāsiratun","masam/muram"]]},{"t":"mereka yakin bahwa akan ditimpakan kepadanya malapetaka yang sangat dahsyat.","w":[["تَظُنُّ","taẓunnu","ia mengira"],["أَن","an","bahwa"],["يُفْعَلَ","yuf'ʿala","akan dibuat/ditimpakan"],["بِهَا","bihā","dengannya/kepadanya"],["فَاقِرَةٌۭ","fāqiratun","kebinasaan/malapetaka besar"]]},{"t":"Tidak! Apabila (nyawa) telah sampai ke kerongkongan,","w":[["كَلَّآ","kallā","sekali-kali tidak"],["إِذَا","idhā","apabila"],["بَلَغَتِ","balaghati","ia telah sampai"],["ٱلتَّرَاقِىَ","l-tarāqiya","kerongkongan"]]},{"t":"dan dikatakan (kepadanya), \"Siapa yang dapat menyembuhkan?\"","w":[["وَقِيلَ","waqīla","dan dikatakan"],["مَنْ ۜ","man","siapa"],["رَاقٍۢ","rāqin","menjampi/mengobati"]]},{"t":"dan dia yakin bahwa itulah waktu perpisahan (dengan dunia),","w":[["وَظَنَّ","waẓanna","dan dia menyangka"],["أَنَّهُ","annahu","sesungguhnya ia/itu"],["ٱلْفِرَاقُ","l-firāqu","berpisah"]]},{"t":"dan bertaut betis (kiri) dengan betis (kanan),","w":[["وَٱلْتَفَّتِ","wal-tafati","dan bertaut/berbelit"],["ٱلسَّاقُ","l-sāqu","betis"],["بِٱلسَّاقِ","bil-sāqi","dengan betis"]]},{"t":"kepada Tuhanmu lah pada hari itu kamu dihalau.","w":[["إِلَىٰ","ilā","kepada"],["رَبِّكَ","rabbika","Tuhanmu"],["يَوْمَئِذٍ","yawma-idhin","pada hari itu"],["ٱلْمَسَاقُ","l-masāqu","tempat kembali"]]},{"t":"Karena dia (dahulu) tidak mau membenarkan (Alquran dan Rasul) dan tidak mau melaksanakan salat,","w":[["فَلَا","falā","maka/karena tidak"],["صَدَّقَ","ṣaddaqa","dia membenarkan"],["وَلَا","walā","dan tidak"],["صَلَّىٰ","ṣallā","dia mengerjakan sholat"]]},{"t":"tetapi justru dia mendustakan (Rasul) dan berpaling (dari kebenaran),","w":[["وَلَـٰكِن","walākin","tetapi"],["كَذَّبَ","kadhaba","dia mendustakan"],["وَتَوَلَّىٰ","watawallā","dan dia berpaling"]]},{"t":"kemudian dia pergi kepada keluarganya dengan sombong.","w":[["ثُمَّ","thumma","kemudian"],["ذَهَبَ","dhahaba","dia pergi"],["إِلَىٰٓ","ilā","kepada"],["أَهْلِهِۦ","ahlihi","ahlinya/keluarganya"],["يَتَمَطَّىٰٓ","yatamaṭṭā","dengan sombong"]]},{"t":"Celakalah kamu! Maka celakalah!","w":[["أَوْلَىٰ","awlā","lebih utama/kecelakaan"],["لَكَ","laka","bagimu"],["فَأَوْلَىٰ","fa-awlā","maka lebih utama/kecelakaan"]]},{"t":"sekali lagi, celakalah kamu (manusia)! Maka celakalah!","w":[["ثُمَّ","thumma","kemudian"],["أَوْلَىٰ","awlā","lebih utama/kecelakaan"],["لَكَ","laka","bagimu"],["فَأَوْلَىٰٓ","fa-awlā","maka lebih utama/kecelakaan"]]},{"t":"Apakah manusia mengira, dia akan dibiarkan begitu saja (tanpa pertanggung-jawaban)?","w":[["أَيَحْسَبُ","ayaḥsabu","apakah mengira"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["أَن","an","bahwa"],["يُتْرَكَ","yut'raka","ia ditinggalkan"],["سُدًى","sudan","begitu saja"]]},{"t":"Bukankah dia mulanya hanya setetes mani yang ditumpahkan (ke dalam rahim),","w":[["أَلَمْ","alam","bukankah"],["يَكُ","yaku","ia adalah"],["نُطْفَةًۭ","nuṭ'fatan","setetes"],["مِّن","min","dari"],["مَّنِىٍّۢ","maniyyin","air mani"],["يُمْنَىٰ","yum'nā","ditumpahkan"]]},{"t":"kemudian (mani itu) menjadi sesuatu yang melekat, lalu Allah menciptakannya dan menyempurnakannya,","w":[["ثُمَّ","thumma","kemudian"],["كَانَ","kāna","adalah dia"],["عَلَقَةًۭ","ʿalaqatan","segumpal darah"],["فَخَلَقَ","fakhalaqa","lalu Dia ciptakan"],["فَسَوَّىٰ","fasawwā","lalu Dia sempurnakan"]]},{"t":"lalu Dia menjadikan darinya sepasang laki-laki dan perempuan.","w":[["فَجَعَلَ","fajaʿala","maka/lalu Dia jadikan"],["مِنْهُ","min'hu","daripadanya"],["ٱلزَّوْجَيْنِ","l-zawjayni","dua jodoh/pasang"],["ٱلذَّكَرَ","l-dhakara","laki-laki"],["وَٱلْأُنثَىٰٓ","wal-unthā","dan perempuan"]]},{"t":"Bukankah (Allah yang berbuat) demikian berkuasa (pula) menghidupkan orang mati?","w":[["أَلَيْسَ","alaysa","tidakkah"],["ذَٰلِكَ","dhālika","demikian itu"],["بِقَـٰدِرٍ","biqādirin","berkuasa"],["عَلَىٰٓ","ʿalā","atas"],["أَن","an","bahwa"],["يُحْـِۧىَ","yuḥ'yiya","menghidupkan"],["ٱلْمَوْتَىٰ","l-mawtā","orang mati"]]}]}