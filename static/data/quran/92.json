{"n":92,"ayat":[{"t":"Demi malam apabila menutupi (cahaya siang),","w":[["وَٱلَّيْلِ","wa-al-layli","demi malam"],["إِذَا","idhā","apabila"],["يَغْشَىٰ","yaghshā","ia menutup"]]},{"t":"demi siang bila terang benderang,","w":[["وَٱلنَّهَارِ","wal-nahāri","dan siang"],["إِذَا","idhā","apabila"],["تَجَلَّىٰ","tajallā","terang benderang"]]},{"t":"demi penciptaan laki-laki dan perempuan,","w":[["وَمَا","wamā","dan apa"],["خَلَقَ","khalaqa","ciptakan"],["ٱلذَّكَرَ","l-dhakara","laki-laki"],["وَٱلْأُنثَىٰٓ","wal-unthā","dan perempuan"]]},{"t":"sungguh, usahamu memang beraneka macam.","w":[["إِنَّ","inna","sesungguhnya"],["سَعْيَكُمْ","saʿyakum","usahamu"],["لَشَتَّىٰ","lashattā","sungguh berbeda-beda"]]},{"t":"Maka barangsiapa memberikan (hartanya di jalan Allah) dan bertakwa,","w":[["فَأَمَّا","fa-ammā","maka adapun"],["مَنْ","man","orang"],["أَعْطَىٰ","aʿṭā","ia memberikan"],["وَٱتَّقَىٰ","wa-ittaqā","dan bertaqwa"]]},{"t":"dan membenarkan (adanya pahala) yang terbaik (surga),","w":[["وَصَدَّقَ","waṣaddaqa","dan ia membenarkan/akui"],["بِٱلْحُسْنَىٰ","bil-ḥus'nā","dengan kebaikan"]]},{"t":"maka akan Kami mudahkan baginya jalan menuju kemudahan (kebahagiaan).","w":[["فَسَنُيَسِّرُهُۥ","fasanuyassiruhu","maka Kami akan memudahkannya"],["لِلْيُسْرَىٰ","lil'yus'rā","pada yang mudah"]]},{"t":"Dan adapun orang yang kikir dan merasa dirinya cukup (tidak perlu pertolongan Allah),","w":[["وَأَمَّا","wa-ammā","dan adapun"],["مَنۢ","man","orang"],["بَخِلَ","bakhila","ia kikir"],["وَٱسْتَغْنَىٰ","wa-is'taghnā","dan ia merasa cukup"]]},{"t":"serta mendustakan (pahala) yang terbaik,","w":[["وَكَذَّبَ","wakadhaba","dan ia mendustakan"],["بِٱلْحُسْنَىٰ","bil-ḥus'nā","dengan kebaikan"]]},{"t":"maka akan Kami mudahkan baginya jalan menuju kesukaran (kesengsaraan).","w":[["فَسَنُيَسِّرُهُۥ","fasanuyassiruhu","maka Kami akan memudahkan"],["لِلْعُسْرَىٰ","lil'ʿus'rā","pada yang sukar"]]},{"t":"Dan hartanya tidak bermanfaat baginya apabila dia telah binasa.","w":[["وَمَا","wamā","dan tidak"],["يُغْنِى","yugh'nī","mencukupi/berguna"],["عَنْهُ","ʿanhu","dari padanya/baginya"],["مَالُهُۥٓ","māluhu","hartanya"],["إِذَا","idhā","apabila"],["تَرَدَّىٰٓ","taraddā","ia telah binasa"]]},{"t":"Sesungguhnya Kami lah yang memberi petunjuk,","w":[["إِنَّ","inna","sesungguhnya"],["عَلَيْنَا","ʿalaynā","bagi Kami"],["لَلْهُدَىٰ","lalhudā","kesudahan/akherat"]]},{"t":"dan sesungguhnya milik Kami lah akhirat dan dunia.","w":[["وَإِنَّ","wa-inna","dan sesungguhnya"],["لَنَا","lanā","milik Kamilah"],["لَلْـَٔاخِرَةَ","lalākhirata","akhirat"],["وَٱلْأُولَىٰ","wal-ūlā","dan dunia itu"]]},{"t":"Maka aku memperingatkan kamu dengan neraka yang menyala-nyala,","w":[["فَأَنذَرْتُكُمْ","fa-andhartukum","maka peringatkanlah"],["نَارًۭا","nāran","api neraka"],["تَلَظَّىٰ","talaẓẓā","menyala-nyala"]]},{"t":"yang hanya dimasuki oleh orang yang paling celaka,","w":[["لَا","lā","tidak"],["يَصْلَىٰهَآ","yaṣlāhā","masuk kedalamnya"],["إِلَّا","illā","kecuali"],["ٱلْأَشْقَى","l-ashqā","paling celaka"]]},{"t":"yang mendustakan (kebenaran) dan berpaling (dari iman).","w":[["ٱلَّذِى","alladhī","orang-orang yang"],["كَذَّبَ","kadhaba","mendustakan"],["وَتَوَلَّىٰ","watawallā","dan berpaling"]]},{"t":"Dan akan dijauhkan darinya (neraka) orang yang paling bertakwa,","w":[["وَسَيُجَنَّبُهَا","wasayujannabuhā","dan akan dijauhkan-dia"],["ٱلْأَتْقَى","l-atqā","berbakti"]]},{"t":"yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (dirinya),","w":[["ٱلَّذِى","alladhī","orang-orang yang"],["يُؤْتِى","yu'tī","mendermakan"],["مَالَهُۥ","mālahu","apa yang dia miliki (hartanya)"],["يَتَزَكَّىٰ","yatazakkā","mensucikan"]]},{"t":"dan tidak ada seorang pun memberikan suatu nikmat padanya yang harus dibalasnya,","w":[["وَمَا","wamā","dan tidak"],["لِأَحَدٍ","li-aḥadin","satupun"],["عِندَهُۥ","ʿindahu","pada sisinya"],["مِن","min","dari"],["نِّعْمَةٍۢ","niʿ'matin","nikmat"],["تُجْزَىٰٓ","tuj'zā","patut dibalas"]]},{"t":"tetapi (dia memberikan itu semata-mata) karena mencari keridaan Tuhannya Yang Mahatinggi.","w":[["إِلَّا","illā","kecuali"],["ٱبْتِغَآءَ","ib'tighāa","mencari"],["وَجْهِ","wajhi","keridhaan"],["رَبِّهِ","rabbihi","Tuhannya"],["ٱلْأَعْلَىٰ","l-aʿlā","yang Maha Tinggi"]]},{"t":"Dan niscaya kelak dia akan mendapat kesenangan (yang sempurna).","w":[["وَلَسَوْفَ","walasawfa","dan kelak"],["يَرْضَىٰ","yarḍā","ridha"]]}]}