{"n":109,"ayat":[{"t":"Katakanlah (Muhammad), \"Wahai orang-orang kafir!","w":[["قُلْ","qul","katakanlah"],["يَـٰٓأَيُّهَا","yāayyuhā","wahai"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","orang-orang kafir"]]},{"t":"aku tidak akan menyembah apa yang kamu sembah,","w":[["لَآ","lā","tidak"],["أَعْبُدُ","aʿbudu","aku menyembah"],["مَا","mā","apa"],["تَعْبُدُونَ","taʿbudūna","kamu sembah"]]},{"t":"dan kamu bukan penyembah apa yang aku sembah,","w":[["وَلَآ","walā","dan tidak"],["أَنتُمْ","antum","kamu"],["عَـٰبِدُونَ","ʿābidūna","menyembah"],["مَآ","mā","apa"],["أَعْبُدُ","aʿbudu","aku sembah"]]},{"t":"dan aku tidak pernah menjadi penyembah apa yang kamu sembah,","w":[["وَلَآ","walā","dan bukanlah"],["أَنَا۠","anā","aku"],["عَابِدٌۭ","ʿābidun","menjadi penyembah"],["مَّا","mā","apa"],["عَبَدتُّمْ","ʿabadttum","kamu sembah"]]},{"t":"dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah.","w":[["وَلَآ","walā","dan bukanlah"],["أَنتُمْ","antum","kamu"],["عَـٰبِدُونَ","ʿābidūna","menyembah"],["مَآ","mā","apa"],["أَعْبُدُ","aʿbudu","aku sembah"]]},{"t":"Untukmu agamamu, dan untukku agamaku.\"","w":[["لَكُمْ","lakum","bagi kalian"],["دِينُكُمْ","dīnukum","agamamu"],["وَلِىَ","waliya","bagiku"],["دِينِ","dīni","agamaku"]]}]}