{"n":107,"ayat":[{"t":"Tahukah kamu (orang) yang mendustakan agama?","w":[["أَرَءَيْتَ","ara-ayta","tahukah kamu"],["ٱلَّذِى","alladhī","yang"],["يُكَذِّبُ","yukadhibu","dia mendustakan"],["بِٱلدِّينِ","bil-dīni","dengan agama"]]},{"t":"Maka itulah orang yang menghardik anak yatim,","w":[["فَذَٰلِكَ","fadhālika","maka itulah"],["ٱلَّذِى","alladhī","yang"],["يَدُعُّ","yaduʿʿu","dia menghardik"],["ٱلْيَتِيمَ","l-yatīma","anak yatim"]]},{"t":"dan tidak mengajak memberi makan orang miskin.","w":[["وَلَا","walā","dan tidak"],["يَحُضُّ","yaḥuḍḍu","menganjurkan"],["عَلَىٰ","ʿalā","atas"],["طَعَامِ","ṭaʿāmi","memberi makan"],["ٱلْمِسْكِينِ","l-mis'kīni","orang miskin"]]},{"t":"Maka celakalah orang yang salat,","w":[["فَوَيْلٌۭ","fawaylun","maka celakalah"],["لِّلْمُصَلِّينَ","lil'muṣallīna","orang yang sholat"]]},{"t":"(yaitu) orang-orang yang lalai terhadap salatnya,","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["هُمْ","hum","mereka"],["عَن","ʿan","dar"],["صَلَاتِهِمْ","ṣalātihim","sholat mereka"],["سَاهُونَ","sāhūna","lalai"]]},{"t":"yang berbuat riya`,","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["هُمْ","hum","mereka"],["يُرَآءُونَ","yurāūna","mereka berbuat ria"]]},{"t":"dan enggan (memberikan) bantuan.","w":[["وَيَمْنَعُونَ","wayamnaʿūna","dan mereka mencegah/enggan"],["ٱلْمَاعُونَ","l-māʿūna","pertolongan"]]}]}