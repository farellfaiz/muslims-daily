{"n":90,"ayat":[{"t":"Aku bersumpah dengan negeri ini (Mekkah),","w":[["لَآ","lā","sungguh"],["أُقْسِمُ","uq'simu","Aku bersumpah"],["بِهَـٰذَا","bihādhā","dengan ini"],["ٱلْبَلَدِ","l-baladi","negeri"]]},{"t":"dan engkau (Muhammad), bertempat di negeri (Mekkah) ini,","w":[["وَأَنتَ","wa-anta","dan kamu"],["حِلٌّۢ","ḥillun","halal/bertempat"],["بِهَـٰذَا","bihādhā","dengan ini"],["ٱلْبَلَدِ","l-baladi","negeri"]]},{"t":"dan demi (pertalian) bapak dan anaknya.","w":[["وَوَالِدٍۢ","wawālidin","demi bapak"],["وَمَا","wamā","dan apa"],["وَلَدَ","walada","ia lahirkan (anak)"]]},{"t":"Sungguh, Kami telah menciptakan manusia berada dalam susah payah.","w":[["لَقَدْ","laqad","sesungguhnya"],["خَلَقْنَا","khalaqnā","Kami telah menciptakan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["فِى","fī","dalam"],["كَبَدٍ","kabadin","susah payah"]]},{"t":"Apakah dia (manusia) itu mengira bahwa tidak ada sesuatu pun yang berkuasa atasnya?","w":[["أَيَحْسَبُ","ayaḥsabu","apakah (manusia) menyangka"],["أَن","an","bahwa"],["لَّن","lan","tidak"],["يَقْدِرَ","yaqdira","berkuasa"],["عَلَيْهِ","ʿalayhi","atasnya"],["أَحَدٌۭ","aḥadun","seseorang/satu"]]},{"t":"Dia mengatakan, \"Aku telah menghabiskan harta yang banyak.\"","w":[["يَقُولُ","yaqūlu","ia berkata"],["أَهْلَكْتُ","ahlaktu","aku telah binasakan/habiskan"],["مَالًۭا","mālan","harta"],["لُّبَدًا","lubadan","banyak"]]},{"t":"Apakah dia mengira bahwa tidak ada sesuatu pun yang melihatnya?","w":[["أَيَحْسَبُ","ayaḥsabu","apakah ia menyangka"],["أَن","an","bahwa"],["لَّمْ","lam","tidak"],["يَرَهُۥٓ","yarahu","berkuasa"],["أَحَدٌ","aḥadun","seorang/satu"]]},{"t":"Bukankah Kami telah menjadikan untuknya sepasang mata,","w":[["أَلَمْ","alam","bukankah"],["نَجْعَل","najʿal","Kami jadikan"],["لَّهُۥ","lahu","baginya"],["عَيْنَيْنِ","ʿaynayni","dua buah mata"]]},{"t":"dan lidah dan sepasang bibir?","w":[["وَلِسَانًۭا","walisānan","dan lisan/lidah"],["وَشَفَتَيْنِ","washafatayni","dan dua buah bibir"]]},{"t":"Dan Kami telah menunjukkan kepadanya dua jalan (kebajikkan dan kejahatan).","w":[["وَهَدَيْنَـٰهُ","wahadaynāhu","dan Kami telah tunjukannya"],["ٱلنَّجْدَيْنِ","l-najdayni","dua jalan"]]},{"t":"Tetapi dia tidak menempuh jalan yang mendaki dan sukar?","w":[["فَلَا","falā","maka/tetapi tidak"],["ٱقْتَحَمَ","iq'taḥama","ia menempuh"],["ٱلْعَقَبَةَ","l-ʿaqabata","pendakian/mendaki"]]},{"t":"Dan tahukah kamu apakah jalan yang mendaki dan sukar itu?","w":[["وَمَآ","wamā","da apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["ٱلْعَقَبَةُ","l-ʿaqabatu","pendakian itu"]]},{"t":"(Yaitu) membebaskan budak (hamba sahaya),","w":[["فَكُّ","fakku","memerdekakan"],["رَقَبَةٍ","raqabatin","budak"]]},{"t":"atau memberi makan pada hari terjadi kelaparan,","w":[["أَوْ","aw","atau"],["إِطْعَـٰمٌۭ","iṭ'ʿāmun","memberi makan"],["فِى","fī","pada"],["يَوْمٍۢ","yawmin","hari"],["ذِى","dhī","mempunyai"],["مَسْغَبَةٍۢ","masghabatin","kelaparan"]]},{"t":"(kepada) anak yatim yang ada hubungan kerabat,","w":[["يَتِيمًۭا","yatīman","anak yatim"],["ذَا","dhā","mempunyai"],["مَقْرَبَةٍ","maqrabatin","dekat/kerabat"]]},{"t":"atau orang miskin yang sangat fakir.","w":[["أَوْ","aw","atau"],["مِسْكِينًۭا","mis'kīnan","orang miskin"],["ذَا","dhā","mempunyai"],["مَتْرَبَةٍۢ","matrabatin","sangat payah/melarat"]]},{"t":"Kemudian dia termasuk orang-orang yang beriman, dan saling berpesan untuk bersabar dan saling berpesan untuk berkasih sayang.","w":[["ثُمَّ","thumma","kemudian"],["كَانَ","kāna","adalah ia"],["مِنَ","mina","dari"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوا۟","āmanū","beriman"],["وَتَوَاصَوْا۟","watawāṣaw","dan mereka saling berwasiat/berpesan"],["بِٱلصَّبْرِ","bil-ṣabri","dengan kesabaran"],["وَتَوَاصَوْا۟","watawāṣaw","dan mereka saling berwasiat/berpesan"],["بِٱلْمَرْحَمَةِ","bil-marḥamati","dengan kasih-sayang"]]},{"t":"Mereka (orang-orang yang beriman dan saling berpesan itu) adalah golongan kanan.","w":[["أُو۟لَـٰٓئِكَ","ulāika","mereka itu"],["أَصْحَـٰبُ","aṣḥābu","golongan"],["ٱلْمَيْمَنَةِ","l-maymanati","kanan"]]},{"t":"Dan orang-orang yang kafir kepada ayat-ayat Kami, mereka itu adalah golongan kiri.","w":[["وَٱلَّذِينَ","wa-alladhīna","dan orang-orang yang"],["كَفَرُوا۟","kafarū","kafir/ingkar"],["بِـَٔايَـٰتِنَا","biāyātinā","dengan ayat-ayat Kami"],["هُمْ","hum","mereka"],["أَصْحَـٰبُ","aṣḥābu","golongan"],["ٱلْمَشْـَٔمَةِ","l-mashamati","kiri"]]},{"t":"Mereka berada dalam neraka yang ditutup rapat.","w":[["عَلَيْهِمْ","ʿalayhim","atas/untuk mereka"],["نَارٌۭ","nārun","api/neraka"],["مُّؤْصَدَةٌۢ","mu'ṣadatun","tertutup rapat"]]}]}