{"n":69,"ayat":[{"t":"Hari kiamat,","w":[["ٱلْحَآقَّةُ","al-ḥāqatu","keadaan yang sebenarnya"]]},{"t":"apakah hari Kiamat itu?","w":[["مَا","mā","apakah"],["ٱلْحَآقَّةُ","l-ḥāqatu","keadaan yang sebenarnya"]]},{"t":"Dan tahukah kamu apakah hari Kiamat itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu mengetahui"],["مَا","mā","apa"],["ٱلْحَآقَّةُ","l-ḥāqatu","keadaan yang sebenarnya"]]},{"t":"Kaum Samud, dan 'Ād telah mendustakan hari Kiamat.","w":[["كَذَّبَتْ","kadhabat","telah mendustakan"],["ثَمُودُ","thamūdu","kaum Tsamud"],["وَعَادٌۢ","waʿādun","dan kaum 'Ad"],["بِٱلْقَارِعَةِ","bil-qāriʿati","dengan yang mengejutkan/hari kiamat"]]},{"t":"Maka adapun kaum Samud, mereka telah dibinasakan dengan suara yang sangat keras,","w":[["فَأَمَّا","fa-ammā","maka adapun"],["ثَمُودُ","thamūdu","kaum Tsamud"],["فَأُهْلِكُوا۟","fa-uh'likū","maka mereka dibinasakan"],["بِٱلطَّاغِيَةِ","bil-ṭāghiyati","dengan teriakan/kejadian luar biasa"]]},{"t":"sedangkan kaum 'Ād, mereka telah dibinasakan dengan angin topan yang sangat dingin,","w":[["وَأَمَّا","wa-ammā","dan adapun"],["عَادٌۭ","ʿādun","kaum 'Ad"],["فَأُهْلِكُوا۟","fa-uh'likū","maka mereka dibinasakan"],["بِرِيحٍۢ","birīḥin","dengan angin"],["صَرْصَرٍ","ṣarṣarin","sangat dingin"],["عَاتِيَةٍۢ","ʿātiyatin","amat kencang"]]},{"t":"Allah menimpakan angin itu kepada mereka selama tujuh malam delapan hari terus-menerus; maka kamu melihat kaum 'Ād pada waktu itu mati bergelimpangan seperti batang-batang pohon kurma yang telah kosong (lapuk).","w":[["سَخَّرَهَا","sakharahā","dia menimpakannya(angin itu)"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["سَبْعَ","sabʿa","tujuh"],["لَيَالٍۢ","layālin","malam"],["وَثَمَـٰنِيَةَ","wathamāniyata","dan delapan"],["أَيَّامٍ","ayyāmin","hari"],["حُسُومًۭا","ḥusūman","terus menerus"],["فَتَرَى","fatarā","kamu melihat"],["ٱلْقَوْمَ","l-qawma","kaum"],["فِيهَا","fīhā","padanya/pada waktu itu"],["صَرْعَىٰ","ṣarʿā","mati bergelimpangan"],["كَأَنَّهُمْ","ka-annahum","seakan-akan mereka"],["أَعْجَازُ","aʿjāzu","batang"],["نَخْلٍ","nakhlin","korma"],["خَاوِيَةٍۢ","khāwiyatin","lapuk/tumbang"]]},{"t":"Maka adakah kamu melihat seorang pun yang masih tersisa di antara mereka?","w":[["فَهَلْ","fahal","maka adakah"],["تَرَىٰ","tarā","kamu melihat"],["لَهُم","lahum","diantara mereka"],["مِّنۢ","min","dari"],["بَاقِيَةٍۢ","bāqiyatin","yang tertinggal/tersisa"]]},{"t":"Kemudian datang Fir'aun dan orang-orang yang sebelumnya dan (penduduk) negeri-negeri yang dijungkir balikkan karena kesalahan yang besar.","w":[["وَجَآءَ","wajāa","dan telah datang"],["فِرْعَوْنُ","fir'ʿawnu","Fir'aun"],["وَمَن","waman","dan orang-orang"],["قَبْلَهُۥ","qablahu","sebelumnya"],["وَٱلْمُؤْتَفِكَـٰتُ","wal-mu'tafikātu","dan negeri-negeri yang runtuh/terbalik"],["بِٱلْخَاطِئَةِ","bil-khāṭi-ati","dengan kesalahan-kesalahan"]]},{"t":"Maka mereka mendurhakai utusan Tuhannya, Allah menyiksa mereka dengan siksaan yang sangat keras.","w":[["فَعَصَوْا۟","faʿaṣaw","maka mereka mendurhakai"],["رَسُولَ","rasūla","rasul"],["رَبِّهِمْ","rabbihim","Tuhan mereka"],["فَأَخَذَهُمْ","fa-akhadhahum","maka Dia menyiksa mereka"],["أَخْذَةًۭ","akhdhatan","siksaan"],["رَّابِيَةً","rābiyatan","sangat keras"]]},{"t":"Sesungguhnya ketika air naik (sampai ke gunung), Kami membawa (nenek moyang) kamu ke dalam kapal,","w":[["إِنَّا","innā","sesungguhnya Kami"],["لَمَّا","lammā","tatkala"],["طَغَا","ṭaghā","naik/pasang"],["ٱلْمَآءُ","l-māu","air"],["حَمَلْنَـٰكُمْ","ḥamalnākum","kami bawa kamu"],["فِى","fī","dalam"],["ٱلْجَارِيَةِ","l-jāriyati","kapal"]]},{"t":"agar Kami jadikan (peristiwa itu) sebagai peringatan bagi kamu dan agar diperhatikan oleh telinga yang mau mendengar.","w":[["لِنَجْعَلَهَا","linajʿalahā","karena Kami akan menjadikannya"],["لَكُمْ","lakum","bagi kalian"],["تَذْكِرَةًۭ","tadhkiratan","peringatan/pengajaran"],["وَتَعِيَهَآ","wataʿiyahā","dan menjaga/memperhatikannya"],["أُذُنٌۭ","udhunun","telinga"],["وَٰعِيَةٌۭ","wāʿiyatun","menjaga/memperhatikan"]]},{"t":"Maka apabila sangkakala ditiup sekali tiup,","w":[["فَإِذَا","fa-idhā","maka apabila"],["نُفِخَ","nufikha","ditiup"],["فِى","fī","pada"],["ٱلصُّورِ","l-ṣūri","sangkakala"],["نَفْخَةٌۭ","nafkhatun","tiupan"],["وَٰحِدَةٌۭ","wāḥidatun","satu/sekali"]]},{"t":"dan diangkatlah bumi dan gunung-gunung, lalu dibenturkan keduanya sekali benturan.","w":[["وَحُمِلَتِ","waḥumilati","dan diangkat"],["ٱلْأَرْضُ","l-arḍu","bumi"],["وَٱلْجِبَالُ","wal-jibālu","dan gunung-gunung"],["فَدُكَّتَا","fadukkatā","lalu dihancurkan keduanya"],["دَكَّةًۭ","dakkatan","kehancuran"],["وَٰحِدَةًۭ","wāḥidatan","satu/sekali"]]},{"t":"Maka pada hari itu terjadilah hari Kiamat,","w":[["فَيَوْمَئِذٍۢ","fayawma-idhin","maka pada hari itu"],["وَقَعَتِ","waqaʿati","terjadi"],["ٱلْوَاقِعَةُ","l-wāqiʿatu","kejadian"]]},{"t":"dan terbelahlah langit, karena pada hari itu langit menjadi rapuh.","w":[["وَٱنشَقَّتِ","wa-inshaqqati","dan terbelahlah"],["ٱلسَّمَآءُ","l-samāu","langit"],["فَهِىَ","fahiya","maka ia"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["وَاهِيَةٌۭ","wāhiyatun","lemah"]]},{"t":"Dan para malaikat berada di berbagai penjuru langit. Pada hari itu delapan malaikat menjunjung Arasy (singgasana) Tuhanmu di atas (kepala) mereka.","w":[["وَٱلْمَلَكُ","wal-malaku","dan malaikat"],["عَلَىٰٓ","ʿalā","di atas"],["أَرْجَآئِهَا ۚ","arjāihā","penjuru-penjuru langit"],["وَيَحْمِلُ","wayaḥmilu","dan membawa"],["عَرْشَ","ʿarsha","Arsy"],["رَبِّكَ","rabbika","Tuhanmu"],["فَوْقَهُمْ","fawqahum","di atas mereka"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari ini"],["ثَمَـٰنِيَةٌۭ","thamāniyatun","delapan"]]},{"t":"Pada hari itu kamu dihadapkan (kepada Tuhanmu), tidak ada sesuatu pun dari kamu yang tersembunyi (bagi Allah).","w":[["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["تُعْرَضُونَ","tuʿ'raḍūna","kamu dihadapkan"],["لَا","lā","tidak"],["تَخْفَىٰ","takhfā","tersembunyi"],["مِنكُمْ","minkum","dari kamu"],["خَافِيَةٌۭ","khāfiyatun","tersembunyi"]]},{"t":"Adapun orang yang kitabnya diberikan di tangan kanannya, maka dia berkata, \"Ambillah, bacalah kitabku (ini).\"","w":[["فَأَمَّا","fa-ammā","maka adapun"],["مَنْ","man","orang"],["أُوتِىَ","ūtiya","diberikan"],["كِتَـٰبَهُۥ","kitābahu","kitabnya"],["بِيَمِينِهِۦ","biyamīnihi","di tangan kanannya"],["فَيَقُولُ","fayaqūlu","maka ia berkata"],["هَآؤُمُ","hāumu","marilah/ambillah"],["ٱقْرَءُوا۟","iq'raū","bacalah"],["كِتَـٰبِيَهْ","kitābiyah","kitab"]]},{"t":"Sesungguhnya aku yakin, bahwa (suatu saat) aku akan menerima perhitungan terhadap diriku.","w":[["إِنِّى","innī","sesungguhnya aku"],["ظَنَنتُ","ẓanantu","aku sangka/yakin"],["أَنِّى","annī","bahwasanya aku"],["مُلَـٰقٍ","mulāqin","menemui"],["حِسَابِيَهْ","ḥisābiyah","perhitungan"]]},{"t":"Maka orang itu berada dalam kehidupan yang diridai,","w":[["فَهُوَ","fahuwa","dan dia/orang itu"],["فِى","fī","dalam"],["عِيشَةٍۢ","ʿīshatin","kehidupan"],["رَّاضِيَةٍۢ","rāḍiyatin","yang diridhoi"]]},{"t":"dalam surga yang tinggi,","w":[["فِى","fī","di dalam"],["جَنَّةٍ","jannatin","surga"],["عَالِيَةٍۢ","ʿāliyatin","yang tinggi"]]},{"t":"buah-buahannya dekat,","w":[["قُطُوفُهَا","quṭūfuhā","buah-buahannya"],["دَانِيَةٌۭ","dāniyatun","dekat"]]},{"t":"(kepada mereka dikatakan), \"Makan dan minumlah dengan nikmat karena amal yang telah kamu kerjakan pada hari-hari yang telah lalu.\"","w":[["كُلُوا۟","kulū","makanlah"],["وَٱشْرَبُوا۟","wa-ish'rabū","dan minumlah"],["هَنِيٓـًٔۢا","hanīan","dengan senang/penuh kepuasan"],["بِمَآ","bimā","dengan apa/disebabkan"],["أَسْلَفْتُمْ","aslaftum","kamu lalui/sediakan"],["فِى","fī","pada"],["ٱلْأَيَّامِ","l-ayāmi","hari-hari"],["ٱلْخَالِيَةِ","l-khāliyati","telah lalu"]]},{"t":"Dan adapun orang yang kitabnya diberikan di tangan kirinya, maka dia berkata, \"Alangkah baiknya jika kitabku (ini) tidak diberikan kepadaku.","w":[["وَأَمَّا","wa-ammā","dan adapun"],["مَنْ","man","orang yang"],["أُوتِىَ","ūtiya","diberikan"],["كِتَـٰبَهُۥ","kitābahu","kitabnya"],["بِشِمَالِهِۦ","bishimālihi","di tangan kirinya"],["فَيَقُولُ","fayaqūlu","maka dia berkata"],["يَـٰلَيْتَنِى","yālaytanī","Alangkah baiknya"],["لَمْ","lam","tidak"],["أُوتَ","ūta","diberikan aku"],["كِتَـٰبِيَهْ","kitābiyah","kitab"]]},{"t":"Sehingga aku tidak mengetahui bagaimana perhitunganku,","w":[["وَلَمْ","walam","dan tidak"],["أَدْرِ","adri","aku mengetahui"],["مَا","mā","apa"],["حِسَابِيَهْ","ḥisābiyah","perhitungan"]]},{"t":"Wahai, kiranya (kematian) itulah yang menyudahi segala sesuatu.","w":[["يَـٰلَيْتَهَا","yālaytahā","seandainya itu (kematian)"],["كَانَتِ","kānati","adalah ia"],["ٱلْقَاضِيَةَ","l-qāḍiyata","putusan/penyelesaian"]]},{"t":"Hartaku sama sekali tidak berguna bagiku.","w":[["مَآ","mā","tidak"],["أَغْنَىٰ","aghnā","memberi manfaat"],["عَنِّى","ʿannī","dariku/kepadaku"],["مَالِيَهْ ۜ","māliyah","harta"]]},{"t":"Kekuasaanku telah hilang dariku.\"","w":[["هَلَكَ","halaka","telah binasa/lenyap"],["عَنِّى","ʿannī","daripadaku"],["سُلْطَـٰنِيَهْ","sul'ṭāniyah","kekuasaanku"]]},{"t":"(Allah berfirman), \"Tangkaplah dia lalu belenggulah tangannya ke lehernya.\"","w":[["خُذُوهُ","khudhūhu","peganglah ia/tangkaplah ia"],["فَغُلُّوهُ","faghullūhu","lalu belenggulah ia"]]},{"t":"Kemudian masukkanlah dia ke dalam api neraka yang menyala-nyala.","w":[["ثُمَّ","thumma","kemudian"],["ٱلْجَحِيمَ","l-jaḥīma","neraka jahim"],["صَلُّوهُ","ṣallūhu","masukkanlah ia"]]},{"t":"Kemudian belitlah dia dengan rantai yang panjangnya tujuh puluh hasta.","w":[["ثُمَّ","thumma","kemudian"],["فِى","fī","pada"],["سِلْسِلَةٍۢ","sil'silatin","rantai"],["ذَرْعُهَا","dharʿuhā","hastanya/panjangnya"],["سَبْعُونَ","sabʿūna","tujuh puluh"],["ذِرَاعًۭا","dhirāʿan","hasta"],["فَٱسْلُكُوهُ","fa-us'lukūhu","maka masukkan/belitkan"]]},{"t":"Sesungguhnya dialah orang yang tidak beriman kepada Allah Yang Mahabesar.","w":[["إِنَّهُۥ","innahu","sesungguhnya"],["كَانَ","kāna","adalah ia"],["لَا","lā","tidak"],["يُؤْمِنُ","yu'minu","beriman"],["بِٱللَّهِ","bil-lahi","kepada Allah"],["ٱلْعَظِيمِ","l-ʿaẓīmi","Maha Besar"]]},{"t":"Dan juga dia tidak mendorong (orang lain) untuk memberi makan orang miskin.","w":[["وَلَا","walā","dan tidak"],["يَحُضُّ","yaḥuḍḍu","ia menganjurkan"],["عَلَىٰ","ʿalā","untuk"],["طَعَامِ","ṭaʿāmi","memberi makan"],["ٱلْمِسْكِينِ","l-mis'kīni","orang-orang miskin"]]},{"t":"Maka pada hari ini di sini tidak ada seorang teman pun baginya.","w":[["فَلَيْسَ","falaysa","maka tidak"],["لَهُ","lahu","baginya"],["ٱلْيَوْمَ","l-yawma","hari ini"],["هَـٰهُنَا","hāhunā","di sini"],["حَمِيمٌۭ","ḥamīmun","seorang teman"]]},{"t":"Dan tidak ada makanan (baginya) kecuali dari darah dan nanah.","w":[["وَلَا","walā","dan tidak ada"],["طَعَامٌ","ṭaʿāmun","makanan"],["إِلَّا","illā","kecuali"],["مِنْ","min","dari"],["غِسْلِينٍۢ","ghis'līnin","kotoran/nanah dan darah"]]},{"t":"Tidak ada yang memakannya kecuali orang-orang yang berdosa.","w":[["لَّا","lā","tidak ada"],["يَأْكُلُهُۥٓ","yakuluhu","yang memakannya"],["إِلَّا","illā","kecuali"],["ٱلْخَـٰطِـُٔونَ","l-khāṭiūna","orang-orang yang bersalah/berdosa"]]},{"t":"Maka Aku bersumpah demi apa yang kamu lihat,","w":[["فَلَآ","falā","maka"],["أُقْسِمُ","uq'simu","Aku bersumpah"],["بِمَا","bimā","dengan apa"],["تُبْصِرُونَ","tub'ṣirūna","kamu lihat"]]},{"t":"dan demi apa yang tidak kamu lihat.","w":[["وَمَا","wamā","dan apa yang"],["لَا","lā","tidak"],["تُبْصِرُونَ","tub'ṣirūna","kamu lihat"]]},{"t":"Sesungguhnya ia (Alquran) benar-benar wahyu (yang diturunkan kepada) Rasul yang mulia,","w":[["إِنَّهُۥ","innahu","sesungguhnya ia (Al Qur'an)"],["لَقَوْلُ","laqawlu","benar-benar perkataan"],["رَسُولٍۢ","rasūlin","rasul"],["كَرِيمٍۢ","karīmin","yang mulia"]]},{"t":"dan ia (Alquran) bukanlah perkataan seorang penyair. Sedikit sekali kamu yang beriman kepadanya.","w":[["وَمَا","wamā","dan tidaklah"],["هُوَ","huwa","ia (Al Qur'an)"],["بِقَوْلِ","biqawli","dengan perkataan"],["شَاعِرٍۢ ۚ","shāʿirin","seorang penyair"],["قَلِيلًۭا","qalīlan","sedikit"],["مَّا","mā","tidak"],["تُؤْمِنُونَ","tu'minūna","kamu beriman"]]},{"t":"Dan bukan pula perkataan tukang tenung. Sedikit sekali kamu yang mengambil pelajaran darinya.","w":[["وَلَا","walā","dan tidak"],["بِقَوْلِ","biqawli","perkataan"],["كَاهِنٍۢ ۚ","kāhinin","dukun/tukang tenung"],["قَلِيلًۭا","qalīlan","sedikit"],["مَّا","mā","tidak"],["تَذَكَّرُونَ","tadhakkarūna","kamu ingat mengambil pelajaran"]]},{"t":"Ia (Alquran) adalah wahyu yang diturunkan dari Tuhan seluruh alam.","w":[["تَنزِيلٌۭ","tanzīlun","diturunkan"],["مِّن","min","dari"],["رَّبِّ","rabbi","Tuhan"],["ٱلْعَـٰلَمِينَ","l-ʿālamīna","semesta alam"]]},{"t":"Dan sekiranya dia (Muhammad) mengada-adakan sebagian perkataan atas (nama) Kami,","w":[["وَلَوْ","walaw","dan seandaiannya"],["تَقَوَّلَ","taqawwala","dia mengadakan perkataan"],["عَلَيْنَا","ʿalaynā","atas Kami"],["بَعْضَ","baʿḍa","sebagian"],["ٱلْأَقَاوِيلِ","l-aqāwīli","perkataan"]]},{"t":"pasti Kami pegang dia pada tangan kanannya.","w":[["لَأَخَذْنَا","la-akhadhnā","niscaya Kami ambil"],["مِنْهُ","min'hu","darinya"],["بِٱلْيَمِينِ","bil-yamīni","dengan tangan kanan"]]},{"t":"Kemudian Kami potong pembuluh jantungnya.","w":[["ثُمَّ","thumma","kemudian"],["لَقَطَعْنَا","laqaṭaʿnā","pasti Kami potong"],["مِنْهُ","min'hu","daripadanya"],["ٱلْوَتِينَ","l-watīna","urat jantung"]]},{"t":"Maka tidak seorang pun dari kamu yang dapat menghalangi (Kami untuk menghukumnya).","w":[["فَمَا","famā","maka tidak"],["مِنكُم","minkum","dari kamu"],["مِّنْ","min","dari"],["أَحَدٍ","aḥadin","seorang"],["عَنْهُ","ʿanhu","daripadanya"],["حَـٰجِزِينَ","ḥājizīna","orang-orang yang menahan/menghalangi"]]},{"t":"Dan sungguh, Alquran itu pelajaran bagi orang-orang yang bertakwa.","w":[["وَإِنَّهُۥ","wa-innahu","dan sesungguhnya"],["لَتَذْكِرَةٌۭ","latadhkiratun","benar-benar peringatan"],["لِّلْمُتَّقِينَ","lil'muttaqīna","bagi orang-orang yang bertakwa"]]},{"t":"Dan sungguh, Kami mengetahui bahwa di antara kamu ada orang yang mendustakan.","w":[["وَإِنَّا","wa-innā","dan sesungguhnya Kami"],["لَنَعْلَمُ","lanaʿlamu","benar-benar Kami mengetahui"],["أَنَّ","anna","bahwa"],["مِنكُم","minkum","diantara kamu"],["مُّكَذِّبِينَ","mukadhibīna","orang-orang yang mendustakan"]]},{"t":"Dan sungguh, Alquran itu akan menimbulkan penyesalan bagi orang-orang kafir (di akhirat).","w":[["وَإِنَّهُۥ","wa-innahu","dan sesungguhnya ia (Al Qur'an)"],["لَحَسْرَةٌ","laḥasratun","benar-benar penyesalan"],["عَلَى","ʿalā","atas"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","orang-orang kafir"]]},{"t":"Dan sungguh, Alquran itu kebenaran yang meyakinkan.","w":[["وَإِنَّهُۥ","wa-innahu","dan sesungguhnya (Al Qur'an)"],["لَحَقُّ","laḥaqqu","nyata-nyata kebenaran"],["ٱلْيَقِينِ","l-yaqīni","yang diyakini"]]},{"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahaagung.","w":[["فَسَبِّحْ","fasabbiḥ","maka bertasbihlah"],["بِٱسْمِ","bi-is'mi","dengan nama"],["رَبِّكَ","rabbika","Tuhanmu"],["ٱلْعَظِيمِ","l-ʿaẓīmi","Maha Besar/Agung"]]}]}