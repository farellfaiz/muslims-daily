{"n":78,"ayat":[{"t":"Tentang apakah mereka saling bertanya-tanya?","w":[["عَمَّ","ʿamma","dari/tentang"],["يَتَسَآءَلُونَ","yatasāalūna","mereka saling bertanya"]]},{"t":"Tentang berita yang besar (hari berbangkit),","w":[["عَنِ","ʿani","dari/tentang"],["ٱلنَّبَإِ","l-naba-i","berita"],["ٱلْعَظِيمِ","l-ʿaẓīmi","besar"]]},{"t":"yang dalam hal itu mereka berselisih.","w":[["ٱلَّذِى","alladhī","yang"],["هُمْ","hum","mereka"],["فِيهِ","fīhi","di dalamnya/tentang itu"],["مُخْتَلِفُونَ","mukh'talifūna","orang yang berselisih"]]},{"t":"Tidak! Kelak mereka akan mengetahui,","w":[["كَلَّا","kallā","jangan begitu/sekali-kali tidak"],["سَيَعْلَمُونَ","sayaʿlamūna","kelak mereka akan mengetahui"]]},{"t":"sekali lagi tidak! Kelak mereka akan mengetahui.","w":[["ثُمَّ","thumma","kemudian"],["كَلَّا","kallā","jangan begitu/sekali-kali tidak"],["سَيَعْلَمُونَ","sayaʿlamūna","kelak mereka akan mengetahui"]]},{"t":"Bukankah Kami telah menjadikan bumi sebagai hamparan,","w":[["أَلَمْ","alam","tidaklah/bukanlah"],["نَجْعَلِ","najʿali","Kami telah menjadikan"],["ٱلْأَرْضَ","l-arḍa","bumi"],["مِهَـٰدًۭا","mihādan","hamparan"]]},{"t":"dan gunung-gunung sebagai pasak?","w":[["وَٱلْجِبَالَ","wal-jibāla","dan gunung-gunung"],["أَوْتَادًۭا","awtādan","pancang/pasak"]]},{"t":"Dan Kami menciptakan kamu berpasang-pasangan,","w":[["وَخَلَقْنَـٰكُمْ","wakhalaqnākum","dan Kami menciptakan kamu"],["أَزْوَٰجًۭا","azwājan","berpasang-pasangan/jodoh"]]},{"t":"dan Kami menjadikan tidurmu untuk istirahat,","w":[["وَجَعَلْنَا","wajaʿalnā","dan Kami jadikan"],["نَوْمَكُمْ","nawmakum","tidurmu"],["سُبَاتًۭا","subātan","istirahat"]]},{"t":"dan Kami menjadikan malam sebagai pakaian,","w":[["وَجَعَلْنَا","wajaʿalnā","dan Kami jadikan"],["ٱلَّيْلَ","al-layla","malam"],["لِبَاسًۭا","libāsan","pakaian"]]},{"t":"dan Kami menjadikan siang untuk mencari penghidupan,","w":[["وَجَعَلْنَا","wajaʿalnā","dan Kami jadikan"],["ٱلنَّهَارَ","l-nahāra","siang"],["مَعَاشًۭا","maʿāshan","penghidupan"]]},{"t":"dan Kami membangun di atas kamu tujuh (lapis langit) yang kokoh,","w":[["وَبَنَيْنَا","wabanaynā","dan Kami bina"],["فَوْقَكُمْ","fawqakum","di atas kamu"],["سَبْعًۭا","sabʿan","tujuh"],["شِدَادًۭا","shidādan","kuat/kokoh"]]},{"t":"dan Kami menjadikan pelita yang terang-benderang (matahari),","w":[["وَجَعَلْنَا","wajaʿalnā","dan Kami jadikan"],["سِرَاجًۭا","sirājan","pelita"],["وَهَّاجًۭا","wahhājan","sangat terang"]]},{"t":"dan Kami turunkan dari awan, air hujan yang tercurah dengan lebatnya,","w":[["وَأَنزَلْنَا","wa-anzalnā","dan Kami turunkan"],["مِنَ","mina","dari"],["ٱلْمُعْصِرَٰتِ","l-muʿ'ṣirāti","awan"],["مَآءًۭ","māan","air"],["ثَجَّاجًۭا","thajjājan","tercurah"]]},{"t":"untuk Kami tumbuhkan dengan air itu biji-bijian dan tanam-tanaman,","w":[["لِّنُخْرِجَ","linukh'rija","karena Kami hendak mengeluarkan"],["بِهِۦ","bihi","dengannya/dengan air"],["حَبًّۭا","ḥabban","biji-bijian"],["وَنَبَاتًۭا","wanabātan","dan tumbuh-tumbuhan"]]},{"t":"dan kebun-kebun yang rindang.","w":[["وَجَنَّـٰتٍ","wajannātin","dan kebun-kebun/surga"],["أَلْفَافًا","alfāfan","lebat"]]},{"t":"Sungguh, hari keputusan adalah suatu waktu yang telah ditetapkan,","w":[["إِنَّ","inna","sesungguhnya"],["يَوْمَ","yawma","hari"],["ٱلْفَصْلِ","l-faṣli","keputusan"],["كَانَ","kāna","adalah ia"],["مِيقَـٰتًۭا","mīqātan","waktu yang ditentukan"]]},{"t":"(yaitu) pada hari (ketika) sangkakala ditiup, lalu kamu datang berbondong-bondong,","w":[["يَوْمَ","yawma","hari"],["يُنفَخُ","yunfakhu","ditiup"],["فِى","fī","dalam/pada"],["ٱلصُّورِ","l-ṣūri","sangkakala"],["فَتَأْتُونَ","fatatūna","maka kamu datang"],["أَفْوَاجًۭا","afwājan","berduyun-duyun"]]},{"t":"dan langit pun dibukalah, maka terdapatlah beberapa pintu,","w":[["وَفُتِحَتِ","wafutiḥati","dan dibukakan"],["ٱلسَّمَآءُ","l-samāu","langit"],["فَكَانَتْ","fakānat","maka jadilah ia"],["أَبْوَٰبًۭا","abwāban","pintu-pintu"]]},{"t":"dan gunung-gunungpun dijalankan sehingga menjadi fatamorgana.","w":[["وَسُيِّرَتِ","wasuyyirati","dan dijalankan/dihapuskan"],["ٱلْجِبَالُ","l-jibālu","gunung-gunung"],["فَكَانَتْ","fakānat","maka jadilah ia"],["سَرَابًا","sarāban","fatamorgana"]]},{"t":"Sungguh, (neraka) Jahanam itu (sebagai) tempat mengintai (bagi penjaga yang mengawasi isi neraka),","w":[["إِنَّ","inna","sesungguhnya"],["جَهَنَّمَ","jahannama","Jahanam"],["كَانَتْ","kānat","adalah ia"],["مِرْصَادًۭا","mir'ṣādan","tempat penantian/disediakan"]]},{"t":"menjadi tempat kembali bagi orang-orang yang melampaui batas.","w":[["لِّلطَّـٰغِينَ","lilṭṭāghīna","bagi orang-orang yang melampui batas"],["مَـَٔابًۭا","maāban","tempat kembali"]]},{"t":"Mereka tinggal di sana dalam masa yang lama,","w":[["لَّـٰبِثِينَ","lābithīna","mereka tinggal"],["فِيهَآ","fīhā","didalamnya"],["أَحْقَابًۭا","aḥqāban","beberapa lama"]]},{"t":"mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,","w":[["لَّا","lā","tidak"],["يَذُوقُونَ","yadhūqūna","merasakan"],["فِيهَا","fīhā","di dalamnya"],["بَرْدًۭا","bardan","kesejukan"],["وَلَا","walā","dan tidak"],["شَرَابًا","sharāban","minuman"]]},{"t":"selain air yang mendidih dan nanah,","w":[["إِلَّا","illā","kecuali"],["حَمِيمًۭا","ḥamīman","air yang mendidih"],["وَغَسَّاقًۭا","waghassāqan","dan air luka dan nanah"]]},{"t":"sebagai pembalasan yang setimpal.","w":[["جَزَآءًۭ","jazāan","pembalasan"],["وِفَاقًا","wifāqan","setimpal"]]},{"t":"Sesungguhnya dahulu mereka tidak pernah mengharapkan perhitungan,","w":[["إِنَّهُمْ","innahum","sesungguhnya mereka"],["كَانُوا۟","kānū","adalah mereka"],["لَا","lā","tidak"],["يَرْجُونَ","yarjūna","mengharapkan"],["حِسَابًۭا","ḥisāban","perhitungan"]]},{"t":"dan mereka benar-benar mendustakan ayat-ayat Kami.","w":[["وَكَذَّبُوا۟","wakadhabū","dan mereka mendustakan"],["بِـَٔايَـٰتِنَا","biāyātinā","dengan ayat-ayat Kami"],["كِذَّابًۭا","kidhāban","sangat dusta"]]},{"t":"Dan segala sesuatu telah Kami catat dalam suatu Kitab (buku catatan amalan manusia).","w":[["وَكُلَّ","wakulla","dan tiap-tiap/segala"],["شَىْءٍ","shayin","sesuatu"],["أَحْصَيْنَـٰهُ","aḥṣaynāhu","Kami telah mengumpulkannya"],["كِتَـٰبًۭا","kitāban","suatu kitab"]]},{"t":"Maka karena itu rasakanlah! Maka tidak ada yang akan Kami tambahkan kepadamu selain azab.","w":[["فَذُوقُوا۟","fadhūqū","maka rasakanlah"],["فَلَن","falan","maka tidak"],["نَّزِيدَكُمْ","nazīdakum","Kami menambah kamu"],["إِلَّا","illā","kecuali/selain"],["عَذَابًا","ʿadhāban","azab"]]},{"t":"Sungguh, orang-orang yang bertakwa mendapat kemenangan,","w":[["إِنَّ","inna","sesungguhnya"],["لِلْمُتَّقِينَ","lil'muttaqīna","bagi orang-orang yang bertaqwa"],["مَفَازًا","mafāzan","keuntungan"]]},{"t":"(yaitu) kebun-kebun dan buah anggur,","w":[["حَدَآئِقَ","ḥadāiqa","kebun-kebun"],["وَأَعْنَـٰبًۭا","wa-aʿnāban","dan buah anggur"]]},{"t":"dan gadis-gadis belia yang sebaya,","w":[["وَكَوَاعِبَ","wakawāʿiba","dan gadis-gadis"],["أَتْرَابًۭا","atrāban","sebaya"]]},{"t":"dan gelas-gelas yang penuh (berisi minuman).","w":[["وَكَأْسًۭا","wakasan","dan piala/gelas-gelas"],["دِهَاقًۭا","dihāqan","yang penuh"]]},{"t":"Di sana mereka tidak mendengar percakapan yang sia-sia maupun (perkataan dusta).","w":[["لَّا","lā","tidak"],["يَسْمَعُونَ","yasmaʿūna","mereka mendengar"],["فِيهَا","fīhā","di dalamnya"],["لَغْوًۭا","laghwan","sia-sia"],["وَلَا","walā","dan tidak"],["كِذَّٰبًۭا","kidhāban","dusta"]]},{"t":"Sebagai balasan dan pemberian yang cukup banyak dari Tuhanmu,","w":[["جَزَآءًۭ","jazāan","balasan"],["مِّن","min","dari"],["رَّبِّكَ","rabbika","Tuhanmu"],["عَطَآءً","ʿaṭāan","pemberian"],["حِسَابًۭا","ḥisāban","perhitungan/cukup"]]},{"t":"Tuhan (yang memelihara) langit dan bumi serta apa yang ada di antara keduanya; Yang Maha Pengasih, mereka tidak mampu berbicara dengan Dia.","w":[["رَّبِّ","rabbi","Tuhan/Pemelihara"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["وَٱلْأَرْضِ","wal-arḍi","dan bumi"],["وَمَا","wamā","dan apa"],["بَيْنَهُمَا","baynahumā","diantara keduanya"],["ٱلرَّحْمَـٰنِ ۖ","l-raḥmāni","Yang Maha Pengasih"],["لَا","lā","tidak"],["يَمْلِكُونَ","yamlikūna","mereka kuasa"],["مِنْهُ","min'hu","daripadaNya/dengan Dia"],["خِطَابًۭا","khiṭāban","bicara"]]},{"t":"Pada hari, ketika rūḥ dan para malaikat berdiri bersaf-saf, mereka tidak berkata-kata, kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pengasih dan dia hanya mengatakan yang benar.","w":[["يَوْمَ","yawma","hari"],["يَقُومُ","yaqūmu","berdiri"],["ٱلرُّوحُ","l-rūḥu","ruh"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","dan malaikat"],["صَفًّۭا ۖ","ṣaffan","berbaris"],["لَّا","lā","tidak"],["يَتَكَلَّمُونَ","yatakallamūna","merekaberkata-kata"],["إِلَّا","illā","kecuali"],["مَنْ","man","siapa/orang"],["أَذِنَ","adhina","memberi izin"],["لَهُ","lahu","kepadanya"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","Yang Maha Pengasih"],["وَقَالَ","waqāla","dan berkata"],["صَوَابًۭا","ṣawāban","yang benar"]]},{"t":"Itulah hari yang pasti terjadi. Maka barangsiapa menghendaki, niscaya dia menempuh jalan kembali kepada Tuhannya.","w":[["ذَٰلِكَ","dhālika","demikian/itu"],["ٱلْيَوْمُ","l-yawmu","hari"],["ٱلْحَقُّ ۖ","l-ḥaqu","hak/benar"],["فَمَن","faman","maka barang siapa"],["شَآءَ","shāa","ia menghendaki"],["ٱتَّخَذَ","ittakhadha","ia mengambil"],["إِلَىٰ","ilā","kepada"],["رَبِّهِۦ","rabbihi","Tuhannya"],["مَـَٔابًا","maāban","tempat kembali"]]},{"t":"Sesungguhnya Kami telah memperingatkan kepadamu (orang kafir) azab yang dekat, pada hari manusia melihat apa yang telah diperbuat oleh kedua tangannya; dan orang kafir berkata, \"Alangkah baiknya seandainya dahulu aku jadi tanah.\"","w":[["إِنَّآ","innā","sesungguhnya Kami"],["أَنذَرْنَـٰكُمْ","andharnākum","Kami memberi peringatan kepadamu"],["عَذَابًۭا","ʿadhāban","azab"],["قَرِيبًۭا","qarīban","dekat"],["يَوْمَ","yawma","hari"],["يَنظُرُ","yanẓuru","melihat"],["ٱلْمَرْءُ","l-maru","seseorang"],["مَا","mā","apa"],["قَدَّمَتْ","qaddamat","mendahului/diperbuat"],["يَدَاهُ","yadāhu","kedua tangannya"],["وَيَقُولُ","wayaqūlu","dan berkata"],["ٱلْكَافِرُ","l-kāfiru","orang kafir"],["يَـٰلَيْتَنِى","yālaytanī","alangkah baiknya aku dulu"],["كُنتُ","kuntu","adalah aku"],["تُرَٰبًۢا","turāban","debu/tanah"]]}]}