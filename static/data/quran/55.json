{"n":55,"ayat":[{"t":"(Allah) Yang Maha Pengasih,","w":[["ٱلرَّحْمَـٰنُ","al-raḥmānu","Yang Maha Pengasih"]]},{"t":"Yang telah mengajarkan Alquran.","w":[["عَلَّمَ","ʿallama","Dia telah mengajarkan"],["ٱلْقُرْءَانَ","l-qur'āna","Al Quran"]]},{"t":"Dia menciptakan manusia,","w":[["خَلَقَ","khalaqa","Dia telah menciptakan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"]]},{"t":"mengajarnya pandai berbicara.","w":[["عَلَّمَهُ","ʿallamahu","Dia mengajarkannya"],["ٱلْبَيَانَ","l-bayāna","jelas/terang"]]},{"t":"Matahari dan bulan beredar menurut perhitungan,","w":[["ٱلشَّمْسُ","al-shamsu","matahari"],["وَٱلْقَمَرُ","wal-qamaru","dan bulan"],["بِحُسْبَانٍۢ","biḥus'bānin","dengan/menurut perhitungan"]]},{"t":"Bintang dan pepohonan, keduanya tunduk (kepada-Nya).","w":[["وَٱلنَّجْمُ","wal-najmu","dan bintang/tumbuh-tumbuhan"],["وَٱلشَّجَرُ","wal-shajaru","dan pohon-pohonan"],["يَسْجُدَانِ","yasjudāni","keduanya tunduk/sujud"]]},{"t":"Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,","w":[["وَٱلسَّمَآءَ","wal-samāa","dan langit"],["رَفَعَهَا","rafaʿahā","Dia tinggikannya"],["وَوَضَعَ","wawaḍaʿa","dan Dia letakkan"],["ٱلْمِيزَانَ","l-mīzāna","timbangan"]]},{"t":"agar kamu jangan merusak keseimbangan itu.","w":[["أَلَّا","allā","supaya jangan"],["تَطْغَوْا۟","taṭghaw","kamu melampui batas"],["فِى","fī","dalam"],["ٱلْمِيزَانِ","l-mīzāni","neraca/timbangan"]]},{"t":"Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu.","w":[["وَأَقِيمُوا۟","wa-aqīmū","dan dirikanlah"],["ٱلْوَزْنَ","l-wazna","neraca/timbangan"],["بِٱلْقِسْطِ","bil-qis'ṭi","dengan adil"],["وَلَا","walā","dan janganlah"],["تُخْسِرُوا۟","tukh'sirū","kamu mengurangi"],["ٱلْمِيزَانَ","l-mīzāna","neraca/timbangan"]]},{"t":"Dan bumi telah dibentangkan-Nya untuk makhluk(-Nya),","w":[["وَٱلْأَرْضَ","wal-arḍa","dan bumi"],["وَضَعَهَا","waḍaʿahā","Dia letakkan/hamparkannya"],["لِلْأَنَامِ","lil'anāmi","untuk makhluk"]]},{"t":"di dalamnya ada buah-buahan dan pohon kurma yang mempunyai kelopak mayang,","w":[["فِيهَا","fīhā","didalamnya/padanya"],["فَـٰكِهَةٌۭ","fākihatun","buah-buahan"],["وَٱلنَّخْلُ","wal-nakhlu","dan pohon kurma"],["ذَاتُ","dhātu","yang mempunyai"],["ٱلْأَكْمَامِ","l-akmāmi","kelopak mayang"]]},{"t":"dan biji-bijian yang berkulit dan bunga-bunga yang harum baunya.","w":[["وَٱلْحَبُّ","wal-ḥabu","dan biji-bijian"],["ذُو","dhū","mempunyai"],["ٱلْعَصْفِ","l-ʿaṣfi","kulit"],["وَٱلرَّيْحَانُ","wal-rayḥānu","dan harum baunya"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Dia menciptakan manusia dari tanah kering seperti tembikar,","w":[["خَلَقَ","khalaqa","Dia menciptakan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["مِن","min","dari"],["صَلْصَـٰلٍۢ","ṣalṣālin","tanah liat"],["كَٱلْفَخَّارِ","kal-fakhāri","seperti tembikar"]]},{"t":"dan Dia menciptakan jin dari nyala api tanpa asap.","w":[["وَخَلَقَ","wakhalaqa","dan Dia menciptakan"],["ٱلْجَآنَّ","l-jāna","jin"],["مِن","min","dari"],["مَّارِجٍۢ","mārijin","nyala api"],["مِّن","min","dari"],["نَّارٍۢ","nārin","api"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhan kamu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Tuhan (yang memelihara) dua Timur dan Tuhan (yang memelihara) dua Barat.","w":[["رَبُّ","rabbu","Tuhan/Pemelihara"],["ٱلْمَشْرِقَيْنِ","l-mashriqayni","dua timur/dua tempat terbit matahari"],["وَرَبُّ","warabbu","dan Tuhan/Pemelihara"],["ٱلْمَغْرِبَيْنِ","l-maghribayni","dua barat/dua tempat terbenamnya matahari"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Dia membiarkan dua laut mengalir yang (kemudian) keduanya bertemu,","w":[["مَرَجَ","maraja","Dia alirkan"],["ٱلْبَحْرَيْنِ","l-baḥrayni","dua lautan"],["يَلْتَقِيَانِ","yaltaqiyāni","keduanya bertemu"]]},{"t":"di antara keduanya ada batas yang tidak dilampaui oleh masing-masing.","w":[["بَيْنَهُمَا","baynahumā","diantara keduanya"],["بَرْزَخٌۭ","barzakhun","batas"],["لَّا","lā","tidak"],["يَبْغِيَانِ","yabghiyāni","keduanya melampui"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","nikmat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Dari keduanya keluar mutiara dan marjan.","w":[["يَخْرُجُ","yakhruju","keluar"],["مِنْهُمَا","min'humā","dari keduanya"],["ٱللُّؤْلُؤُ","l-lu'lu-u","mutiara"],["وَٱلْمَرْجَانُ","wal-marjānu","dan marjan"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua mendustakan"]]},{"t":"Milik-Nyalah kapal-kapal yang berlayar di lautan bagaikan gunung-gunung.","w":[["وَلَهُ","walahu","dan bagi-Nya"],["ٱلْجَوَارِ","l-jawāri","kapal-kapal"],["ٱلْمُنشَـَٔاتُ","l-munshaātu","yang timbul/tinggi"],["فِى","fī","pada"],["ٱلْبَحْرِ","l-baḥri","lautan"],["كَٱلْأَعْلَـٰمِ","kal-aʿlāmi","laksana gunung-gunung"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Semua yang ada di bumi itu akan binasa,","w":[["كُلُّ","kullu","tiap-tiap/segala"],["مَنْ","man","siapa/apa"],["عَلَيْهَا","ʿalayhā","atasnya"],["فَانٍۢ","fānin","binasa"]]},{"t":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal.","w":[["وَيَبْقَىٰ","wayabqā","dan tetap/kekal"],["وَجْهُ","wajhu","wajah/zat"],["رَبِّكَ","rabbika","Tuhanmu"],["ذُو","dhū","mempunyai"],["ٱلْجَلَـٰلِ","l-jalāli","kebesaran"],["وَٱلْإِكْرَامِ","wal-ik'rāmi","dan kemuliaan"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan.","w":[["يَسْـَٔلُهُۥ","yasaluhu","akan meminta kepada-Nya"],["مَن","man","orang/makhluk"],["فِى","fī","pada"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["وَٱلْأَرْضِ ۚ","wal-arḍi","dan bumi"],["كُلَّ","kulla","setiap"],["يَوْمٍ","yawmin","hari"],["هُوَ","huwa","Dia"],["فِى","fī","pada"],["شَأْنٍۢ","shanin","kesibukan/urusan"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!","w":[["سَنَفْرُغُ","sanafrughu","Kami akan berurusan/bertindak"],["لَكُمْ","lakum","bagi kalian"],["أَيُّهَ","ayyuha","wahai"],["ٱلثَّقَلَانِ","l-thaqalāni","manusia dan jin"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","nikmat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah).","w":[["يَـٰمَعْشَرَ","yāmaʿshara","hai jama'ah"],["ٱلْجِنِّ","l-jini","jin"],["وَٱلْإِنسِ","wal-insi","dan manusia"],["إِنِ","ini","jika"],["ٱسْتَطَعْتُمْ","is'taṭaʿtum","kamu mampu/sanggup"],["أَن","an","bahwa"],["تَنفُذُوا۟","tanfudhū","kamu menembus/melintasi"],["مِنْ","min","dari"],["أَقْطَارِ","aqṭāri","penjuru"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","langit(jamak)"],["وَٱلْأَرْضِ","wal-arḍi","dan bumi"],["فَٱنفُذُوا۟ ۚ","fa-unfudhū","maka tembuslah/lintasilah"],["لَا","lā","tidak"],["تَنفُذُونَ","tanfudhūna","kamu menembusnya"],["إِلَّا","illā","kecuali"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","dengan kekuasaan/kekuatan"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya).","w":[["يُرْسَلُ","yur'salu","akan dikirimkan"],["عَلَيْكُمَا","ʿalaykumā","atas kamu berdua"],["شُوَاظٌۭ","shuwāẓun","nyala"],["مِّن","min","dari"],["نَّارٍۢ","nārin","api"],["وَنُحَاسٌۭ","wanuḥāsun","dan cairan tembaga"],["فَلَا","falā","maka tidak"],["تَنتَصِرَانِ","tantaṣirāni","kamu berdua menolong/menyelamatkan diri"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Maka apabila langit telah terbelah dan menjadi merah mawar seperti (kilauan) minyak.","w":[["فَإِذَا","fa-idhā","maka apabila"],["ٱنشَقَّتِ","inshaqqati","terbelah"],["ٱلسَّمَآءُ","l-samāu","langit"],["فَكَانَتْ","fakānat","lalu adalah/menjadi ia"],["وَرْدَةًۭ","wardatan","mawar merah"],["كَٱلدِّهَانِ","kal-dihāni","seperti minyak"]]},{"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang mana"],["ءَالَآءِ","ālāi","ni'mat"],["رَبِّكُمَا","rabbikumā","Tuhanmu berdua"],["تُكَذِّبَانِ","tukadhibāni","kamu berdua dustakan"]]},{"t":"Maka pada hari itu manusia