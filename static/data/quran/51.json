{"n":51,"ayat":[{"t":"Demi (angin) yang menerbangkan debu,","w":[["وَٱلذَّٰرِيَـٰتِ","wal-dhāriyāti","demi yang menerbangkan"],["ذَرْوًۭا","dharwan","dengan menerbangkan sekuat-kuatnya"]]},{"t":"dan awan yang mengandung (hujan),","w":[["فَٱلْحَـٰمِلَـٰتِ","fal-ḥāmilāti","maka yang mengandung"],["وِقْرًۭا","wiq'ran","beban berat"]]},{"t":"dan (kapal-kapal) yang berlayar dengan mudah,","w":[["فَٱلْجَـٰرِيَـٰتِ","fal-jāriyāti","maka yang berlayar"],["يُسْرًۭا","yus'ran","dengan mudah"]]},{"t":"dan (malaikat-malaikat) yang membagi-bagi urusan,","w":[["فَٱلْمُقَسِّمَـٰتِ","fal-muqasimāti","maka yang membagi"],["أَمْرًا","amran","pekara/urusan"]]},{"t":"sungguh, apa yang dijanjikan kepadamu pasti benar,","w":[["إِنَّمَا","innamā","sesungguhnya hanyalah"],["تُوعَدُونَ","tūʿadūna","kamu dijanjikan"],["لَصَادِقٌۭ","laṣādiqun","pasti benar"]]},{"t":"dan sungguh, (hari) pembalasan pasti terjadi.","w":[["وَإِنَّ","wa-inna","dan sesungguhnya"],["ٱلدِّينَ","l-dīna","pembalasan"],["لَوَٰقِعٌۭ","lawāqiʿun","pasti terjadi"]]},{"t":"Demi langit yang mempunyai jalan-jalan,","w":[["وَٱلسَّمَآءِ","wal-samāi","demi langit"],["ذَاتِ","dhāti","mempunyai"],["ٱلْحُبُكِ","l-ḥubuki","jalan-jalan"]]},{"t":"sungguh, kamu benar-benar dalam keadaan berbeda-beda pendapat,","w":[["إِنَّكُمْ","innakum","sesungguhnya kalian"],["لَفِى","lafī","benar-benar dalam"],["قَوْلٍۢ","qawlin","perkataan"],["مُّخْتَلِفٍۢ","mukh'talifin","berbeda-beda"]]},{"t":"dipalingkan darinya (Alquran dan Rasul) orang yang dipalingkan.","w":[["يُؤْفَكُ","yu'faku","dipalingkan"],["عَنْهُ","ʿanhu","darinya"],["مَنْ","man","orang yang"],["أُفِكَ","ufika","dipalingkan"]]},{"t":"Terkutuklah orang-orang yang banyak berdusta,","w":[["قُتِلَ","qutila","dibunuh"],["ٱلْخَرَّٰصُونَ","l-kharāṣūna","orang-orang yang banyak berdusta"]]},{"t":"(yaitu) orang-orang yang terbenam dalam kebodohan dan kelalaian,","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["هُمْ","hum","mereka"],["فِى","fī","dalam"],["غَمْرَةٍۢ","ghamratin","kebodohan"],["سَاهُونَ","sāhūna","orang-orang yang lalai"]]},{"t":"mereka bertanya, \"Kapankah hari pembalasan itu?\"","w":[["يَسْـَٔلُونَ","yasalūna","mereka bertanya"],["أَيَّانَ","ayyāna","kapankah"],["يَوْمُ","yawmu","hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"(Hari pembalasan itu ialah) pada hari (ketika) mereka diazab di dalam api neraka.","w":[["يَوْمَ","yawma","pada hari"],["هُمْ","hum","mereka"],["عَلَى","ʿalā","di atas"],["ٱلنَّارِ","l-nāri","neraka"],["يُفْتَنُونَ","yuf'tanūna","mereka disiksa"]]},{"t":"(Dikatakan kepada mereka), \"Rasakanlah azabmu itu. Inilah azab yang dahulu kamu minta agar disegerakan.\"","w":[["ذُوقُوا۟","dhūqū","rasakanlah"],["فِتْنَتَكُمْ","fit'natakum","siksaanmu"],["هَـٰذَا","hādhā","ini"],["ٱلَّذِى","alladhī","yang"],["كُنتُم","kuntum","kalian adalah"],["بِهِۦ","bihi","dengannya"],["تَسْتَعْجِلُونَ","tastaʿjilūna","kamu minta disegerakan"]]},{"t":"Sesungguhnya orang-orang yang bertakwa berada di dalam taman-taman (surga) dan mata air,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْمُتَّقِينَ","l-mutaqīna","orang-orang yang bertakwa"],["فِى","fī","dalam"],["جَنَّـٰتٍۢ","jannātin","surga"],["وَعُيُونٍ","waʿuyūnin","dan mata air"]]},{"t":"mereka mengambil apa yang diberikan Tuhan kepada mereka. Sesungguhnya mereka sebelum itu (di dunia) adalah orang-orang yang berbuat baik;","w":[["ءَاخِذِينَ","ākhidhīna","mereka mengambil"],["مَآ","mā","apa yang"],["ءَاتَىٰهُمْ","ātāhum","memberikan pada mereka"],["رَبُّهُمْ ۚ","rabbuhum","Tuhan mereka"],["إِنَّهُمْ","innahum","sesungguhnya mereka"],["كَانُوا۟","kānū","adalah mereka"],["قَبْلَ","qabla","sebelum"],["ذَٰلِكَ","dhālika","demikian itu"],["مُحْسِنِينَ","muḥ'sinīna","orang-orang yang berbuat baik"]]},{"t":"mereka sedikit sekali tidur pada waktu malam;","w":[["كَانُوا۟","kānū","adalah mereka"],["قَلِيلًۭا","qalīlan","sedikit"],["مِّنَ","mina","dari/di waktu"],["ٱلَّيْلِ","al-layli","malam"],["مَا","mā","tidak"],["يَهْجَعُونَ","yahjaʿūna","mereka tidur"]]},{"t":"dan pada akhir malam mereka memohon ampunan (kepada Allah).","w":[["وَبِٱلْأَسْحَارِ","wabil-asḥāri","dan di waktu sahur"],["هُمْ","hum","mereka"],["يَسْتَغْفِرُونَ","yastaghfirūna","mereka mohon ampun"]]},{"t":"Dan pada harta benda mereka ada hak untuk orang miskin yang meminta, dan orang miskin yang tidak meminta.","w":[["وَفِىٓ","wafī","dan dalam"],["أَمْوَٰلِهِمْ","amwālihim","harta mereka"],["حَقٌّۭ","ḥaqqun","hak"],["لِّلسَّآئِلِ","lilssāili","untuk orang yang meminta"],["وَٱلْمَحْرُومِ","wal-maḥrūmi","dan orang yang tidak meminta"]]},{"t":"Dan di bumi terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang yakin,","w":[["وَفِى","wafī","dan di"],["ٱلْأَرْضِ","l-arḍi","bumi itu"],["ءَايَـٰتٌۭ","āyātun","tanda-tanda"],["لِّلْمُوقِنِينَ","lil'mūqinīna","bagi orang-orang yang yakin"]]},{"t":"dan (juga) pada dirimu sendiri. Maka apakah kamu tidak memperhatikan?","w":[["وَفِىٓ","wafī","dan pada"],["أَنفُسِكُمْ ۚ","anfusikum","diri kalian sendiri"],["أَفَلَا","afalā","maka apakah tidak"],["تُبْصِرُونَ","tub'ṣirūna","kamu memperhatikan"]]},{"t":"Dan di langit terdapat (sebab-sebab) rezekimu dan apa yang dijanjikan kepadamu.","w":[["وَفِى","wafī","dan di"],["ٱلسَّمَآءِ","l-samāi","langit"],["رِزْقُكُمْ","riz'qukum","rezekimu"],["وَمَا","wamā","dan apa yang"],["تُوعَدُونَ","tūʿadūna","dijanjikan padamu"]]},{"t":"Maka demi Tuhan langit dan bumi, sungguh, apa yang dijanjikan itu pasti terjadi seperti apa yang kamu ucapkan.","w":[["فَوَرَبِّ","fawarabbi","demi Tuhan"],["ٱلسَّمَآءِ","l-samāi","langit"],["وَٱلْأَرْضِ","wal-arḍi","dan bumi"],["إِنَّهُۥ","innahu","sesungguhnya"],["لَحَقٌّۭ","laḥaqqun","sungguh benar"],["مِّثْلَ","mith'la","seperti"],["مَآ","mā","apa"],["أَنَّكُمْ","annakum","bahwasanya kamu"],["تَنطِقُونَ","tanṭiqūna","kamu ucapkan"]]},{"t":"Sudahkah sampai kepadamu (Muhammad) cerita tamu Ibrahim (malaikat-malaikat) yang dimuliakan?","w":[["هَلْ","hal","apakah"],["أَتَىٰكَ","atāka","telah sampai kepadamu"],["حَدِيثُ","ḥadīthu","cerita"],["ضَيْفِ","ḍayfi","tamu"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim"],["ٱلْمُكْرَمِينَ","l-muk'ramīna","orang-orang yang dimuliakan"]]},{"t":"(Ingatlah) ketika mereka masuk ke tempatnya lalu mengucapkan, \"Salāman (salam)\", Ibrahim menjawab, \"Salāmun (salam)\". (Mereka itu) orang-orang yang belum dikenalnya.","w":[["إِذْ","idh","ketika"],["دَخَلُوا۟","dakhalū","mereka masuk"],["عَلَيْهِ","ʿalayhi","atasnya"],["فَقَالُوا۟","faqālū","lalu mereka berkata"],["سَلَـٰمًۭا ۖ","salāman","selamat"],["قَالَ","qāla","berkata"],["سَلَـٰمٌۭ","salāmun","selamat"],["قَوْمٌۭ","qawmun","kaum"],["مُّنكَرُونَ","munkarūna","orang-orang yang tidak dikenal"]]},{"t":"Maka diam-diam dia (Ibrahim) pergi menemui keluarganya, kemudian dibawanya daging anak sapi gemuk (yang dibakar),","w":[["فَرَاغَ","farāgha","lalu dia pergi diam-diam"],["إِلَىٰٓ","ilā","kepada"],["أَهْلِهِۦ","ahlihi","keluarganya"],["فَجَآءَ","fajāa","lalu dia datang/membawa"],["بِعِجْلٍۢ","biʿij'lin","dengan anak sapi"],["سَمِينٍۢ","samīnin","gemuk"]]},{"t":"lalu dihidangkannya kepada mereka (tetapi mereka tidak mau makan). Ibrahim berkata, \"Mengapa tidak kamu makan.\"","w":[["فَقَرَّبَهُۥٓ","faqarrabahu","lalu dihidangkannya"],["إِلَيْهِمْ","ilayhim","kepada mereka"],["قَالَ","qāla","(Ibrahim)berkata"],["أَلَا","alā","mengapa tidak"],["تَأْكُلُونَ","takulūna","kamu makan"]]},{"t":"Maka dia (Ibrahim) merasa takut terhadap mereka. Mereka berkata, \"Janganlah kamu takut,\" dan mereka memberi kabar gembira kepadanya dengan (kelahiran) seorang anak yang alim (Ishak).","w":[["فَأَوْجَسَ","fa-awjasa","maka dia merasa"],["مِنْهُمْ","min'hum","dari mereka"],["خِيفَةًۭ ۖ","khīfatan","takut"],["قَالُوا۟","qālū","mereka berkata"],["لَا","lā","jangan"],["تَخَفْ ۖ","takhaf","kamu takut"],["وَبَشَّرُوهُ","wabasharūhu","dan mereka memberi kabar gembira"],["بِغُلَـٰمٍ","bighulāmin","dengan seorang anak"],["عَلِيمٍۢ","ʿalīmin","pandai"]]},{"t":"Kemudian istrinya datang memekik (tercengang) lalu menepuk wajahnya sendiri seraya bekata, \"(Aku ini) seorang perempuan tua yang mandul.\"","w":[["فَأَقْبَلَتِ","fa-aqbalati","maka menghadap/datang"],["ٱمْرَأَتُهُۥ","im'ra-atuhu","isterinya"],["فِى","fī","dalam"],["صَرَّةٍۢ","ṣarratin","teriakan"],["فَصَكَّتْ","faṣakkat","lalu ia menampar"],["وَجْهَهَا","wajhahā","mukanya"],["وَقَالَتْ","waqālat","dan berkata"],["عَجُوزٌ","ʿajūzun","seorang perempuan tua"],["عَقِيمٌۭ","ʿaqīmun","mandul"]]},{"t":"Mereka berkata, \"Demikianlah Tuhanmu berfirman. Sungguh, Dialah Yang Mahabijaksana, Maha Mengetahui.\"","w":[["قَالُوا۟","qālū","mereka berkata"],["كَذَٰلِكِ","kadhāliki","demikianlah"],["قَالَ","qāla","berfirman"],["رَبُّكِ ۖ","rabbuki","Tuhanmu"],["إِنَّهُۥ","innahu","sesungguhnya Dia"],["هُوَ","huwa","Dia"],["ٱلْحَكِيمُ","l-ḥakīmu","Maha Bijaksana"],["ٱلْعَلِيمُ","l-ʿalīmu","Maha Mengetahui"]]},{"t":"Dia (Ibrahim) berkata, \"Apakah urusanmu yang penting wahai para utusan?\"","w":[["۞ قَالَ","qāla","(Ibrahim)berkata"],["فَمَا","famā","maka apakah"],["خَطْبُكُمْ","khaṭbukum","pembicaraanmu"],["أَيُّهَا","ayyuhā","wahai"],["ٱلْمُرْسَلُونَ","l-mur'salūna","para utusan"]]},{"t":"Mereka menjawab, \"Sesungguhnya kami diutus kepada kaum yang berdosa (kaum Luṭ),","w":[["قَالُوٓا۟","qālū","mereka berkata"],["إِنَّآ","innā","sesungguhnya kami"],["أُرْسِلْنَآ","ur'sil'nā","kami di utus"],["إِلَىٰ","ilā","kepada"],["قَوْمٍۢ","qawmin","kaum"],["مُّجْرِمِينَ","muj'rimīna","orang-orang yang berdosa"]]},{"t":"agar kami menimpa mereka dengan batu-batu dari tanah (yang keras),","w":[["لِنُرْسِلَ","linur'sila","agar kami kirimkan"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["حِجَارَةًۭ","ḥijāratan","batu-batu"],["مِّن","min","dari"],["طِينٍۢ","ṭīnin","tanah"]]},{"t":"yang ditandai dari Tuhanmu untuk (membinasakan) orang-orang yang melampaui batas.\"","w":[["مُّسَوَّمَةً","musawwamatan","yang ditandai"],["عِندَ","ʿinda","di sisi"],["رَبِّكَ","rabbika","Tuhanmu"],["لِلْمُسْرِفِينَ","lil'mus'rifīna","untuk orang-orang yang melampaui batas"]]},{"t":"Lalu Kami keluarkan orang-orang yang beriman yang berada di dalamnya (negeri kaum Luṭ).","w":[["فَأَخْرَجْنَا","fa-akhrajnā","maka Kami keluarkan"],["مَن","man","orang yang"],["كَانَ","kāna","adalah"],["فِيهَا","fīhā","didalamnya"],["مِنَ","mina","dari"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","orang-orang yang beriman"]]},{"t":"Maka Kami tidak mendapati di dalamnya (negeri itu), kecuali satu rumah dari orang-orang muslim (Luṭ).","w":[["فَمَا","famā","maka tidak"],["وَجَدْنَا","wajadnā","kami dapati"],["فِيهَا","fīhā","didalamnya"],["غَيْرَ","ghayra","selain"],["بَيْتٍۢ","baytin","sebuah rumah"],["مِّنَ","mina","dari"],["ٱلْمُسْلِمِينَ","l-mus'limīna","orang-orang yang berserah diri"]]},{"t":"Dan Kami tinggalkan padanya (negeri itu) suatu tanda bagi orang-orang yang takut kepada azab yang pedih.","w":[["وَتَرَكْنَا","wataraknā","dan kami tinggalkan"],["فِيهَآ","fīhā","didalamnya"],["ءَايَةًۭ","āyatan","tanda-tanda"],["لِّلَّذِينَ","lilladhīna","bagi orang-orang yang"],["يَخَافُونَ","yakhāfūna","mereka takut"],["ٱلْعَذَابَ","l-ʿadhāba","azab"],["ٱلْأَلِيمَ","l-alīma","pedih"]]},{"t":"Dan pada Musa (terdapat tanda-tanda kekuasaan Allah) ketika Kami mengutusnya kepada Fir'aun dengan membawa mukjizat yang nyata.","w":[["وَفِى","wafī","dan pada"],["مُوسَىٰٓ","mūsā","Musa"],["إِذْ","idh","ketika"],["أَرْسَلْنَـٰهُ","arsalnāhu","Kami mengutusnya"],["إِلَىٰ","ilā","kepada"],["فِرْعَوْنَ","fir'ʿawna","Fir'aun"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","dengan kekuasaan/mu'jizat"],["مُّبِينٍۢ","mubīnin","nyata"]]},{"t":"Tetapi dia (Fir'aun) bersama bala tentaranya berpaling dan berkata, \"Dia adalah seorang pesihir atau orang gila.\"","w":[["فَتَوَلَّىٰ","fatawallā","maka dia berpaling"],["بِرُكْنِهِۦ","biruk'nihi","dengan kekuatannya"],["وَقَالَ","waqāla","dan dia berkata"],["سَـٰحِرٌ","sāḥirun","seorang tukang sihir"],["أَوْ","aw","atau"],["مَجْنُونٌۭ","majnūnun","seorang gila"]]},{"t":"Maka Kami siksa dia beserta bala tentaranya, lalu Kami lemparkan mereka ke dalam laut, dalam keadaan tercela.","w":[["فَأَخَذْنَـٰهُ","fa-akhadhnāhu","maka Kami ambil/siksa dia"],["وَجُنُودَهُۥ","wajunūdahu","dan bala tentaranya"],["فَنَبَذْنَـٰهُمْ","fanabadhnāhum","lalu Kami lemparkan mereka"],["فِى","fī","ke dalam"],["ٱلْيَمِّ","l-yami","laut"],["وَهُوَ","wahuwa","dan dia"],["مُلِيمٌۭ","mulīmun","seorang tercela"]]},{"t":"Dan (juga) pada (kisah kaum) 'Ād, ketika Kami kirimkan kepada mereka angin yang membinasakan,","w":[["وَفِى","wafī","dan pada"],["عَادٍ","ʿādin","'Ad"],["إِذْ","idh","ketika"],["أَرْسَلْنَا","arsalnā","Kami kirimkan"],["عَلَيْهِمُ","ʿalayhimu","atas mereka"],["ٱلرِّيحَ","l-rīḥa","angin"],["ٱلْعَقِيمَ","l-ʿaqīma","membinasakan"]]},{"t":"(angin itu) tidak membiarkan suatu apa pun yang dilandanya, bahkan dijadikannya seperti serbuk.","w":[["مَا","mā","tidak"],["تَذَرُ","tadharu","membiarkan"],["مِن","min","dari"],["شَىْءٍ","shayin","sesuatu"],["أَتَتْ","atat","ia datang"],["عَلَيْهِ","ʿalayhi","atasnya"],["إِلَّا","illā","kecuali"],["جَعَلَتْهُ","jaʿalathu","ia jadikannya"],["كَٱلرَّمِيمِ","kal-ramīmi","seperti abu/hancur"]]},{"t":"Dan pada (kisah kaum) Samud, ketika dikatakan kepada mereka, \"Bersenang-senanglah kamu sampai waktu yang ditentukan.\"","w":[["وَفِى","wafī","dan pada"],["ثَمُودَ","thamūda","kaum Tsamud"],["إِذْ","idh","ketika"],["قِيلَ","qīla","dikatakan"],["لَهُمْ","lahum","kepada mereka"],["تَمَتَّعُوا۟","tamattaʿū","bersenang-senanglah"],["حَتَّىٰ","ḥattā","sehingga"],["حِينٍۢ","ḥīnin","suatu waktu"]]},{"t":"Lalu mereka berlaku angkuh terhadap perintah Tuhannya, maka mereka disambar petir sedang mereka melihatnya.","w":[["فَعَتَوْا۟","faʿataw","maka mereka angkuh"],["عَنْ","ʿan","dari"],["أَمْرِ","amri","perintah"],["رَبِّهِمْ","rabbihim","Tuhan mereka"],["فَأَخَذَتْهُمُ","fa-akhadhathumu","maka menyambar"],["ٱلصَّـٰعِقَةُ","l-ṣāʿiqatu","petir"],["وَهُمْ","wahum","sedang mereka"],["يَنظُرُونَ","yanẓurūna","mereka melihat"]]},{"t":"Maka mereka tidak mampu bangun dan juga tidak mendapat pertolongan,","w":[["فَمَا","famā","maka tidak"],["ٱسْتَطَـٰعُوا۟","is'taṭāʿū","mereka kuasa"],["مِن","min","dari"],["قِيَامٍۢ","qiyāmin","berdiri/bangun"],["وَمَا","wamā","dan tidak ada"],["كَانُوا۟","kānū","adalah mereka"],["مُنتَصِرِينَ","muntaṣirīna","mendapat pertolongan"]]},{"t":"dan sebelum itu (telah Kami binasakan) kaum Nuh. Sungguh, mereka adalah kaum yang fasik.","w":[["وَقَوْمَ","waqawma","dan kaum"],["نُوحٍۢ","nūḥin","Nuh"],["مِّن","min","dari"],["قَبْلُ ۖ","qablu","sebelum itu"],["إِنَّهُمْ","innahum","sesungguhnya mereka"],["كَانُوا۟","kānū","adalah mereka"],["قَوْمًۭا","qawman","kaum"],["فَـٰسِقِينَ","fāsiqīna","orang-orang yang fasik"]]},{"t":"Dan langit Kami bangun dengan kekuasaan (Kami), dan Kami benar-benar meluaskannya.","w":[["وَٱلسَّمَآءَ","wal-samāa","dan langit"],["بَنَيْنَـٰهَا","banaynāhā","Kami bangun ia"],["بِأَيْي۟دٍۢ","bi-aydin","dengan kekuasaan"],["وَإِنَّا","wa-innā","dan sesungguhnya Kami"],["لَمُوسِعُونَ","lamūsiʿūna","benar-benar luas"]]},{"t":"Dan bumi telah Kami hamparkan; maka (Kami) sebaik-baik yang menghamparkan.","w":[["وَٱلْأَرْضَ","wal-arḍa","dan bumi"],["فَرَشْنَـٰهَا","farashnāhā","Kami hamparkannya"],["فَنِعْمَ","faniʿ'ma","maka sebaik-baik"],["ٱلْمَـٰهِدُونَ","l-māhidūna","yang menghamparkan"]]},{"t":"Dan segala sesuatu Kami ciptakan berpasang-pasangan agar kamu mengingat (kebesaran Allah).","w":[["وَمِن","wamin","dan dari"],["كُلِّ","kulli","segala"],["شَىْءٍ","shayin","sesuatu"],["خَلَقْنَا","khalaqnā","Kami ciptakan"],["زَوْجَيْنِ","zawjayni","berpasang-pasangan"],["لَعَلَّكُمْ","laʿallakum","agar kalian"],["تَذَكَّرُونَ","tadhakkarūna","kamu ingat"]]},{"t":"Maka segeralah kembali kepada (menaati) Allah. Sungguh, aku seorang pemberi peringatan yang jelas dari Allah untukmu.","w":[["فَفِرُّوٓا۟","fafirrū","maka segeralah"],["إِلَى","ilā","kepada"],["ٱللَّهِ ۖ","l-lahi","Allah"],["إِنِّى","innī","sesungguhnya aku"],["لَكُم","lakum","bagi kalian"],["مِّنْهُ","min'hu","daripada-Nya"],["نَذِيرٌۭ","nadhīrun","seorang pemberi peringatan"],["مُّبِينٌۭ","mubīnun","nyata"]]},{"t":"Dan janganlah kamu mengadakan tuhan yang lain selain Allah. Sungguh, aku seorang pemberi peringatan yang jelas dari Allah untukmu.","w":[["وَلَا","walā","dan jangan"],["تَجْعَلُوا۟","tajʿalū","kalian jadikan"],["مَعَ","maʿa","beserta"],["ٱللَّهِ","l-lahi","Allah"],["إِلَـٰهًا","ilāhan","Tuhan"],["ءَاخَرَ ۖ","ākhara","lain"],["إِنِّى","innī","sesungguhnya aku"],["لَكُم","lakum","bagi kalian"],["مِّنْهُ","min'hu","darinya"],["نَذِيرٌۭ","nadhīrun","seorang pemberi peringatan"],["مُّبِينٌۭ","mubīnun","nyata"]]},{"t":"Demikianlah setiap kali seorang rasul yang datang kepada orang-orang yang sebelum mereka, mereka (kaumnya) pasti mengatakan, \"Dia itu pesihir atau orang gila.\"","w":[["كَذَٰلِكَ","kadhālika","demikianlah"],["مَآ","mā","tidak"],["أَتَى","atā","datang"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["مِن","min","dari"],["قَبْلِهِم","qablihim","sebelum mereka"],["مِّن","min","dari"],["رَّسُولٍ","rasūlin","seorang rasul"],["إِلَّا","illā","kecuali"],["قَالُوا۟","qālū","mereka berkata"],["سَاحِرٌ","sāḥirun","seorang tukang sihir"],["أَوْ","aw","atau"],["مَجْنُونٌ","majnūnun","seorang gila"]]},{"t":"Apakah mereka saling berpesan tentang apa yang dikatakan itu. Sebenarnya mereka adalah kaum yang melampaui batas.","w":[["أَتَوَاصَوْا۟","atawāṣaw","apakah mereka saling berwasiat"],["بِهِۦ ۚ","bihi","tentang itu"],["بَلْ","bal","bahkan"],["هُمْ","hum","mereka"],["قَوْمٌۭ","qawmun","kaum"],["طَاغُونَ","ṭāghūna","melampaui batas"]]},{"t":"Maka berpalinglah engkau dari mereka, dan engkau sama sekali tidak tercela.","w":[["فَتَوَلَّ","fatawalla","maka berpalinglah kamu"],["عَنْهُمْ","ʿanhum","dari mereka"],["فَمَآ","famā","maka tidaklah"],["أَنتَ","anta","kamu"],["بِمَلُومٍۢ","bimalūmin","orang-orang yang tercela"]]},{"t":"Dan tetaplah memberi peringatan, karena sesungguhnya peringatan itu bermanfaat bagi orang-orang mukmin.","w":[["وَذَكِّرْ","wadhakkir","dan berilah peringatan"],["فَإِنَّ","fa-inna","maka sesungguhnya"],["ٱلذِّكْرَىٰ","l-dhik'rā","peringatan itu"],["تَنفَعُ","tanfaʿu","memberi manfaat"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","orang-orang yang beriman"]]},{"t":"Aku tidak menciptakan jin dan manusia melainkan agar mereka beribadah kepada-Ku.","w":[["وَمَا","wamā","dan tidaklah"],["خَلَقْتُ","khalaqtu","Aku menciptakan"],["ٱلْجِنَّ","l-jina","jin"],["وَٱلْإِنسَ","wal-insa","dan manusia"],["إِلَّا","illā","kecuali"],["لِيَعْبُدُونِ","liyaʿbudūni","supaya mereka menyembah-Ku"]]},{"t":"Aku tidak menghendaki rezeki sedikit pun dari mereka dan Aku tidak menghendaki agar mereka memberi makan kepada-Ku.","w":[["مَآ","mā","tidak"],["أُرِيدُ","urīdu","Aku menghendaki"],["مِنْهُم","min'hum","dari mereka"],["مِّن","min","dari"],["رِّزْقٍۢ","riz'qin","rezeki"],["وَمَآ","wamā","dan tidak"],["أُرِيدُ","urīdu","Aku menghendaki"],["أَن","an","supaya"],["يُطْعِمُونِ","yuṭ'ʿimūni","mereka memberi Aku makan"]]},{"t":"Sungguh Allah, Dialah Pemberi rezeki yang mempunyai kekuatan lagi sangat kokoh.","w":[["إِنَّ","inna","sesungguhnya"],["ٱللَّهَ","l-laha","Allah"],["هُوَ","huwa","Dia"],["ٱلرَّزَّاقُ","l-razāqu","Maha Pemberi rezeki"],["ذُو","dhū","mempunyai"],["ٱلْقُوَّةِ","l-quwati","kekuatan"],["ٱلْمَتِينُ","l-matīnu","teguh/kokoh"]]},{"t":"Maka sungguh, untuk orang-orang yang zalim ada bagian (azab) seperti bagian teman-teman mereka (dahulu); maka janganlah mereka meminta kepada-Ku untuk menyegerakannya.","w":[["فَإِنَّ","fa-inna","maka sesungguhnya"],["لِلَّذِينَ","lilladhīna","bagi orang-orang yang"],["ظَلَمُوا۟","ẓalamū","zalim"],["ذَنُوبًۭا","dhanūban","bahagian(siksa)"],["مِّثْلَ","mith'la","seperti"],["ذَنُوبِ","dhanūbi","bahagian(siksa)"],["أَصْحَـٰبِهِمْ","aṣḥābihim","teman-teman mereka"],["فَلَا","falā","maka jangan"],["يَسْتَعْجِلُونِ","yastaʿjilūni","mereka meminta disegerakan kepada-Ku"]]},{"t":"Maka celakalah orang-orang yang kafir pada hari yang telah dijanjikan kepada mereka (hari Kiamat).","w":[["فَوَيْلٌۭ","fawaylun","maka kecelakaanlah"],["لِّلَّذِينَ","lilladhīna","bagi orang-orang yang"],["كَفَرُوا۟","kafarū","kafir/ingkar"],["مِن","min","dari"],["يَوْمِهِمُ","yawmihimu","pada hari mereka"],["ٱلَّذِى","alladhī","yang"],["يُوعَدُونَ","yūʿadūna","mereka diancam"]]}]}