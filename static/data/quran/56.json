{"n":56,"ayat":[{"t":"Apabila terjadi hari Kiamat,","w":[["إِذَا","idhā","apabila"],["وَقَعَتِ","waqaʿati","jatuh/terjadi"],["ٱلْوَاقِعَةُ","l-wāqiʿatu","kejadian/peristiwa yang besar"]]},{"t":"terjadinya tidak dapat didustakan (disangkal).","w":[["لَيْسَ","laysa","tidak"],["لِوَقْعَتِهَا","liwaqʿatihā","bagi/tentang terjadinya"],["كَاذِبَةٌ","kādhibatun","seseorang yang mendustakan"]]},{"t":"(Kejadian itu) merendahkan (satu golongan) dan meninggikan (golongan yang lain).","w":[["خَافِضَةٌۭ","khāfiḍatun","yang merendahkan"],["رَّافِعَةٌ","rāfiʿatun","yang meninggikan"]]},{"t":"Apabila bumi diguncangkan sedahsyat-dahsyatnya,","w":[["إِذَا","idhā","apabila"],["رُجَّتِ","rujjati","digoncangkan"],["ٱلْأَرْضُ","l-arḍu","bumi"],["رَجًّۭا","rajjan","goncangan yang keras"]]},{"t":"dan gunung-gunung dihancur luluhkan sehancur-hancurnya,","w":[["وَبُسَّتِ","wabussati","dan dihancurkan"],["ٱلْجِبَالُ","l-jibālu","gunung-gunung"],["بَسًّۭا","bassan","sehancur-hancurnya"]]},{"t":"maka jadilah ia debu yang berterbangan,","w":[["فَكَانَتْ","fakānat","dan adalah/jadilah ia"],["هَبَآءًۭ","habāan","debu"],["مُّنۢبَثًّۭا","munbathan","berterbangan"]]},{"t":"dan kamu menjadi tiga golongan,","w":[["وَكُنتُمْ","wakuntum","dan kalian"],["أَزْوَٰجًۭا","azwājan","pasangan/golongan"],["ثَلَـٰثَةًۭ","thalāthatan","tiga"]]},{"t":"yaitu golongan kanan, alangkah mulianya golongan kanan itu,","w":[["فَأَصْحَـٰبُ","fa-aṣḥābu","maka kaum/golongan"],["ٱلْمَيْمَنَةِ","l-maymanati","kanan"],["مَآ","mā","apa/siapa"],["أَصْحَـٰبُ","aṣḥābu","kaum/golongan"],["ٱلْمَيْمَنَةِ","l-maymanati","kanan"]]},{"t":"dan golongan kiri, alangkah sengsaranya golongan kiri itu,","w":[["وَأَصْحَـٰبُ","wa-aṣḥābu","dan kaum/golongan"],["ٱلْمَشْـَٔمَةِ","l-mashamati","celaka/kiri"],["مَآ","mā","apa/siapa"],["أَصْحَـٰبُ","aṣḥābu","kaum/golongan"],["ٱلْمَشْـَٔمَةِ","l-mashamati","kiri"]]},{"t":"dan orang-orang yang paling dahulu (beriman), merekalah yang paling dahulu (masuk surga).","w":[["وَٱلسَّـٰبِقُونَ","wal-sābiqūna","dan orang-orang terdahulu"],["ٱلسَّـٰبِقُونَ","l-sābiqūna","orang-orang terdahulu"]]},{"t":"mereka itulah orang yang dekat (kepada Allah),","w":[["أُو۟لَـٰٓئِكَ","ulāika","mereka itulah"],["ٱلْمُقَرَّبُونَ","l-muqarabūna","orang-orang yang dekat"]]},{"t":"Berada dalam surga kenikmatan,","w":[["فِى","fī","pada"],["جَنَّـٰتِ","jannāti","surga/taman"],["ٱلنَّعِيمِ","l-naʿīmi","kenikmatan"]]},{"t":"segolongan besar dari orang-orang yang terdahulu,","w":[["ثُلَّةٌۭ","thullatun","rombongan/golongan besar"],["مِّنَ","mina","dari"],["ٱلْأَوَّلِينَ","l-awalīna","orang-orang pertama/dahulu"]]},{"t":"dan segolongan kecil dari orang-orang yang kemudian.","w":[["وَقَلِيلٌۭ","waqalīlun","dan sedikit"],["مِّنَ","mina","dari"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","orang-orang kemudian"]]},{"t":"mereka berada di atas dipan-dipan yang bertahtakan emas dan permata,","w":[["عَلَىٰ","ʿalā","di atas"],["سُرُرٍۢ","sururin","divan"],["مَّوْضُونَةٍۢ","mawḍūnatin","tersulam/bertahtakan emas permata"]]},{"t":"mereka bersandar di atasnya berhadap-hadapan.","w":[["مُّتَّكِـِٔينَ","muttakiīna","mereka bersandar"],["عَلَيْهَا","ʿalayhā","diatasnya"],["مُتَقَـٰبِلِينَ","mutaqābilīna","mereka berhadap-hadapan"]]},{"t":"Mereka dikelilingi oleh anak-anak muda yang tetap muda,","w":[["يَطُوفُ","yaṭūfu","mengelilingi"],["عَلَيْهِمْ","ʿalayhim","atas mereka"],["وِلْدَٰنٌۭ","wil'dānun","anak-anak muda"],["مُّخَلَّدُونَ","mukhalladūna","kekal/tetap"]]},{"t":"dengan membawa gelas, cerek dan gelas besar (piala) berisi minuman yang diambil dari air yang mengalir,","w":[["بِأَكْوَابٍۢ","bi-akwābin","dengan cangkir-cangkir"],["وَأَبَارِيقَ","wa-abārīqa","dan cerek-cerek"],["وَكَأْسٍۢ","wakasin","dan piala-piala"],["مِّن","min","dari"],["مَّعِينٍۢ","maʿīnin","mata air"]]},{"t":"mereka tidak pening karenanya dan tidak pula mabuk,","w":[["لَّا","lā","tidak"],["يُصَدَّعُونَ","yuṣaddaʿūna","mereka sakit kepala/pening"],["عَنْهَا","ʿanhā","dari padanya/karenanya"],["وَلَا","walā","dan tidak"],["يُنزِفُونَ","yunzifūna","mereka mabuk"]]},{"t":"dan buah-buahan apa pun yang mereka pilih,","w":[["وَفَـٰكِهَةٍۢ","wafākihatin","dan buah-buahan"],["مِّمَّا","mimmā","dari apa"],["يَتَخَيَّرُونَ","yatakhayyarūna","mereka pilih"]]},{"t":"dan daging burung apa pun yang mereka inginkan.","w":[["وَلَحْمِ","walaḥmi","dan daging"],["طَيْرٍۢ","ṭayrin","burung"],["مِّمَّا","mimmā","dari apa"],["يَشْتَهُونَ","yashtahūna","mereka inginkan"]]},{"t":"dan ada bidadari-bidadari yang bermata indah,","w":[["وَحُورٌ","waḥūrun","dan bidadari"],["عِينٌۭ","ʿīnun","bermata jeli"]]},{"t":"laksana mutiara yang tersimpan baik.","w":[["كَأَمْثَـٰلِ","ka-amthāli","seperti/laksana"],["ٱللُّؤْلُؤِ","l-lu'lu-i","mutiara"],["ٱلْمَكْنُونِ","l-maknūni","tersimpan baik"]]},{"t":"Sebagai balasan atas apa yang mereka kerjakan.","w":[["جَزَآءًۢ","jazāan","balasan"],["بِمَا","bimā","bagi apa"],["كَانُوا۟","kānū","adalah mereka"],["يَعْمَلُونَ","yaʿmalūna","mereka telah kerjakan"]]},{"t":"Di sana mereka tidak mendengar percakapan yang sia-sia maupun yang menimbulkan dosa,","w":[["لَا","lā","tidak"],["يَسْمَعُونَ","yasmaʿūna","mereka mendengar"],["فِيهَا","fīhā","didalamnya"],["لَغْوًۭا","laghwan","sia-sia"],["وَلَا","walā","dan tidak"],["تَأْثِيمًا","tathīman","menimbulkan dosa"]]},{"t":"tetapi mereka mendengar ucapan salam.","w":[["إِلَّا","illā","kecuali"],["قِيلًۭا","qīlan","perkataan"],["سَلَـٰمًۭا","salāman","selamat/sejahtera"],["سَلَـٰمًۭا","salāman","selamat/sejahtera"]]},{"t":"Dan golongan kanan, alangkah mulianya golongan kanan itu.","w":[["وَأَصْحَـٰبُ","wa-aṣḥābu","dan kaum/golongan"],["ٱلْيَمِينِ","l-yamīni","kanan"],["مَآ","mā","apa/siapa"],["أَصْحَـٰبُ","aṣḥābu","kaum/golongan"],["ٱلْيَمِينِ","l-yamīni","kanan"]]},{"t":"(Mereka) berada di antara pohon bidara yang tidak berduri,","w":[["فِى","fī","pada"],["سِدْرٍۢ","sid'rin","pohon bidara"],["مَّخْضُودٍۢ","makhḍūdin","tidak berduri"]]},{"t":"dan pohon pisang yang bersusun-susun (buahnya),","w":[["وَطَلْحٍۢ","waṭalḥin","dan pohon pisang"],["مَّنضُودٍۢ","manḍūdin","bersusun-susun"]]},{"t":"dan naungan yang terbentang luas,","w":[["وَظِلٍّۢ","waẓillin","dan naungan"],["مَّمْدُودٍۢ","mamdūdin","memanjang/terbentang luas"]]},{"t":"dan air yang mengalir terus-menerus,","w":[["وَمَآءٍۢ","wamāin","dan air"],["مَّسْكُوبٍۢ","maskūbin","tercurah"]]},{"t":"dan buah-buahan yang banyak,","w":[["وَفَـٰكِهَةٍۢ","wafākihatin","dan buah-buahan"],["كَثِيرَةٍۢ","kathīratin","yang banyak"]]},{"t":"yang tidak berhenti berbuah dan tidak terlarang mengambilnya,","w":[["لَّا","lā","tidak"],["مَقْطُوعَةٍۢ","maqṭūʿatin","terputus"],["وَلَا","walā","dan tidak"],["مَمْنُوعَةٍۢ","mamnūʿatin","tercegah/terlarang"]]},{"t":"dan kasur-kasur yang tebal lagi empuk.","w":[["وَفُرُشٍۢ","wafurushin","dan hamparan/kasur-kasur"],["مَّرْفُوعَةٍ","marfūʿatin","ditinggikan/tebal empuk"]]},{"t":"Kami menciptakan mereka (bidadari-bidadari itu) secara langsung,","w":[["إِنَّآ","innā","sesungguhnya Kami"],["أَنشَأْنَـٰهُنَّ","anshanāhunna","Kami jadikan mereka"],["إِنشَآءًۭ","inshāan","dengan kejadian"]]},{"t":"lalu Kami jadikan mereka perawan-perawan,","w":[["فَجَعَلْنَـٰهُنَّ","fajaʿalnāhunna","maka Kami jadikan mereka"],["أَبْكَارًا","abkāran","gadis-gadis perawan"]]},{"t":"yang penuh cinta (dan) sebaya umurnya,","w":[["عُرُبًا","ʿuruban","penuh cinta"],["أَتْرَابًۭا","atrāban","sebaya"]]},{"t":"untuk golongan kanan,","w":[["لِّأَصْحَـٰبِ","li-aṣḥābi","untuk kaum/golongan"],["ٱلْيَمِينِ","l-yamīni","kanan"]]},{"t":"segolongan besar dari orang-orang yang terdahulu,","w":[["ثُلَّةٌۭ","thullatun","rombongan/golongan besar"],["مِّنَ","mina","dari"],["ٱلْأَوَّلِينَ","l-awalīna","orang-orang pertama/terdahulu"]]},{"t":"dan segolongan besar pula dari orang yang kemudian.","w":[["وَثُلَّةٌۭ","wathullatun","rombongan/golongan besar"],["مِّنَ","mina","dari"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","orang-orang kemudian"]]},{"t":"Dan golongan kiri, alangkah sengsaranya golongan kiri itu.","w":[["وَأَصْحَـٰبُ","wa-aṣḥābu","dan kaum/golongan"],["ٱلشِّمَالِ","l-shimāli","kiri"],["مَآ","mā","apa/siapa"],["أَصْحَـٰبُ","aṣḥābu","kaum/golongan"],["ٱلشِّمَالِ","l-shimāli","kiri"]]},{"t":"(Mereka) dalam siksaan angin yang sangat panas dan air yang mendidih,","w":[["فِى","fī","pada"],["سَمُومٍۢ","samūmin","angin amat panas"],["وَحَمِيمٍۢ","waḥamīmin","dan air yang sangat mendidih"]]},{"t":"dan naungan asap yang hitam,","w":[["وَظِلٍّۢ","waẓillin","dan naungan"],["مِّن","min","dari"],["يَحْمُومٍۢ","yaḥmūmin","asap hitam"]]},{"t":"tidak sejuk dan tidak menyenangkan.","w":[["لَّا","lā","tidak"],["بَارِدٍۢ","bāridin","sejuk"],["وَلَا","walā","dan tidak"],["كَرِيمٍ","karīmin","enak/menyenangkan"]]},{"t":"Sesungguhnya mereka sebelum itu (dahulu) hidup bermewah-mewah,","w":[["إِنَّهُمْ","innahum","sesungguhnya mereka"],["كَانُوا۟","kānū","adalah mereka"],["قَبْلَ","qabla","sebelum"],["ذَٰلِكَ","dhālika","demikian/itu"],["مُتْرَفِينَ","mut'rafīna","dalam kesenangan/kemewahan"]]},{"t":"dan mereka terus-menerus mengerjakan dosa yang besar,","w":[["وَكَانُوا۟","wakānū","dan adalah mereka"],["يُصِرُّونَ","yuṣirrūna","mereka tetap/terus-menerus"],["عَلَى","ʿalā","atas"],["ٱلْحِنثِ","l-ḥinthi","pelanggaran/dosa"],["ٱلْعَظِيمِ","l-ʿaẓīmi","yang besar"]]},{"t":"dan mereka berkata, \"Apabila kami sudah mati, menjadi tanah dan tulang-belulang, apakah kami benar-benar akan dibangkitkan kembali?","w":[["وَكَانُوا۟","wakānū","dan adalah mereka"],["يَقُولُونَ","yaqūlūna","mereka mengatakan"],["أَئِذَا","a-idhā","apakah apabila"],["مِتْنَا","mit'nā","kami telah mati"],["وَكُنَّا","wakunnā","dan kami adalah/menjadi"],["تُرَابًۭا","turāban","tanah"],["وَعِظَـٰمًا","waʿiẓāman","dan tulang-belulang"],["أَءِنَّا","a-innā","apakah sesungguhnya kami"],["لَمَبْعُوثُونَ","lamabʿūthūna","sungguh akan dibangkitkan"]]},{"t":"Apakah nenek moyang kami yang terdahulu (dibangkitkan pula)?\"","w":[["أَوَءَابَآؤُنَا","awaābāunā","nenek moyang kita?"],["ٱلْأَوَّلُونَ","l-awalūna","terdahulu"]]},{"t":"Katakanlah, \"(Ya), sesungguhnya orang-orang yang terdahulu dan yang kemudian,","w":[["قُلْ","qul","katakanlah"],["إِنَّ","inna","sesungguhnya"],["ٱلْأَوَّلِينَ","l-awalīna","orang-orang terdahulu"],["وَٱلْـَٔاخِرِينَ","wal-ākhirīna","dan orang-orang yang kemudian"]]},{"t":"pasti semua akan dikumpulkan pada waktu tertentu, pada hari yang sudah dimaklumi.","w":[["لَمَجْمُوعُونَ","lamajmūʿūna","sungguh mereka dikumpulkan"],["إِلَىٰ","ilā","atas"],["مِيقَـٰتِ","mīqāti","waktu-waktu tertentu"],["يَوْمٍۢ","yawmin","hari"],["مَّعْلُومٍۢ","maʿlūmin","diketahui/ditentukan"]]},{"t":"Kemudian sesungguhnya kamu, wahai orang-orang yang sesat lagi mendustakan!","w":[["ثُمَّ","thumma","kemudian"],["إِنَّكُمْ","innakum","sesungguhnya kalian"],["أَيُّهَا","ayyuhā","hai"],["ٱلضَّآلُّونَ","l-ḍālūna","orang-orang yang sesat"],["ٱلْمُكَذِّبُونَ","l-mukadhibūna","orang-orang pendusta"]]},{"t":"pasti akan memakan pohon zaqqum,","w":[["لَـَٔاكِلُونَ","laākilūna","pasti memakan"],["مِن","min","dari"],["شَجَرٍۢ","shajarin","pohon"],["مِّن","min","dari"],["زَقُّومٍۢ","zaqqūmin","zaqqum"]]},{"t":"Maka akan penuh perutmu dengannya.","w":[["فَمَالِـُٔونَ","famāliūna","maka menjadi penuh"],["مِنْهَا","min'hā","dari padanya"],["ٱلْبُطُونَ","l-buṭūna","perut-perut"]]},{"t":"Setelah itu kamu akan memimun air yang sangat panas.","w":[["فَشَـٰرِبُونَ","fashāribūna","maka akan meminum"],["عَلَيْهِ","ʿalayhi","atasnya"],["مِنَ","mina","dari"],["ٱلْحَمِيمِ","l-ḥamīmi","air panas yang mendidih"]]},{"t":"Maka kamu minum seperti unta (yang sangat haus) minum.","w":[["فَشَـٰرِبُونَ","fashāribūna","maka akan meminum"],["شُرْبَ","shur'ba","minuman"],["ٱلْهِيمِ","l-hīmi","unta"]]},{"t":"Itulah hidangan untuk mereka pada hari pembalasan.\"","w":[["هَـٰذَا","hādhā","inilah"],["نُزُلُهُمْ","nuzuluhum","pemberian/hidangan mereka"],["يَوْمَ","yawma","hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"Kami telah menciptakan kamu, mengapa kamu tidak membenarkan (hari berbangkit)?","w":[["نَحْنُ","naḥnu","Kami"],["خَلَقْنَـٰكُمْ","khalaqnākum","Kami menciptakan kamu"],["فَلَوْلَا","falawlā","maka mengapa tidak"],["تُصَدِّقُونَ","tuṣaddiqūna","kamu membenarkan"]]},{"t":"Maka adakah kamu perhatikan, tentang (benih manusia) yang kamu pancarkan.","w":[["أَفَرَءَيْتُم","afara-aytum","maka apakah kamu perhatikan"],["مَّا","mā","apa"],["تُمْنُونَ","tum'nūna","kamu tumpahkan/pancarkan"]]},{"t":"Kamukah yang menciptakannya, ataukah Kami penciptanya?","w":[["ءَأَنتُمْ","a-antum","apakah kamu"],["تَخْلُقُونَهُۥٓ","takhluqūnahu","kamu menciptakannya"],["أَمْ","am","atau"],["نَحْنُ","naḥnu","Kami"],["ٱلْخَـٰلِقُونَ","l-khāliqūna","yang menciptakannya"]]},{"t":"Kami telah menentukan kematian masing-masing kamu dan Kami tidak lemah,","w":[["نَحْنُ","naḥnu","Kami"],["قَدَّرْنَا","qaddarnā","Kami telah menentukan"],["بَيْنَكُمُ","baynakumu","diantara kamu"],["ٱلْمَوْتَ","l-mawta","kematian"],["وَمَا","wamā","dan tidaklah"],["نَحْنُ","naḥnu","Kami"],["بِمَسْبُوقِينَ","bimasbūqīna","dengan dikalahkan"]]},{"t":"untuk menggantikan kamu dengan orang-orang yang seperti kamu (di dunia) dan membangkitkan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui.","w":[["عَلَىٰٓ","ʿalā","atas"],["أَن","an","bahwa"],["نُّبَدِّلَ","nubaddila","menggantikan"],["أَمْثَـٰلَكُمْ","amthālakum","yang serupa kamu"],["وَنُنشِئَكُمْ","wanunshi-akum","dan menciptakan kamu"],["فِى","fī","pada"],["مَا","mā","apa"],["لَا","lā","tidak"],["تَعْلَمُونَ","taʿlamūna","(kalian) mengetahui"]]},{"t":"Dan sungguh, kamu telah tahu penciptaan yang pertama, mengapa kamu tidak mengambil pelajaran?","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["عَلِمْتُمُ","ʿalim'tumu","kamu telah mengetahui"],["ٱلنَّشْأَةَ","l-nashata","penciptaan"],["ٱلْأُولَىٰ","l-ūlā","pertama"],["فَلَوْلَا","falawlā","maka mengapa tidak"],["تَذَكَّرُونَ","tadhakkarūna","kamu ingat/mengambil pelajaran"]]},{"t":"Pernahkah kamu perhatikan benih yang kamu tanam?","w":[["أَفَرَءَيْتُم","afara-aytum","maka apakah kamu perhatikan"],["مَّا","mā","apa"],["تَحْرُثُونَ","taḥruthūna","kamu tanam"]]},{"t":"Kamukah yang menumbuhkannya ataukah Kami yang menumbu