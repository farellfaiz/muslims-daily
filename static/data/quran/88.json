{"n":88,"ayat":[{"t":"Sudahkah sampai kepadamu berita tentang (hari Kiamat)?","w":[["هَلْ","hal","apakah"],["أَتَىٰكَ","atāka","telah datang kepadamu"],["حَدِيثُ","ḥadīthu","cerita/berita"],["ٱلْغَـٰشِيَةِ","l-ghāshiyati","peristiwa yang dahsyat"]]},{"t":"Pada hari itu banyak wajah yang tertunduk hina,","w":[["وُجُوهٌۭ","wujūhun","wajah"],["يَوْمَئِذٍ","yawma-idhin","pada hari itu"],["خَـٰشِعَةٌ","khāshiʿatun","tertunduk"]]},{"t":"(karena) bekerja keras lagi kepayahan,","w":[["عَامِلَةٌۭ","ʿāmilatun","kerja keras"],["نَّاصِبَةٌۭ","nāṣibatun","letih/kepayahan"]]},{"t":"mereka memasuki api yang sangat panas (neraka),","w":[["تَصْلَىٰ","taṣlā","ia memasuki"],["نَارًا","nāran","api/neraka"],["حَامِيَةًۭ","ḥāmiyatan","sangat panas"]]},{"t":"diberi minum dari sumber mata air yang sangat panas.","w":[["تُسْقَىٰ","tus'qā","ia diberikan minuman"],["مِنْ","min","dari"],["عَيْنٍ","ʿaynin","mata air"],["ءَانِيَةٍۢ","āniyatin","sangat panas/mendidih"]]},{"t":"Tidak ada makanan bagi mereka selain dari pohon yang berduri,","w":[["لَّيْسَ","laysa","tidak ada"],["لَهُمْ","lahum","bagi mereka"],["طَعَامٌ","ṭaʿāmun","makanan"],["إِلَّا","illā","kecuali"],["مِن","min","dari"],["ضَرِيعٍۢ","ḍarīʿin","pohon berduri"]]},{"t":"yang tidak menggemukkan dan tidak menghilangkan lapar.","w":[["لَّا","lā","tidak"],["يُسْمِنُ","yus'minu","menggemukkan"],["وَلَا","walā","dan tidak"],["يُغْنِى","yugh'nī","mencukupi/menghilangkan"],["مِن","min","dari"],["جُوعٍۢ","jūʿin","lapar"]]},{"t":"Pada hari itu banyak (pula) wajah yang berseri-seri,","w":[["وُجُوهٌۭ","wujūhun","wajah-wajah"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["نَّاعِمَةٌۭ","nāʿimatun","penuh kenikmatan/berseri-seri"]]},{"t":"merasa senang karena usahanya (sendiri),","w":[["لِّسَعْيِهَا","lisaʿyihā","karena usahanya"],["رَاضِيَةٌۭ","rāḍiyatun","merasa senang"]]},{"t":"(mereka) dalam surga yang tinggi,","w":[["فِى","fī","dalam"],["جَنَّةٍ","jannatin","sorga"],["عَالِيَةٍۢ","ʿāliyatin","yang tinggi"]]},{"t":"di sana (kamu) tidak mendengar perkataan yang tidak berguna.","w":[["لَّا","lā","tidak"],["تَسْمَعُ","tasmaʿu","kamu mendengar"],["فِيهَا","fīhā","di dalamnya"],["لَـٰغِيَةًۭ","lāghiyatan","sia-sia/tidak berguna"]]},{"t":"Di sana ada mata air yang mengalir.","w":[["فِيهَا","fīhā","di dalamnya"],["عَيْنٌۭ","ʿaynun","mata air"],["جَارِيَةٌۭ","jāriyatun","mengalir"]]},{"t":"Di sana ada dipan-dipan yang ditinggikan,","w":[["فِيهَا","fīhā","di dalamnya"],["سُرُرٌۭ","sururun","tempat tempat duduk"],["مَّرْفُوعَةٌۭ","marfūʿatun","yang tinggi"]]},{"t":"dan gelas-gelas yang tersedia (di dekatnya),","w":[["وَأَكْوَابٌۭ","wa-akwābun","dan gelas-gelas"],["مَّوْضُوعَةٌۭ","mawḍūʿatun","terletak/tersedia"]]},{"t":"dan bantal-bantal sandaran yang tersusun,","w":[["وَنَمَارِقُ","wanamāriqu","dan bantal-bantal"],["مَصْفُوفَةٌۭ","maṣfūfatun","berbaris/tersusun"]]},{"t":"dan permadani-permadani yang terhampar.","w":[["وَزَرَابِىُّ","wazarābiyyu","dan permadani"],["مَبْثُوثَةٌ","mabthūthatun","terhampar"]]},{"t":"Maka tidakkah mereka memperhatikan unta, bagaimana diciptakan?","w":[["أَفَلَا","afalā","maka apakah tidak"],["يَنظُرُونَ","yanẓurūna","mereka memperhatikan"],["إِلَى","ilā","kepada"],["ٱلْإِبِلِ","l-ibili","unta"],["كَيْفَ","kayfa","bagaimana"],["خُلِقَتْ","khuliqat","ia diciptakan"]]},{"t":"Dan langit, bagaimana ditinggikan?","w":[["وَإِلَى","wa-ilā","dan kepada"],["ٱلسَّمَآءِ","l-samāi","langit"],["كَيْفَ","kayfa","bagaimana"],["رُفِعَتْ","rufiʿat","ia ditinggikan"]]},{"t":"Dan gunung-gunung bagaimana ditegakkan?","w":[["وَإِلَى","wa-ilā","dan kepada"],["ٱلْجِبَالِ","l-jibāli","gunung-gunung"],["كَيْفَ","kayfa","bagaimana"],["نُصِبَتْ","nuṣibat","ia ditegakkan"]]},{"t":"Dan bumi bagaimana dihamparkan?","w":[["وَإِلَى","wa-ilā","dan kepada"],["ٱلْأَرْضِ","l-arḍi","bumi"],["كَيْفَ","kayfa","bagaimana"],["سُطِحَتْ","suṭiḥat","ia dihamparkan"]]},{"t":"Maka berilah peringatan, karena sesungguhnya engkau (Muhammad) hanyalah pemberi peringatan.","w":[["فَذَكِّرْ","fadhakkir","maka berilah peringatan"],["إِنَّمَآ","innamā","sesungguhnya"],["أَنتَ","anta","kamu"],["مُذَكِّرٌۭ","mudhakkirun","seorang pemberi peringatan"]]},{"t":"Engkau bukanlah orang yang berkuasa atas mereka,","w":[["لَّسْتَ","lasta","bakankah kamu"],["عَلَيْهِم","ʿalayhim","atas mereka"],["بِمُصَيْطِرٍ","bimuṣayṭirin","dengan berkuasa"]]},{"t":"kecuali (jika ada) orang yang berpaling dan kafir,","w":[["إِلَّا","illā","kecuali"],["مَن","man","siapa"],["تَوَلَّىٰ","tawallā","ia berpaling"],["وَكَفَرَ","wakafara","dan ia kafir"]]},{"t":"maka Allah akan mengazabnya dengan azab yang besar.","w":[["فَيُعَذِّبُهُ","fayuʿadhibuhu","maka akan menyiksanya"],["ٱللَّهُ","l-lahu","Allah"],["ٱلْعَذَابَ","l-ʿadhāba","azab/siksaan"],["ٱلْأَكْبَرَ","l-akbara","besar"]]},{"t":"Sungguh, kepada Kami lah mereka kembali,","w":[["إِنَّ","inna","sesungguhnya"],["إِلَيْنَآ","ilaynā","kepada Kami"],["إِيَابَهُمْ","iyābahum","kembali mereka"]]},{"t":"kemudian sesungguhnya (kewajiban) Kami lah membuat perhitungan atas mereka.","w":[["ثُمَّ","thumma","kemudian"],["إِنَّ","inna","sesungguhnya"],["عَلَيْنَا","ʿalaynā","atas kami"],["حِسَابَهُم","ḥisābahum","perhitungan mereka"]]}]}