{"n":81,"ayat":[{"t":"Apabila matahari digulung,","w":[["إِذَا","idhā","apabila"],["ٱلشَّمْسُ","l-shamsu","matahari"],["كُوِّرَتْ","kuwwirat","digulung"]]},{"t":"dan apabila bintang-bintang berjatuhan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلنُّجُومُ","l-nujūmu","bintang-bintang"],["ٱنكَدَرَتْ","inkadarat","berjatuhan"]]},{"t":"dan apabila gunung-gunung dihancurkan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْجِبَالُ","l-jibālu","gunung-gunung"],["سُيِّرَتْ","suyyirat","dijalankan/dihancurkan"]]},{"t":"dan apabila unta-unta yang bunting ditinggalkan (tidak terurus),","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْعِشَارُ","l-ʿishāru","unta-unta bunting"],["عُطِّلَتْ","ʿuṭṭilat","dibiarkan/ditinggalkan"]]},{"t":"dan apabila binatang-binatang liar dikumpulkan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْوُحُوشُ","l-wuḥūshu","binatang-binatang liar/buas"],["حُشِرَتْ","ḥushirat","dikumpulkan"]]},{"t":"dan apabila lautan dipanaskan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْبِحَارُ","l-biḥāru","lautan"],["سُجِّرَتْ","sujjirat","dijadikan meluap"]]},{"t":"dan apabila roh-roh dipertemukan (dengan tubuh),","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلنُّفُوسُ","l-nufūsu","jiwa/ruh-ruh"],["زُوِّجَتْ","zuwwijat","dijodohkan/dipertemukan"]]},{"t":"dan apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْمَوْءُۥدَةُ","l-mawūdatu","bayi perempuan dikubur hidup-hidup"],["سُئِلَتْ","su-ilat","ditanya"]]},{"t":"karena dosa apa dia dibunuh?","w":[["بِأَىِّ","bi-ayyi","karena"],["ذَنۢبٍۢ","dhanbin","dosa"],["قُتِلَتْ","qutilat","ia dibunuh"]]},{"t":"Dan apabila lembaran-lembaran (catatan amal) telah dibuka lebar-lebar,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلصُّحُفُ","l-ṣuḥufu","lembaran-lembaran/catatan"],["نُشِرَتْ","nushirat","disebarkan/dibuka"]]},{"t":"dan apabila langit dilenyapkan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلسَّمَآءُ","l-samāu","langit"],["كُشِطَتْ","kushiṭat","dibuka/tabirnya/dilenyapkan"]]},{"t":"dan apabila neraka Jahim dinyalakan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْجَحِيمُ","l-jaḥīmu","neraka"],["سُعِّرَتْ","suʿʿirat","dinyalakan"]]},{"t":"dan apabila surga didekatkan,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْجَنَّةُ","l-janatu","surga"],["أُزْلِفَتْ","uz'lifat","didekatkan"]]},{"t":"setiap jiwa akan mengetahui apa yang telah dikerjakannya.","w":[["عَلِمَتْ","ʿalimat","mengetahu"],["نَفْسٌۭ","nafsun","diri/jiwa"],["مَّآ","mā","apa"],["أَحْضَرَتْ","aḥḍarat","ia sediakan/kerjakan"]]},{"t":"Aku bersumpah demi bintang-bintang,","w":[["فَلَآ","falā","maka sungguh"],["أُقْسِمُ","uq'simu","Aku bersumpah"],["بِٱلْخُنَّسِ","bil-khunasi","dengan bintang-bintang"]]},{"t":"yang beredar dan terbenam,","w":[["ٱلْجَوَارِ","al-jawāri","beredar/terbit"],["ٱلْكُنَّسِ","l-kunasi","berlindung/terbenam"]]},{"t":"demi malam apabila telah larut,","w":[["وَٱلَّيْلِ","wa-al-layli","dan malam"],["إِذَا","idhā","apabila"],["عَسْعَسَ","ʿasʿasa","hampir habis/pergi"]]},{"t":"dan demi subuh apabila telah menyinsing,","w":[["وَٱلصُّبْحِ","wal-ṣub'ḥi","dan pagi/subuh"],["إِذَا","idhā","apabila"],["تَنَفَّسَ","tanaffasa","menyingsing/mulai terang"]]},{"t":"sesungguhnya (Alquran) itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril),","w":[["إِنَّهُۥ","innahu","sesungguhnya ia"],["لَقَوْلُ","laqawlu","benar-benar firman"],["رَسُولٍۢ","rasūlin","utusan"],["كَرِيمٍۢ","karīmin","mulia"]]},{"t":"yang memiliki kekuatan, memiliki kedudukan tinggi di sisi (Allah) yang memiliki Arasy,","w":[["ذِى","dhī","mempunyai"],["قُوَّةٍ","quwwatin","kekuatan"],["عِندَ","ʿinda","disisi"],["ذِى","dhī","mempunyai"],["ٱلْعَرْشِ","l-ʿarshi","'Arsy'"],["مَكِينٍۢ","makīnin","kedudukan tinggi"]]},{"t":"yang di sana (di alam malaikat) ditaati dan dipercaya.","w":[["مُّطَاعٍۢ","muṭāʿin","ditaati"],["ثَمَّ","thamma","kemudian"],["أَمِينٍۢ","amīnin","dipercaya"]]},{"t":"Dan temanmu (Muhammad) itu bukanlah orang gila.","w":[["وَمَا","wamā","dan tidak/bukanlah"],["صَاحِبُكُم","ṣāḥibukum","temanmu"],["بِمَجْنُونٍۢ","bimajnūnin","orang gila"]]},{"t":"Dan sungguh, dia (Muhammad) telah melihatnya (Jibril) di ufuk yang terang.","w":[["وَلَقَدْ","walaqad","dan sesungguhnya"],["رَءَاهُ","raāhu","dia telah melihat"],["بِٱلْأُفُقِ","bil-ufuqi","di tepi langit/di ufuk"],["ٱلْمُبِينِ","l-mubīni","nyata/terang"]]},{"t":"Dan Dia (Muhammad) bukanlah seorang yang kikir (enggan) untuk menerangkan yang gaib.","w":[["وَمَا","wamā","dan tidak"],["هُوَ","huwa","dia"],["عَلَى","ʿalā","atas"],["ٱلْغَيْبِ","l-ghaybi","gaib"],["بِضَنِينٍۢ","biḍanīnin","dengan kikir"]]},{"t":"Dan (Alquran) itu bukanlah perkataan setan yang terkutuk,","w":[["وَمَا","wamā","dan tidak"],["هُوَ","huwa","ia"],["بِقَوْلِ","biqawli","perkataan"],["شَيْطَـٰنٍۢ","shayṭānin","syaitan"],["رَّجِيمٍۢ","rajīmin","terkutuk"]]},{"t":"maka ke manakah kamu akan pergi?","w":[["فَأَيْنَ","fa-ayna","maka kemana"],["تَذْهَبُونَ","tadhhabūna","kamu pergi"]]},{"t":"(Alquran) itu tidak lain adalah peringatan bagi seluruh alam,","w":[["إِنْ","in","sesungguhnya"],["هُوَ","huwa","ia"],["إِلَّا","illā","kecuali"],["ذِكْرٌۭ","dhik'run","peringatan"],["لِّلْعَـٰلَمِينَ","lil'ʿālamīna","bagi semesta alam"]]},{"t":"(yaitu) bagi siapa di antara kamu yang menghendaki menempuh jalan yang lurus.","w":[["لِمَن","liman","bagi siapa"],["شَآءَ","shāa","menghendaki"],["مِنكُمْ","minkum","diantara kamu"],["أَن","an","untuk"],["يَسْتَقِيمَ","yastaqīma","menempuh jalan yang lurus"]]},{"t":"Dan kamu tidak dapat menghendaki (menempuh jalan itu) kecuali apabila dikehendaki Allah, Tuhan seluruh alam.","w":[["وَمَا","wamā","dan tidak"],["تَشَآءُونَ","tashāūna","kamu menghendaki"],["إِلَّآ","illā","kecuali"],["أَن","an","bahwa"],["يَشَآءَ","yashāa","menghendaki"],["ٱللَّهُ","l-lahu","Allah"],["رَبُّ","rabbu","Tuhan/Pemelihara"],["ٱلْعَـٰلَمِينَ","l-ʿālamīna","semesta alam"]]}]}