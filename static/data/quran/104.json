{"n":104,"ayat":[{"t":"Celakalah bagi setiap pengumpat dan pencela,","w":[["وَيْلٌۭ","waylun","kecelakaan"],["لِّكُلِّ","likulli","bagi setiap"],["هُمَزَةٍۢ","humazatin","pengumpat"],["لُّمَزَةٍ","lumazatin","pencela"]]},{"t":"yang mengumpulkan harta dan menghitung-hitungnya,","w":[["ٱلَّذِى","alladhī","yang"],["جَمَعَ","jamaʿa","mengumpulkan"],["مَالًۭا","mālan","harta"],["وَعَدَّدَهُۥ","waʿaddadahu","dan dia menghitungnya"]]},{"t":"dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya.","w":[["يَحْسَبُ","yaḥsabu","dia mengira"],["أَنَّ","anna","bahwasanya"],["مَالَهُۥٓ","mālahu","hartanya"],["أَخْلَدَهُۥ","akhladahu","mengekalkannya"]]},{"t":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Ḥuṭamah.","w":[["كَلَّا ۖ","kallā","sekali-kali tidak"],["لَيُنۢبَذَنَّ","layunbadhanna","sungguh dia akan dilemparkan"],["فِى","fī","dalam"],["ٱلْحُطَمَةِ","l-ḥuṭamati","Hutamah"]]},{"t":"Dan tahukah kamu apakah (neraka) Ḥuṭamah itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["ٱلْحُطَمَةُ","l-ḥuṭamatu","Hutamah"]]},{"t":"(Yaitu) api (azab) Allah yang dinyalakan,","w":[["نَارُ","nāru","api"],["ٱللَّهِ","l-lahi","Allah"],["ٱلْمُوقَدَةُ","l-mūqadatu","dinyalakan"]]},{"t":"yang (membakar) sampai ke hati.","w":[["ٱلَّتِى","allatī","yang"],["تَطَّلِعُ","taṭṭaliʿu","naik"],["عَلَى","ʿalā","ke atas/sampai"],["ٱلْأَفْـِٔدَةِ","l-afidati","hati"]]},{"t":"Sungguh, api itu ditutup rapat atas (diri) mereka,","w":[["إِنَّهَا","innahā","sesungguhnya ia (api)"],["عَلَيْهِم","ʿalayhim","atas mereka"],["مُّؤْصَدَةٌۭ","mu'ṣadatun","terikat/ditutup rapat"]]},{"t":"(sedang mereka itu) diikat pada tiang-tiang yang panjang.","w":[["فِى","fī","dalam/pada"],["عَمَدٍۢ","ʿamadin","tiang"],["مُّمَدَّدَةٍۭ","mumaddadatin","panjang"]]}]}