{"n":94,"ayat":[{"t":"Bukankah kami telah melapangkan dadamu (Muhammad)?","w":[["أَلَمْ","alam","apakah tidak/bukankah"],["نَشْرَحْ","nashraḥ","Kami melapangkan"],["لَكَ","laka","bagimu"],["صَدْرَكَ","ṣadraka","dadamu"]]},{"t":"dan kami pun telah menurunkan beban darimu,","w":[["وَوَضَعْنَا","wawaḍaʿnā","dan Kami letakkan/turunkan"],["عَنكَ","ʿanka","dari kamu"],["وِزْرَكَ","wiz'raka","bebanmu"]]},{"t":"yang memberatkan punggungmu,","w":[["ٱلَّذِىٓ","alladhī","yang"],["أَنقَضَ","anqaḍa","memberatkan"],["ظَهْرَكَ","ẓahraka","punggungmu"]]},{"t":"dan kami tinggikan sebutan (nama)mu bagimu.","w":[["وَرَفَعْنَا","warafaʿnā","dan Kami tinggikan"],["لَكَ","laka","bagimu"],["ذِكْرَكَ","dhik'raka","sebutanmu"]]},{"t":"Maka sesungguhnya bersama kesulitan ada kemudahan,","w":[["فَإِنَّ","fa-inna","maka sesungguhnya"],["مَعَ","maʿa","beserta"],["ٱلْعُسْرِ","l-ʿus'ri","kesulitan"],["يُسْرًا","yus'ran","kemudahan"]]},{"t":"sesungguhnya bersama kesulitan ada kemudahan.","w":[["إِنَّ","inna","sesungguhnya"],["مَعَ","maʿa","beserta"],["ٱلْعُسْرِ","l-ʿus'ri","kesulitan"],["يُسْرًۭا","yus'ran","kemudahan"]]},{"t":"Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain),","w":[["فَإِذَا","fa-idhā","maka apabila"],["فَرَغْتَ","faraghta","kamu telah selesai"],["فَٱنصَبْ","fa-inṣab","maka kerja keraslah kamu"]]},{"t":"dan hanya kepada Tuhanmulah engkau berharap.","w":[["وَإِلَىٰ","wa-ilā","dan hanya"],["رَبِّكَ","rabbika","Tuhanmu"],["فَٱرْغَب","fa-ir'ghab","maka kamu berharap"]]}]}