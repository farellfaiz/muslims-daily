{"n":106,"ayat":[{"t":"Karena kebiasaan orang-orang Quraisy,","w":[["لِإِيلَـٰفِ","liīlāfi","karena kebiasaan"],["قُرَيْشٍ","qurayshin","orang-orang Qurais"]]},{"t":"(yaitu) kebiasaan mereka bepergian pada musim dingin dan musim panas.","w":[["إِۦلَـٰفِهِمْ","īlāfihim","kebiasaan mereka"],["رِحْلَةَ","riḥ'lata","perjalanan/bepergian"],["ٱلشِّتَآءِ","l-shitāi","dimusim dingin"],["وَٱلصَّيْفِ","wal-ṣayfi","dan musim panas"]]},{"t":"Maka hendaklah mereka menyembah Tuhan (pemilik) rumah ini (Ka'bah),","w":[["فَلْيَعْبُدُوا۟","falyaʿbudū","maka hendaklah mereka menyembah"],["رَبَّ","rabba","Tuhan"],["هَـٰذَا","hādhā","ini"],["ٱلْبَيْتِ","l-bayti","rumah"]]},{"t":"yang telah memberi makanan kepada mereka untuk menghilangkan lapar dan mengamankan mereka dari rasa ketakutan.","w":[["ٱلَّذِىٓ","alladhī","yang"],["أَطْعَمَهُم","aṭʿamahum","Dia memberi makan mereka"],["مِّن","min","dari"],["جُوعٍۢ","jūʿin","kelaparan"],["وَءَامَنَهُم","waāmanahum","dan Dia memberikan keamanan mereka"],["مِّنْ","min","dari"],["خَوْفٍۭ","khawfin","ketakutan"]]}]}