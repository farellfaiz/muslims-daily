{"n":77,"ayat":[{"t":"Demi (malaikat-malaikat) yang diutus untuk membawa kebaikan,","w":[["وَٱلْمُرْسَلَـٰتِ","wal-mur'salāti","demi yang dikirim"],["عُرْفًۭا","ʿur'fan","kebaikan"]]},{"t":"dan (malaikat-malaikat) yang terbang dengan kencangnya,","w":[["فَٱلْعَـٰصِفَـٰتِ","fal-ʿāṣifāti","lalu yang bertiup"],["عَصْفًۭا","ʿaṣfan","keras/kencang"]]},{"t":"dan (malaikat-malaikat) yang menyebarkan (rahmat Allah) dengan seluas-luasnya,","w":[["وَٱلنَّـٰشِرَٰتِ","wal-nāshirāti","dan yang menyebarkan"],["نَشْرًۭا","nashran","sebaran seluas-luasnya"]]},{"t":"dan (malaikat-malaikat) yang membedakan (antara yang baik dan yang buruk) dengan sejelas-jelasnya,","w":[["فَٱلْفَـٰرِقَـٰتِ","fal-fāriqāti","lalu yang membedakan/memisahkan"],["فَرْقًۭا","farqan","sebeda-bedanya"]]},{"t":"dan (malaikat-malaikat) yang menyampaikan wahyu,","w":[["فَٱلْمُلْقِيَـٰتِ","fal-mul'qiyāti","lalu yang menyampaikan"],["ذِكْرًا","dhik'ran","peringatan/pengajaran"]]},{"t":"untuk menolak alasan-alasan atau memberi peringatan.","w":[["عُذْرًا","ʿudh'ran","alasan/pembelaan"],["أَوْ","aw","atau"],["نُذْرًا","nudh'ran","peringatan"]]},{"t":"Sungguh, apa yang dijanjikan kepadamu pasti terjadi.","w":[["إِنَّمَا","innamā","sesungguhnya hanyalah"],["تُوعَدُونَ","tūʿadūna","kamu dijanjikan"],["لَوَٰقِعٌۭ","lawāqiʿun","pasti terjadi"]]},{"t":"Maka apabila bintang-bintang dihapuskan,","w":[["فَإِذَا","fa-idhā","maka apabila"],["ٱلنُّجُومُ","l-nujūmu","bintang-bintang"],["طُمِسَتْ","ṭumisat","dihapuskan"]]},{"t":"dan apabila langit terbelah,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلسَّمَآءُ","l-samāu","langit"],["فُرِجَتْ","furijat","dibelah"]]},{"t":"dan apabila gunung-gunung dihancurkan menjadi debu,","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلْجِبَالُ","l-jibālu","gunung-gunung"],["نُسِفَتْ","nusifat","dihancurkan"]]},{"t":"dan apabila rasul-rasul telah ditetapkan waktunya.","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱلرُّسُلُ","l-rusulu","rasul-rasul"],["أُقِّتَتْ","uqqitat","ditetapkan waktunya"]]},{"t":"(Niscaya dikatakan kepada mereka), \"Sampai hari apakah ditangguhkan (azab orang-orang kafir itu)?\"","w":[["لِأَىِّ","li-ayyi","untuk manakah"],["يَوْمٍ","yawmin","hari"],["أُجِّلَتْ","ujjilat","ditentukan/ditangguhkan"]]},{"t":"Sampai hari keputusan.","w":[["لِيَوْمِ","liyawmi","untuk/sampai hari"],["ٱلْفَصْلِ","l-faṣli","keputusan"]]},{"t":"Dan tahukah kamu apakah hari keputusan itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","tahukah kamu"],["مَا","mā","apakah"],["يَوْمُ","yawmu","hari"],["ٱلْفَصْلِ","l-faṣli","keputusan"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Bukankah telah Kami binasakan orang-orang yang dahulu?","w":[["أَلَمْ","alam","tidaklah/bukanlah"],["نُهْلِكِ","nuh'liki","Kami telah membinasakan"],["ٱلْأَوَّلِينَ","l-awalīna","orang-orang yang dahulu"]]},{"t":"Lalu Kami susulkan (azab Kami terhadap) orang-orang yang datang kemudian.","w":[["ثُمَّ","thumma","kemudian"],["نُتْبِعُهُمُ","nut'biʿuhumu","Kami ikutkan/iringi mereka"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","orang-orang yang kemudian"]]},{"t":"Demikianlah Kami perlakukan orang-orang yang berdosa.","w":[["كَذَٰلِكَ","kadhālika","seperti demikianlah"],["نَفْعَلُ","nafʿalu","Kami berbuat"],["بِٱلْمُجْرِمِينَ","bil-muj'rimīna","terhadap orang-orang berdosa"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Bukankah Kami menciptakan kamu dari air yang hina (mani),","w":[["أَلَمْ","alam","tidaklah/bukankah"],["نَخْلُقكُّم","nakhluqkkum","Kami menciptakan"],["مِّن","min","dari"],["مَّآءٍۢ","māin","air"],["مَّهِينٍۢ","mahīnin","yang hina"]]},{"t":"kemudian Kami letakkan ia dalam tempat yang kokoh (rahim),","w":[["فَجَعَلْنَـٰهُ","fajaʿalnāhu","lalu Kami jadikannya"],["فِى","fī","dalam"],["قَرَارٍۢ","qarārin","tempat"],["مَّكِينٍ","makīnin","kokoh"]]},{"t":"sampai waktu yang ditentukan,","w":[["إِلَىٰ","ilā","kepada/sampai"],["قَدَرٍۢ","qadarin","ketentuan/waktu"],["مَّعْلُومٍۢ","maʿlūmin","ditentukan"]]},{"t":"lalu Kami tentukan (bentuknya), maka (Kamilah) sebaik-baik yang menentukan.","w":[["فَقَدَرْنَا","faqadarnā","lalu Kami tentukan"],["فَنِعْمَ","faniʿ'ma","maka sebaik-baik"],["ٱلْقَـٰدِرُونَ","l-qādirūna","yang menentukan"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Bukankah Kami jadikan bumi untuk (tempat) berkumpul,","w":[["أَلَمْ","alam","tidakkah/bukankah"],["نَجْعَلِ","najʿali","Kami menjadikan"],["ٱلْأَرْضَ","l-arḍa","bumi"],["كِفَاتًا","kifātan","tempat berkumpul"]]},{"t":"bagi yang masih hidup dan yang sudah mati?","w":[["أَحْيَآءًۭ","aḥyāan","orang-orang yang hidup"],["وَأَمْوَٰتًۭا","wa-amwātan","dan orang-orang yang mati"]]},{"t":"Dan Kami jadikan padanya gunung-gunung yang tinggi, dan Kami beri minum kamu dengan air tawar?","w":[["وَجَعَلْنَا","wajaʿalnā","dan Kami jadikan"],["فِيهَا","fīhā","padanya"],["رَوَٰسِىَ","rawāsiya","gunung-gunung"],["شَـٰمِخَـٰتٍۢ","shāmikhātin","yang tinggi"],["وَأَسْقَيْنَـٰكُم","wa-asqaynākum","dan Kami beri minum kamu"],["مَّآءًۭ","māan","air"],["فُرَاتًۭا","furātan","tawar"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"(Akan dikatakan), \"Pergilah kamu guna mendapatkan apa (azab) yang dahulu kamu dustakan.","w":[["ٱنطَلِقُوٓا۟","inṭaliqū","pergilah kamu"],["إِلَىٰ","ilā","kepada"],["مَا","mā","apa"],["كُنتُم","kuntum","kalian adalah"],["بِهِۦ","bihi","dengannya/padanya"],["تُكَذِّبُونَ","tukadhibūna","kamu mendustakan"]]},{"t":"Pergilah kamu mendapatkan naungan (asap api neraka) yang mempunyai tiga cabang,","w":[["ٱنطَلِقُوٓا۟","inṭaliqū","pergilah kamu"],["إِلَىٰ","ilā","kepada"],["ظِلٍّۢ","ẓillin","naungan"],["ذِى","dhī","mempunyai"],["ثَلَـٰثِ","thalāthi","tiga"],["شُعَبٍۢ","shuʿabin","cabang"]]},{"t":"yang tidak melindungi dan tidak pula menolak nyala api neraka.\"","w":[["لَّا","lā","tidak"],["ظَلِيلٍۢ","ẓalīlin","menaungi"],["وَلَا","walā","dan tidak"],["يُغْنِى","yugh'nī","berguna/menolak"],["مِنَ","mina","dari"],["ٱللَّهَبِ","l-lahabi","nyala api neraka"]]},{"t":"Sungguh, (neraka) itu menyemburkan bunga api (sebesar dan setinggi) istana,","w":[["إِنَّهَا","innahā","sesungguhnya ia"],["تَرْمِى","tarmī","melemparkan"],["بِشَرَرٍۢ","bishararin","bunga api"],["كَٱلْقَصْرِ","kal-qaṣri","seperti istana/gedung tinggi"]]},{"t":"seakan-akan iring-iringan unta yang kuning.","w":[["كَأَنَّهُۥ","ka-annahu","seolah-olah ia"],["جِمَـٰلَتٌۭ","jimālatun","unta-unta"],["صُفْرٌۭ","ṣuf'run","kuning"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Inilah hari, saat mereka tidak dapat berbicara,","w":[["هَـٰذَا","hādhā","ini"],["يَوْمُ","yawmu","hari"],["لَا","lā","tidak"],["يَنطِقُونَ","yanṭiqūna","mereka dapat bicara"]]},{"t":"dan tidak diizinkan kepada mereka mengemukakan alasan agar mereka dimaafkan.","w":[["وَلَا","walā","dan tidak"],["يُؤْذَنُ","yu'dhanu","diizinkan"],["لَهُمْ","lahum","bagi mereka"],["فَيَعْتَذِرُونَ","fayaʿtadhirūna","maka/sehingga mereka minta uzur"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari ini"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Inilah hari keputusan; (pada hari ini) Kami kumpulkan kamu dan orang-orang yang terdahulu.","w":[["هَـٰذَا","hādhā","ini"],["يَوْمُ","yawmu","hari"],["ٱلْفَصْلِ ۖ","l-faṣli","keputusan"],["جَمَعْنَـٰكُمْ","jamaʿnākum","Kami mengumpulkan kamu"],["وَٱلْأَوَّلِينَ","wal-awalīna","dan orang-orang terdahulu"]]},{"t":"Maka jika kamu punya tipu daya, maka lakukanlah (tipu daya) itu terhadap-Ku.","w":[["فَإِن","fa-in","maka jika"],["كَانَ","kāna","adalah"],["لَكُمْ","lakum","bagi kalian"],["كَيْدٌۭ","kaydun","tipu daya"],["فَكِيدُونِ","fakīdūni","maka tipu dayalah Aku"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Sungguh, orang-orang yang bertakwa berada dalam naungan (pepohonan surga yang teduh) dan (di sekitar) mata air,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْمُتَّقِينَ","l-mutaqīna","orang-orang yang bertakwa"],["فِى","fī","dalam"],["ظِلَـٰلٍۢ","ẓilālin","naungan"],["وَعُيُونٍۢ","waʿuyūnin","dan mata air"]]},{"t":"dan buah-buahan yang mereka sukai.","w":[["وَفَوَٰكِهَ","wafawākiha","dan buah-buahan"],["مِمَّا","mimmā","dari apa"],["يَشْتَهُونَ","yashtahūna","mereka inginkan"]]},{"t":"(Katakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\"","w":[["كُلُوا۟","kulū","makanlah"],["وَٱشْرَبُوا۟","wa-ish'rabū","dan minumlah kamu"],["هَنِيٓـًٔۢا","hanīan","dengan senang/sepuas hati"],["بِمَا","bimā","dengan apa/karena apa"],["كُنتُمْ","kuntum","kalian adalah"],["تَعْمَلُونَ","taʿmalūna","kamu telah kerjakan"]]},{"t":"Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.","w":[["إِنَّا","innā","sesungguhnya Kami"],["كَذَٰلِكَ","kadhālika","seperti demikian"],["نَجْزِى","najzī","Kami memberi balasan"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","orang-orang yang berbuat baik"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"(Katakan kepada orang-orang kafir), \"Makan dan bersenang-senanglah kamu (di dunia) sebentar, sesungguhnya kamu orang-orang durhaka!\"","w":[["كُلُوا۟","kulū","makanlah"],["وَتَمَتَّعُوا۟","watamattaʿū","dan bersenang-senanglah kamu"],["قَلِيلًا","qalīlan","sedikit/sebentar"],["إِنَّكُم","innakum","sesungguhnya kalian"],["مُّجْرِمُونَ","muj'rimūna","orang-orang yang berdosa"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Dan apabila dikatakan kepada mereka, \"Rukuklah,\" mereka tidak mau rukuk.","w":[["وَإِذَا","wa-idhā","dan apabila"],["قِيلَ","qīla","dikatakan"],["لَهُمُ","lahumu","kepada mereka"],["ٱرْكَعُوا۟","ir'kaʿū","tunduklah"],["لَا","lā","tidak"],["يَرْكَعُونَ","yarkaʿūna","mereka tunduk"]]},{"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)!","w":[["وَيْلٌۭ","waylun","kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"Maka kepada ajaran manakah (selain Alquran) ini mereka akan beriman?","w":[["فَبِأَىِّ","fabi-ayyi","maka yang manakah"],["حَدِيثٍۭ","ḥadīthin","perkataan"],["بَعْدَهُۥ","baʿdahu","sesudahnya (Al Qur'an)"],["يُؤْمِنُونَ","yu'minūna","mereka akan beriman"]]}]}