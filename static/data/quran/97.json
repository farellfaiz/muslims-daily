{"n":97,"ayat":[{"t":"Sesungguhnya Kami telah menurunkannya (Alquran) pada malam qadar.","w":[["إِنَّآ","innā","sesungguhnya"],["أَنزَلْنَـٰهُ","anzalnāhu","Kami telah menurunkannya"],["فِى","fī","pada"],["لَيْلَةِ","laylati","malam"],["ٱلْقَدْرِ","l-qadri","kemuliaan"]]},{"t":"Dan tahukah kamu apakah malam kemuliaan itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["لَيْلَةُ","laylatu","malam"],["ٱلْقَدْرِ","l-qadri","kemuliaan"]]},{"t":"Malam kemuliaan itu lebih baik daripada seribu bulan.","w":[["لَيْلَةُ","laylatu","malam"],["ٱلْقَدْرِ","l-qadri","kemuliaan"],["خَيْرٌۭ","khayrun","lebih baik"],["مِّنْ","min","dari"],["أَلْفِ","alfi","seribu"],["شَهْرٍۢ","shahrin","bulan"]]},{"t":"Pada malam itu turun para malaikat dan Ruh (Jibril) dengan izin Tuhannya untuk mengatur semua urusan.","w":[["تَنَزَّلُ","tanazzalu","turun"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","para malaikat"],["وَٱلرُّوحُ","wal-rūḥu","dan Roh/Jibril"],["فِيهَا","fīhā","padanya/pada malam"],["بِإِذْنِ","bi-idh'ni","dengan izin"],["رَبِّهِم","rabbihim","Tuhannya"],["مِّن","min","dari"],["كُلِّ","kulli","segala"],["أَمْرٍۢ","amrin","urusan"]]},{"t":"Sejahteralah (malam itu) sampai terbit fajar.","w":[["سَلَـٰمٌ","salāmun","sejahtera"],["هِىَ","hiya","ia/malam itu"],["حَتَّىٰ","ḥattā","hingga"],["مَطْلَعِ","maṭlaʿi","terbit"],["ٱلْفَجْرِ","l-fajri","fajar"]]}]}