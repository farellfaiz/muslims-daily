{"n":83,"ayat":[{"t":"Celakalah bagi orang-orang yang curang (dalam menakar dan menimbang)!","w":[["وَيْلٌۭ","waylun","kecelakaan"],["لِّلْمُطَفِّفِينَ","lil'muṭaffifīna","bagi orang-orang yang curang"]]},{"t":"(yaitu) orang-orang yang apabila menerima takaran dari orang lain mereka minta dicukupkan,","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["إِذَا","idhā","apabila"],["ٱكْتَالُوا۟","ik'tālū","mereka menerima takaran"],["عَلَى","ʿalā","atas"],["ٱلنَّاسِ","l-nāsi","manusia (orang lain)"],["يَسْتَوْفُونَ","yastawfūna","mereka minta dipenuhi"]]},{"t":"dan apabila mereka menakar atau menimbang (untuk orang lain), mereka mengurangi.","w":[["وَإِذَا","wa-idhā","dan apabila"],["كَالُوهُمْ","kālūhum","mereka menakar"],["أَو","aw","atau"],["وَّزَنُوهُمْ","wazanūhum","mereka menimbang"],["يُخْسِرُونَ","yukh'sirūna","mengurangi"]]},{"t":"Tidakkah mereka itu mengira, bahwa sesungguhnya mereka akan dibangkitkan,","w":[["أَلَا","alā","tidakkah"],["يَظُنُّ","yaẓunnu","mereka menyangka"],["أُو۟لَـٰٓئِكَ","ulāika","mereka itu"],["أَنَّهُم","annahum","bahwa sesungguhnya mereka"],["مَّبْعُوثُونَ","mabʿūthūna","orang-orang yang dibangkitkan"]]},{"t":"pada suatu hari yang besar,","w":[["لِيَوْمٍ","liyawmin","pada hari"],["عَظِيمٍۢ","ʿaẓīmin","yang besar"]]},{"t":"(yaitu) pada hari (ketika) semua orang bangkit menghadap Tuhan seluruh alam.","w":[["يَوْمَ","yawma","hari"],["يَقُومُ","yaqūmu","wahai kaumku"],["ٱلنَّاسُ","l-nāsu","manusia"],["لِرَبِّ","lirabbi","kapada Tuhan/Pemelihara"],["ٱلْعَـٰلَمِينَ","l-ʿālamīna","semesta alam"]]},{"t":"Sekali-kali jangan begitu! Sesungguhnya catatan orang yang durhaka benar-benar tersimpan dalam Sijjīn.","w":[["كَلَّآ","kallā","sekali-kali jangan begitu"],["إِنَّ","inna","sesungguhnya"],["كِتَـٰبَ","kitāba","catatan"],["ٱلْفُجَّارِ","l-fujāri","orang-orang durhaka"],["لَفِى","lafī","dalam"],["سِجِّينٍۢ","sijjīnin","sijjin"]]},{"t":"Dan tahukah engkau apakah Sijjīn itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["سِجِّينٌۭ","sijjīnun","sijjin"]]},{"t":"(Yaitu) Kitab yang berisi catatan (amal).","w":[["كِتَـٰبٌۭ","kitābun","kitab/catatan"],["مَّرْقُومٌۭ","marqūmun","tertulis"]]},{"t":"Celakalah pada hari itu, bagi orang-orang yang mendustakan!","w":[["وَيْلٌۭ","waylun","dan kecelakaan"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","bagi orang-orang yang mendustakan"]]},{"t":"(yaitu) orang-orang yang mendustakannya (hari pembalasan).","w":[["ٱلَّذِينَ","alladhīna","orang-orang yang"],["يُكَذِّبُونَ","yukadhibūna","(mereka) mendustakan"],["بِيَوْمِ","biyawmi","dengan hari"],["ٱلدِّينِ","l-dīni","pembalasan"]]},{"t":"Dan tidak ada yang mendustakannya (hari pembalasan) kecuali setiap orang yang melampaui batas dan berdosa,","w":[["وَمَا","wamā","dan tidak"],["يُكَذِّبُ","yukadhibu","mendustakan"],["بِهِۦٓ","bihi","dengannya"],["إِلَّا","illā","kecuali"],["كُلُّ","kullu","setiap"],["مُعْتَدٍ","muʿ'tadin","orang yang melampui batas"],["أَثِيمٍ","athīmin","orang yang berbuat dosa"]]},{"t":"yang apabila dibacakan kepadanya ayat-ayat Kami, dia berkata, \"Itu adalah dongeng orang-orang dahulu.\"","w":[["إِذَا","idhā","apabila"],["تُتْلَىٰ","tut'lā","dibacakan"],["عَلَيْهِ","ʿalayhi","atasnya/kepadanya"],["ءَايَـٰتُنَا","āyātunā","ayat-ayat Kami"],["قَالَ","qāla","ia berkata"],["أَسَـٰطِيرُ","asāṭīru","dongen-dongen"],["ٱلْأَوَّلِينَ","l-awalīna","orang-orang dahulu"]]},{"t":"Sekali-kali tidak! Bahkan apa yang mereka kerjakan itu telah menutupi hati mereka.","w":[["كَلَّا ۖ","kallā","sekali-kali jangan/tidak"],["بَلْ ۜ","bal","bahkan"],["رَانَ","rāna","menutup"],["عَلَىٰ","ʿalā","atas"],["قُلُوبِهِم","qulūbihim","hati mereka"],["مَّا","mā","apa"],["كَانُوا۟","kānū","adalah mereka"],["يَكْسِبُونَ","yaksibūna","mereka usahakan"]]},{"t":"Sekali-kali tidak! Sesungguhnya mereka pada hari itu benar-benar terhalang dari (melihat) Tuhannya.","w":[["كَلَّآ","kallā","sekali-kali jangan/tidak"],["إِنَّهُمْ","innahum","sesungguhnya"],["عَن","ʿan","dari"],["رَّبِّهِمْ","rabbihim","Tuhan mereka"],["يَوْمَئِذٍۢ","yawma-idhin","pada hari itu"],["لَّمَحْجُوبُونَ","lamaḥjūbūna","benar-benar tertutup"]]},{"t":"Kemudian, sesungguhnya mereka benar-benar masuk neraka.","w":[["ثُمَّ","thumma","kemudian"],["إِنَّهُمْ","innahum","sesungguhnya mereka"],["لَصَالُوا۟","laṣālū","benar-benar mereka masuk"],["ٱلْجَحِيمِ","l-jaḥīmi","neraka"]]},{"t":"Kemudian, dikatakan (kepada mereka), \"Inilah (azab) yang dahulu kamu dustakan.\"","w":[["ثُمَّ","thumma","kemudian"],["يُقَالُ","yuqālu","dikatakan"],["هَـٰذَا","hādhā","ini"],["ٱلَّذِى","alladhī","yang (azab)"],["كُنتُم","kuntum","kalian adalah"],["بِهِۦ","bihi","dengannya/padanya"],["تُكَذِّبُونَ","tukadhibūna","kamu mendustakan"]]},{"t":"Sekali-kali tidak! Sesungguhnya catatan orang-orang yang berbakti benar-benar tersimpan dalam 'Illiyyīn.","w":[["كَلَّآ","kallā","sekali-kali jangan/tidak"],["إِنَّ","inna","sesungguhnya"],["كِتَـٰبَ","kitāba","kitab/catatan"],["ٱلْأَبْرَارِ","l-abrāri","orang-orang yang baik"],["لَفِى","lafī","benar-benar dalam"],["عِلِّيِّينَ","ʿilliyyīna","illiyyin"]]},{"t":"Dan tahukah engkau apakah 'Illiyyīn itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["عِلِّيُّونَ","ʿilliyyūna","illiyyin"]]},{"t":"(Yaitu) Kitab yang berisi catatan (amal),","w":[["كِتَـٰبٌۭ","kitābun","catatan/kitab"],["مَّرْقُومٌۭ","marqūmun","tertulis"]]},{"t":"yang disaksikan oleh (malaikat-malaikat) yang didekatkan (kepada Allah).","w":[["يَشْهَدُهُ","yashhaduhu","menyaksikannya"],["ٱلْمُقَرَّبُونَ","l-muqarabūna","(mailaikat) yang didekatkan"]]},{"t":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,","w":[["إِنَّ","inna","sesungguhnya"],["ٱلْأَبْرَارَ","l-abrāra","orang-orang yang baik"],["لَفِى","lafī","benar-benar dalam"],["نَعِيمٍ","naʿīmin","kenikmatan/kesenangan"]]},{"t":"mereka (duduk) di atas dipan-dipan melepas pandangan.","w":[["عَلَى","ʿalā","atas"],["ٱلْأَرَآئِكِ","l-arāiki","dipan"],["يَنظُرُونَ","yanẓurūna","mereka melihat/memandang"]]},{"t":"Kamu dapat mengetahui dari wajah mereka kesenangan hidup yang penuh kenikmatan.","w":[["تَعْرِفُ","taʿrifu","kamu mengenal/melihat"],["فِى","fī","dalam"],["وُجُوهِهِمْ","wujūhihim","wajah mereka"],["نَضْرَةَ","naḍrata","bersinar/bercahaya"],["ٱلنَّعِيمِ","l-naʿīmi","kesenangan/kenikmatan"]]},{"t":"Mereka diberi minum dari khamar murni (tidak memabukkan) yang (tempatnya) masih dilak (disegel),","w":[["يُسْقَوْنَ","yus'qawna","mereka diberi minuman"],["مِن","min","dari"],["رَّحِيقٍۢ","raḥīqin","minuman yang terpilih"],["مَّخْتُومٍ","makhtūmin","dicap/dilak"]]},{"t":"laknya dari kasturi. Dan untuk yang demikian itu hendaknya orang berlomba-lomba.","w":[["خِتَـٰمُهُۥ","khitāmuhu","capnya/laknya"],["مِسْكٌۭ ۚ","mis'kun","kasturi"],["وَفِى","wafī","dan untuk"],["ذَٰلِكَ","dhālika","itu adalah"],["فَلْيَتَنَافَسِ","falyatanāfasi","maka hendaklah berlomba-lomba"],["ٱلْمُتَنَـٰفِسُونَ","l-mutanāfisūna","orang-orang yang berlomba"]]},{"t":"Dan campurannya dari tasnīm,","w":[["وَمِزَاجُهُۥ","wamizājuhu","dan campurannya"],["مِن","min","dari"],["تَسْنِيمٍ","tasnīmin","tasnim"]]},{"t":"(yaitu) mata air yang diminum oleh mereka yang dekat (kepada Allah).","w":[["عَيْنًۭا","ʿaynan","mata air"],["يَشْرَبُ","yashrabu","meminum"],["بِهَا","bihā","dengannya/padanya"],["ٱلْمُقَرَّبُونَ","l-muqarabūna","orang-orang yang didekatkan"]]},{"t":"Sesungguhnya orang-orang yang berdosa, adalah mereka yang dahulu menertawakan orang-orang yang beriman.","w":[["إِنَّ","inna","sesungguhnya"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["أَجْرَمُوا۟","ajramū","(mereka) berdosa"],["كَانُوا۟","kānū","adalah mereka"],["مِنَ","mina","dari"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوا۟","āmanū","beriman"],["يَضْحَكُونَ","yaḍḥakūna","menertawakan"]]},{"t":"Dan apabila mereka (orang-orang yang beriman) melintas di hadapan mereka, mereka saling mengedip-ngedipkan matanya,","w":[["وَإِذَا","wa-idhā","dan apabila"],["مَرُّوا۟","marrū","(orang-orang beriman) lewat"],["بِهِمْ","bihim","pada mereka"],["يَتَغَامَزُونَ","yataghāmazūna","mereka saling mengedipkan mata"]]},{"t":"dan apabila kembali kepada kaumnya, mereka kembali dengan gembira ria.","w":[["وَإِذَا","wa-idhā","dan apabila"],["ٱنقَلَبُوٓا۟","inqalabū","(orang-orang berdosa) kembali"],["إِلَىٰٓ","ilā","kepada"],["أَهْلِهِمُ","ahlihimu","keluarganya/kaumnya"],["ٱنقَلَبُوا۟","inqalabū","mereka kembali"],["فَكِهِينَ","fakihīna","riang gembira"]]},{"t":"Dan apabila mereka melihat (orang-orang mukmin), mereka mengatakan, \"Sesungguhnya mereka benar-benar orang-orang sesat,\"","w":[["وَإِذَا","wa-idhā","dan apabila"],["رَأَوْهُمْ","ra-awhum","mereka melihat"],["قَالُوٓا۟","qālū","mereka berkata"],["إِنَّ","inna","sesungguhnya"],["هَـٰٓؤُلَآءِ","hāulāi","mereka itu (orang-orang beriman)"],["لَضَآلُّونَ","laḍāllūna","orang-orang sesat"]]},{"t":"padahal (orang-orang yang berdosa itu), mereka tidak diutus sebagai penjaga (orang-orang mukmin).","w":[["وَمَآ","wamā","dan tidak"],["أُرْسِلُوا۟","ur'silū","dikirim"],["عَلَيْهِمْ","ʿalayhim","atasnya"],["حَـٰفِظِينَ","ḥāfiẓīna","penjaga-penjaga"]]},{"t":"Maka pada hari ini, orang-orang yang beriman yang menertawakan orang-orang kafir,","w":[["فَٱلْيَوْمَ","fal-yawma","maka pada hari"],["ٱلَّذِينَ","alladhīna","orang-orang yang"],["ءَامَنُوا۟","āmanū","beriman"],["مِنَ","mina","dari"],["ٱلْكُفَّارِ","l-kufāri","orang-orang kafir"],["يَضْحَكُونَ","yaḍḥakūna","menertawakan mereka"]]},{"t":"mereka (duduk) di atas dipan-dipan melepas pandangan.","w":[["عَلَى","ʿalā","atas"],["ٱلْأَرَآئِكِ","l-arāiki","dipan"],["يَنظُرُونَ","yanẓurūna","mereka memandang/melihat"]]},{"t":"Apakah orang-orang kafir itu diberi balasan (hukuman) terhadap apa yang telah mereka perbuat?","w":[["هَلْ","hal","apakah"],["ثُوِّبَ","thuwwiba","diberi ganjaran/balasan"],["ٱلْكُفَّارُ","l-kufāru","orang-orang kafir"],["مَا","mā","apa"],["كَانُوا۟","kānū","adalah mereka"],["يَفْعَلُونَ","yafʿalūna","mereka kerjakan"]]}]}